{
  "name": "mm-security-platform-frontend-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "安全管控指挥系统前端脚手架（Vue3+Vite+TS+Element Plus+ECharts），对齐 S1 与 OpenSpec/Superpowers。",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css,json,md}\"",
    "stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "cesium": "1.119",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "wujie-vue3": "^1.0.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.2.10",
    "postcss-html": "^2.0.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.10",
    "vite-plugin-compression2": "^1.0.0",
    "vite-plugin-static-copy": "^1.0.6",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.10"
  }
}
