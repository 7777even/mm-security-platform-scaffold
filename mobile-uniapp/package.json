{
  "name": "mobile-uniapp",
  "version": "0.0.1",
  "private": true,
  "description": "移动端 Vue3 SPA → uni-app 重构（P0 PoC + P1 页面全量迁移）",
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts"
  },
  "dependencies": {
    "pinia": "^2.1.0",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-shared": "3.0.0-alpha-5020620260914001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020620260914001",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^15.11.7",
    "sass": "^1.77.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.3",
    "vue-tsc": "2.1.10"
  }
}
