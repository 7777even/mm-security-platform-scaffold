# 开发环境对接 B3 Mock 服务（mock/ 目录，默认端口 8787）
VITE_API_BASE=http://localhost:8787/api/v1
VITE_WS_BASE=ws://localhost:8787/ws

# 开发期前端自包含 mock 开关：后端（B3 :8787）未启动时设为 true，前端用内置 fixture 演示
VITE_USE_DEV_MOCK=true

# 开发态地图预览瓦片：公网 Carto 深色底图（你之前看到的真实底图）。
# loadBaseMap 会在加载前探测可达性：可达→真实底图；不可达（如本环境无外网）→自动回退离线网格底图，不刷屏。
# 生产由 .env.production 控制（未设置 → 走 /tiles 同源离线，符合 S1 §9.4）。
VITE_MAP_TILE_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png

# 降雨雷达可选全球源（RainViewer）：部分网络对其瓦片要求 API Key（返回"API key required"报错瓦片）。
# 默认走中央气象台免密雷达（nmc.cn，开箱即用）；如需全球动画视图，去 rainviewer.com 免费注册 key 后填这里。
# VITE_RAINVIEWER_KEY=

# 防重放签名旁路（详设 V1.5 §3.3）：开发联调 B3 Mock 不校验签名，挂起；
# 生产环境（.env.production）必须为 false，由网关强制校验 X-Timestamp/X-Nonce/X-Signature。
VITE_SECURITY_GATEWAY_BYPASS=true
