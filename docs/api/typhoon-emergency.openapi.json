{
  "openapi": "3.0.3",
  "info": {
    "title": "台风应急 TyphoonEmergency API",
    "version": "1.0.0",
    "x-base-path": "/api/v1",
    "x-contract": "B3",
    "description": "台风应急大屏（fm-typhoon）接口：台风应急事件聚合（监测对象/风险预警/气象序列/水位序列/现场视频/易涝点位/事件信息）与防汛排涝可调度力量清单。契约源：src/services/typhoonEmergency.ts。数据来自 V11 落地的 fac_typhoon_* 真实表；值班人员与知识库条目沿用 V8 的 sys_duty_member / sys_knowledge_item。"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "默认 baseURL（VITE_API_BASE 可覆盖，见 src/services/http.ts）"
    }
  ],
  "security": [{ "bearerAuth": [], "replaySign": [] }],
  "tags": [{ "name": "typhoon", "description": "台风应急" }],
  "paths": {
    "/typhoon/incident": {
      "get": {
        "tags": ["typhoon"],
        "operationId": "getTyphoonIncident",
        "summary": "台风应急事件聚合",
        "description": "返回台风应急事件完整聚合：基础信息、监测对象、气象概要、风险预警、降雨/风速/水位时间序列、现场视频、知识库条目、值班人员、易涝点位、事件信息字段。eventId 省略或不存在时返回默认防台防汛事件。",
        "parameters": [
          {
            "name": "eventId",
            "in": "query",
            "required": false,
            "description": "应急事件 id；省略时返回默认事件",
            "schema": { "type": "integer" }
          },
          { "$ref": "./_shared.json#/components/parameters/lang" }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=台风应急事件聚合）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/TyphoonEmergencyIncident" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "eventId": 100,
                    "title": "台风沙迦防台防汛工作",
                    "location": "全厂范围",
                    "longitude": 110.92,
                    "latitude": 21.67,
                    "startedAt": "2026-06-25T08:12:00",
                    "status": "processing",
                    "typhoonApiCode": "202518",
                    "meteorologySummary": "受台风外围云系影响，厂区将出现中到大雨，局部暴雨，伴有6-8级阵风。",
                    "waterLevelWarn": 0.6,
                    "waterLevelDanger": 0.8,
                    "weatherChartLabels": ["02", "04", "06"],
                    "precipitationSeries": [2, 4, 8],
                    "windSpeedSeries": [1.2, 1.8, 2.1],
                    "waterLevelLabels": ["06:00", "08:00"],
                    "waterLevelSeries": [0.42, 0.48],
                    "monitoringObjects": [
                      {
                        "id": "outlet",
                        "name": "总排口",
                        "value": "0.8",
                        "unit": "m",
                        "status": "normal",
                        "statusText": "水位正常"
                      }
                    ],
                    "riskWarnings": [
                      {
                        "id": "1",
                        "time": "08:05",
                        "type": "内涝预警",
                        "content": "西化学水泵房水位持续上升，建议启动一车一泵应急抽排"
                      }
                    ],
                    "liveVideos": [
                      {
                        "id": "r1-east",
                        "label": "高端碳装置雨水池—东侧全景",
                        "sceneIndex": 0,
                        "angle": "东侧全景",
                        "status": "online",
                        "deviceCode": "FX-R1-01"
                      }
                    ],
                    "auxiliaryItems": [
                      {
                        "id": 1,
                        "line1": "应急预案",
                        "line2": "",
                        "count": 15,
                        "countTone": "cyan",
                        "iconIndex": 0
                      }
                    ],
                    "dutyPersons": [
                      {
                        "id": 1,
                        "name": "杨恒朋",
                        "role": "值班领导",
                        "phone": "13792536966",
                        "avatarIndex": 0
                      }
                    ],
                    "mapRiskPoints": [
                      {
                        "id": "r1",
                        "name": "高端碳装置雨水池、污水池",
                        "longitude": 110.87264,
                        "latitude": 21.6846,
                        "status": "warning",
                        "statusText": "重点巡查",
                        "responsibleUnit": "炼油/高端碳",
                        "predeployed": true,
                        "deployment": "龙吸水排涝车（炼油布置、高端碳操作）",
                        "videoIds": ["r1-east", "r1-outlet", "r1-road"]
                      }
                    ],
                    "eventInfoFields": [{ "label": "事件名称", "value": "台风沙迦防台防汛工作" }]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    },
    "/typhoon/dispatch-resources": {
      "get": {
        "tags": ["typhoon"],
        "operationId": "listTyphoonDispatchResources",
        "summary": "防汛排涝可调度力量清单",
        "description": "返回防汛排涝可调度资源清单（队伍/车辆/装备），含所属单位、区域、可调度状态、距离、预计到达时间、能力描述、联系人与坐标，用于台风应急页左侧力量调度面板。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=可调度力量清单）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/TyphoonDispatchResource" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "flood-team-01",
                      "type": "救援队伍",
                      "name": "炼油防汛抢险一组",
                      "code": "TEAM-FX-01",
                      "organization": "炼油分部应急中心",
                      "area": "炼油区",
                      "status": "可调度",
                      "distanceKm": 0.7,
                      "etaMinutes": 4,
                      "capacity": "12人 · 排涝与警戒",
                      "contact": "高策",
                      "phone": "18300556146",
                      "longitude": 110.8769,
                      "latitude": 21.6804
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TyphoonMonitorObject": {
        "type": "object",
        "description": "台风监测对象实时值（水位 / 泵站运行状态）",
        "properties": {
          "id": { "type": "string", "description": "监测对象编码（outlet/pool-a/pool-b/pump）" },
          "name": { "type": "string", "description": "监测对象名称" },
          "value": {
            "type": "string",
            "description": "当前监测值（字符串，保留原始精度与单位语义）"
          },
          "unit": { "type": "string", "description": "计量单位（m / 台运行）" },
          "status": {
            "type": "string",
            "description": "状态（normal 正常 / warning 预警 / critical 告警）"
          },
          "statusText": { "type": "string", "description": "状态中文描述" }
        }
      },
      "TyphoonRiskWarning": {
        "type": "object",
        "description": "风险预警条目",
        "properties": {
          "id": { "type": "string", "description": "预警 id" },
          "time": { "type": "string", "description": "预警发布时间（HH:mm）" },
          "type": { "type": "string", "description": "预警类型（内涝预警/大风预警/暴雨预警）" },
          "content": { "type": "string", "description": "预警内容" }
        }
      },
      "TyphoonLiveVideo": {
        "type": "object",
        "description": "现场监控视频点位",
        "properties": {
          "id": { "type": "string", "description": "视频点位 id" },
          "label": { "type": "string", "description": "点位名称" },
          "sceneIndex": { "type": "integer", "description": "关联场景序号，用于视频墙分屏" },
          "angle": { "type": "string", "description": "机位角度描述" },
          "status": { "type": "string", "description": "在线状态（online / offline）" },
          "deviceCode": { "type": "string", "description": "设备编码" }
        }
      },
      "TyphoonMapRiskPoint": {
        "type": "object",
        "description": "易涝风险点位（防洪排涝力量布置图）",
        "properties": {
          "id": { "type": "string", "description": "点位编码（r1…r8）" },
          "name": { "type": "string", "description": "点位名称" },
          "longitude": { "type": "number", "description": "经度（WGS84）" },
          "latitude": { "type": "number", "description": "纬度（WGS84）" },
          "status": {
            "type": "string",
            "description": "状态（normal 正常 / warning 预警 / critical 告警）"
          },
          "statusText": { "type": "string", "description": "状态中文描述" },
          "responsibleUnit": { "type": "string", "description": "责任单位" },
          "predeployed": { "type": "boolean", "description": "是否已前置部署力量" },
          "deployment": { "type": "string", "description": "部署方案描述" },
          "labelOffsetX": { "type": "integer", "description": "标签 X 像素偏移，可为空" },
          "labelOffsetY": { "type": "integer", "description": "标签 Y 像素偏移，可为空" },
          "clusterCount": { "type": "integer", "description": "聚合点位数量，可为空" },
          "kind": {
            "type": "string",
            "description": "点位类型（risk 风险点 / resource 力量点），可为空"
          },
          "videoIds": {
            "type": "array",
            "description": "关联视频点位 id 列表",
            "items": { "type": "string", "description": "视频点位 id" }
          }
        }
      },
      "TyphoonAuxItem": {
        "type": "object",
        "description": "辅助知识库条目（两行标题 + 计数）",
        "properties": {
          "id": { "type": "integer", "description": "条目 id" },
          "line1": { "type": "string", "description": "第一行标题" },
          "line2": { "type": "string", "description": "第二行标题，可为空串" },
          "count": { "type": "integer", "description": "条目数量" },
          "countTone": { "type": "string", "description": "计数色调（cyan / lime）" },
          "iconIndex": { "type": "integer", "description": "图标序号" }
        }
      },
      "TyphoonDutyPerson": {
        "type": "object",
        "description": "值班人员",
        "properties": {
          "id": { "type": "integer", "description": "人员 id" },
          "name": { "type": "string", "description": "姓名" },
          "role": { "type": "string", "description": "值班角色（值班领导 / 值班员）" },
          "phone": { "type": "string", "description": "联系电话" },
          "avatarIndex": { "type": "integer", "description": "头像序号" }
        }
      },
      "TyphoonEmergencyIncident": {
        "type": "object",
        "description": "台风应急事件聚合（大屏一次性消费的完整文档）",
        "properties": {
          "eventId": { "type": "integer", "description": "应急事件 id" },
          "title": { "type": "string", "description": "事件标题" },
          "location": { "type": "string", "description": "影响位置" },
          "longitude": { "type": "number", "description": "事件经度" },
          "latitude": { "type": "number", "description": "事件纬度" },
          "startedAt": { "type": "string", "description": "启动时间（ISO 本地时间，无时区）" },
          "endedAt": { "type": "string", "description": "结束时间，未结束时为空" },
          "status": { "type": "string", "description": "处置状态（processing / pending / done）" },
          "meteorologySummary": { "type": "string", "description": "气象概要描述" },
          "weatherChartLabels": {
            "type": "array",
            "description": "降雨 / 风速图表横轴标签（小时）",
            "items": { "type": "string" }
          },
          "precipitationSeries": {
            "type": "array",
            "description": "逐小时降雨量序列（mm）",
            "items": { "type": "number" }
          },
          "windSpeedSeries": {
            "type": "array",
            "description": "逐小时风速序列（m/s）",
            "items": { "type": "number" }
          },
          "waterLevelLabels": {
            "type": "array",
            "description": "水位图表横轴标签",
            "items": { "type": "string" }
          },
          "waterLevelSeries": {
            "type": "array",
            "description": "水位序列（m）",
            "items": { "type": "number" }
          },
          "waterLevelWarn": { "type": "number", "description": "水位预警线（m）" },
          "waterLevelDanger": { "type": "number", "description": "水位警戒线（m）" },
          "typhoonApiCode": { "type": "string", "description": "台风编号，如 202518" },
          "monitoringObjects": {
            "type": "array",
            "description": "监测对象（装置/罐区/码头等）及其实时状态",
            "items": { "$ref": "#/components/schemas/TyphoonMonitorObject" }
          },
          "riskWarnings": {
            "type": "array",
            "description": "气象与海况风险预警列表",
            "items": { "$ref": "#/components/schemas/TyphoonRiskWarning" }
          },
          "liveVideos": {
            "type": "array",
            "description": "实时视频监控流",
            "items": { "$ref": "#/components/schemas/TyphoonLiveVideo" }
          },
          "auxiliaryItems": {
            "type": "array",
            "description": "辅助决策项（应急预案/知识库/疏散图等）",
            "items": { "$ref": "#/components/schemas/TyphoonAuxItem" }
          },
          "dutyPersons": {
            "type": "array",
            "description": "值班与应急值守人员",
            "items": { "$ref": "#/components/schemas/TyphoonDutyPerson" }
          },
          "mapRiskPoints": {
            "type": "array",
            "description": "地图风险点位（含关联视频 id）",
            "items": { "$ref": "#/components/schemas/TyphoonMapRiskPoint" }
          },
          "eventInfoFields": {
            "type": "array",
            "description": "事件信息键值对（事件名称/分类/预警等级/影响范围/监测时段/启动时间/来源/当前措施）",
            "items": { "$ref": "#/components/schemas/TyphoonEventInfoField" }
          }
        }
      },
      "TyphoonEventInfoField": {
        "type": "object",
        "description": "事件信息字段",
        "properties": {
          "label": { "type": "string", "description": "字段名" },
          "value": { "type": "string", "description": "字段值" }
        }
      },
      "TyphoonDispatchResource": {
        "type": "object",
        "description": "防汛排涝可调度资源",
        "properties": {
          "id": { "type": "string", "description": "资源 id" },
          "type": { "type": "string", "description": "资源类型（救援队伍 / 救援车辆 / 救援装备）" },
          "name": { "type": "string", "description": "资源名称" },
          "code": { "type": "string", "description": "资源编码" },
          "organization": { "type": "string", "description": "所属单位" },
          "area": { "type": "string", "description": "驻防区域" },
          "status": { "type": "string", "description": "调度状态（可调度 / 已出动 / 不可调度）" },
          "distanceKm": { "type": "number", "description": "距事件点直线距离（km）" },
          "etaMinutes": { "type": "integer", "description": "预计到达时间（分钟）" },
          "capacity": { "type": "string", "description": "能力描述，如「12人 · 排涝与警戒」" },
          "contact": { "type": "string", "description": "联系人" },
          "phone": { "type": "string", "description": "联系电话" },
          "longitude": { "type": "number", "description": "资源经度" },
          "latitude": { "type": "number", "description": "资源纬度" }
        }
      }
    }
  }
}
