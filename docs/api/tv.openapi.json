            "items": { "$ref": "#/components/schemas/TvSnapshotItem" }
          }
        }
      },
      "TvSnapshotAckResult": {
        "type": "object",
        "description": "录像截图确认结果",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "截图记录 id",
            "example": 1
          },
          "reviewStatus": {
            "type": "string",
            "description": "审核状态：ACKED 已确认（PENDING→ACKED）",
            "example": "ACKED"
          }
        }
      }
    }
  }
