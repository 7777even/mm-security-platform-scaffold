{
  "openapi": "3.0.3",
  "info": {
    "title": "工业电视大屏接口（fm-tv）",
    "description": "取代前端硬编码的 tvMock 业务数据。覆盖工业电视大屏的视频概览卡片、运行统计、维保工单、事件分析，以及入厂巡检车辆/人员记录。地图撒点（tvVideoMapPoints）、地图标签、巡检圆与扫描点位为依赖设计舞台坐标的前端静态几何，不在此契约内。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/tv/overview": {
      "get": {
        "summary": "工业电视首屏聚合",
        "description": "一次返回工业电视大屏首屏所需的四类数据：视频概览卡片、运行统计（含事件总数）、维保工单统计、事件分析构成，避免首屏多端点拼接。",
        "tags": ["tv"],
        "responses": {
          "200": {
            "description": "工业电视首屏聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvOverview" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "overviewItems": [
                      { "id": 1, "label": "重大危险源", "value": 665, "iconIndex": 0 },
                      { "id": 2, "label": "生产设施", "value": 56, "iconIndex": 1 }
                    ],
                    "operationStats": {
                      "total": 1233,
                      "offline": 23,
                      "fault": 23,
                      "integrityRate": 98,
                      "onlineRate": 98,
                      "eventTotal": 110
                    },
                    "maintenanceOrders": [
                      { "label": "未接单", "value": 12, "tone": "grey" },
                      { "label": "处理中", "value": 25, "tone": "blue" },
                      { "label": "已超时", "value": 8, "tone": "red" }
                    ],
                    "eventBreakdown": [
                      { "label": "区域入侵", "value": 152, "color": "#f0b429" },
                      { "label": "人员闯入", "value": 150, "color": "#5b8cff" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tv/inspections": {
      "get": {
        "summary": "入厂巡检记录聚合",
        "description": "返回入厂巡检的车辆列表与人员列表（由同一张记录表按 record_kind 拆分）。车辆项 plate 有值、name/department 为空；人员项反之。",
        "tags": ["tv"],
        "responses": {
          "200": {
            "description": "入厂巡检聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvInspectionSummary" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "vehicles": [
                      {
                        "id": 1,
                        "kind": "VEHICLE",
                        "areaCode": "refinery",
                        "plate": "粤KAA543",
                        "name": null,
                        "badge": "入厂",
                        "department": null,
                        "gate": "3#门-入",
                        "time": "2026-03-17 10:22:23"
                      }
                    ],
                    "persons": [
                      {
                        "id": 9,
                        "kind": "PERSON",
                        "areaCode": "refinery",
                        "plate": null,
                        "name": "陈志强",
                        "badge": "员工",
                        "department": "炼油运行一部",
                        "gate": "3#门-入",
                        "time": "10:21:18"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tv/map-points": {
      "get": {
        "summary": "工业电视地图撒点",
        "description": "返回工业电视大屏地图上的视频点位（高空AR/重点部位/危险源/厂界四类）及其 WGS84 经纬度、挂高与在线状态。数据来自 V24 fac_tv_map_point 真实表，取代前端硬编码 tvVideoMapPoints。",
        "tags": ["tv"],
        "responses": {
          "200": {
            "description": "地图撒点列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TvMapPoint" }
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "ar-01",
                      "label": "高空AR-01",
                      "group": "high-ar",
                      "longitude": 110.881979,
                      "latitude": 21.685692,
                      "height": 74,
                      "online": true
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/tv/snapshots": {
      "get": {
        "summary": "录像截图分页列表",
        "description": "返回工业电视录像截图采集入库记录的分页列表（最新在前）。前端订阅 tv.snapshot.changed 实时刷新。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码（从 1 开始）",
            "schema": { "type": "integer", "default": 1 },
            "example": 1
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数",
            "schema": { "type": "integer", "default": 12 },
            "example": 12
          }
        ],
        "responses": {
          "200": {
            "description": "录像截图分页列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvSnapshotPage" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "total": 1,
                    "page": 1,
                    "size": 12,
                    "pages": 1,
                    "list": [
                      {
                        "id": 1,
                        "monitorCode": "ar-01",
                        "monitorName": "高空AR-01",
                        "captureTime": "2026-09-28 10:00:00",
                        "eventType": "烟火检测",
                        "reviewStatus": "PENDING",
                        "source": "DEVICE",
                        "createdAt": "2026-09-28 10:00:01",
                        "hasImage": true
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "录像截图采集入库",
        "description": "设备/采集端自助上报或后端采集器（TvCollector）主动拉取录像截图（base64 JPEG）→ 落库 fac_tv_snapshot（PENDING）→ 广播 tv.snapshot.changed。需权限码 video:snapshot:create（V80 已登记并授权 ADMIN 及岗位角色）。",
        "tags": ["tv"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TvSnapshotIngestRequest" },
              "example": {
                "monitorCode": "ar-01",
                "monitorName": "高空AR-01",
                "captureTime": "2026-09-28 10:00:00",
                "eventType": "烟火检测",
                "imageBase64": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDA...（省略 base64）",
                "source": "DEVICE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "采集入库结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvSnapshotIngestResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1,
                    "monitorCode": "ar-01",
                    "captureTime": "2026-09-28 10:00:00",
                    "reviewStatus": "PENDING",
                    "createdAt": "2026-09-28 10:00:01"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tv/snapshots/{id}/snapshot": {
      "get": {
        "summary": "录像截图字节",
        "description": "返回指定截图记录的 JPEG 字节（含抓拍图）。无截图数据时 404。前端用带 token 的 http 客户端取 blob 后转 objectURL 渲染（原生 <img src> 无法带 Authorization 头）。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "截图记录 id",
            "schema": { "type": "integer", "format": "int64" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "截图 JPEG 字节",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": {
            "description": "截图不存在或无字节（按设计返回 404）",
            "content": {
              "application/json": {
                "example": {
                  "code": 404,
                  "message": "截图不存在",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/tv/snapshots/{id}/ack": {
      "post": {
        "summary": "确认录像截图",
        "description": "将截图审核状态由 PENDING 推进为 ACKED。需权限码 video:snapshot:ack（V79 已登记并授权 ADMIN 及岗位角色）。成功后广播 tv.snapshot.changed。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "截图记录 id",
            "schema": { "type": "integer", "format": "int64" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "确认结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvSnapshotAckResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1,
                    "reviewStatus": "ACKED"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tv/monitors": {
      "get": {
        "summary": "视频监控点位摘要列表",
        "description": "返回全部工业电视监控点位摘要（含防区），供「设备/防区筛选」二级页设备维度下拉使用。数据来自 V24 fac_tv_monitor 真实表，防区由 V86 zone_code 关联 sys_zone 解析。",
        "tags": ["tv"],
        "responses": {
          "200": {
            "description": "监控点位摘要列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TvMonitorSummary" }
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "code": "ar-01",
                      "name": "高空AR-01",
                      "online": true,
                      "department": "安环部",
                      "zoneCode": "YIXI",
                      "zoneName": "乙烯区"
                    },
                    {
                      "code": "cs-03",
                      "name": "储罐区球机-03",
                      "online": true,
                      "department": "储运车间",
                      "zoneCode": "GUANQU",
                      "zoneName": "罐区"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新增监控点位",
        "description": "设备/防区管理：新增视频监控点位（含防区归属 zoneCode）。需权限码 tv:monitor:create（V87 已登记授权）。成功后广播 tv.monitor.changed。",
        "tags": ["tv"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TvMonitorUpsertRequest" },
              "example": {
                "monitorCode": "ar-09",
                "monitorName": "高空AR-09",
                "online": true,
                "integrity": "良好",
                "monitorType": "球机",
                "department": "安环部",
                "zoneCode": "YIXI",
                "location": "乙烯区东北角",
                "height": "24m",
                "angle": "56°"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增后的监控点位摘要",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvMonitorSummary" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "code": "ar-09",
                    "name": "高空AR-09",
                    "online": true,
                    "department": "安环部",
                    "zoneCode": "YIXI",
                    "zoneName": "乙烯区"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tv/monitors/{code}": {
      "get": {
        "summary": "视频监控点位档案",
        "description": "按点位编码返回视频监控档案（名称、在线状态、完好程度、类型、责任部门、坐标描述、挂高、角度）。数据来自 V24 fac_tv_monitor 真实表，取代前端硬编码 tvVideoMonitorDetails 与默认档案。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "监控点位编码（与地图撒点 point_code 一致，如 ar-01）",
            "schema": { "type": "string" },
            "example": "ar-01"
          }
        ],
        "responses": {
          "200": {
            "description": "视频监控点位档案",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvMonitorDetail" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "ar-01",
                    "name": "高空AR-01",
                    "online": true,
                    "integrity": "良好",
                    "monitorType": "球机",
                    "department": "安环部",
                    "location": "110.881979, 21.685692",
                    "height": "24m",
                    "angle": "56°"
                  }
                }
              }
            }
          },
          "404": {
            "description": "点位档案不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvMonitorDetail" },
                "example": {
                  "code": 404,
                  "message": "监控点位不存在",
                  "data": null
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "更新监控点位",
        "description": "设备/防区管理：更新监控点位（含防区归属 zoneCode 编辑）。仅覆盖非空字段。需权限码 tv:monitor:update（V87 已登记授权）。成功后广播 tv.monitor.changed。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "监控点位编码",
            "schema": { "type": "string" },
            "example": "ar-09"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TvMonitorUpsertRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新后的监控点位摘要",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvMonitorSummary" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "code": "ar-09",
                    "name": "高空AR-09",
                    "online": true,
                    "department": "安环部",
                    "zoneCode": "YIXI",
                    "zoneName": "乙烯区"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "删除监控点位",
        "description": "设备/防区管理：删除监控点位。需权限码 tv:monitor:delete（V87 已登记授权）。成功后广播 tv.monitor.changed。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "监控点位编码",
            "schema": { "type": "string" },
            "example": "ar-09"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "example": { "code": 0, "message": "ok", "data": null }
              }
            }
          }
        }
      }
    },
    "/tv/monitors/{code}/snapshots": {
      "get": {
        "summary": "设备级历史回放",
        "description": "按监控点位编码（monitorCode）返回其录像截图分页列表（最新在前），支持按采集时间区间 startTime~endTime 过滤。供「设备/防区筛选」二级页按设备维度回放历史抓拍。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "监控点位编码（与 /tv/monitors 返回的 code 一致，如 ar-01）",
            "schema": { "type": "string" },
            "example": "ar-01"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码（从 1 开始）",
            "schema": { "type": "integer", "default": 1 },
            "example": 1
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数",
            "schema": { "type": "integer", "default": 12 },
            "example": 12
          },
          {
            "name": "startTime",
            "in": "query",
            "required": false,
            "description": "采集时间区间起点（含），格式 yyyy-MM-dd HH:mm:ss",
            "schema": { "type": "string" },
            "example": "2026-09-01 00:00:00"
          },
          {
            "name": "endTime",
            "in": "query",
            "required": false,
            "description": "采集时间区间终点（含），格式 yyyy-MM-dd HH:mm:ss",
            "schema": { "type": "string" },
            "example": "2026-09-30 23:59:59"
          }
        ],
        "responses": {
          "200": {
            "description": "设备级录像截图分页列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvSnapshotPage" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "total": 1,
                    "page": 1,
                    "size": 12,
                    "pages": 1,
                    "list": [
                      {
                        "id": 1,
                        "monitorCode": "ar-01",
                        "monitorName": "高空AR-01",
                        "captureTime": "2026-09-28 10:00:00",
                        "eventType": "烟火检测",
                        "reviewStatus": "PENDING",
                        "source": "DEVICE",
                        "createdAt": "2026-09-28 10:00:01",
                        "hasImage": true,
                        "alarmId": null,
                        "alarmType": null,
                        "zoneCode": "YIXI"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TvMapPoint": {
        "type": "object",
        "description": "工业电视地图视频点位",
        "properties": {
          "id": { "type": "string", "description": "点位编码", "example": "ar-01" },
          "label": { "type": "string", "description": "点位名称", "example": "高空AR-01" },
          "group": {
            "type": "string",
            "description": "点位分组：high-ar 高空AR / focus 重点部位 / hazard 危险源 / boundary 厂界",
            "example": "high-ar"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "经度",
            "example": 110.881979
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "纬度",
            "example": 21.685692
          },
          "height": { "type": "integer", "description": "挂高（米）", "example": 74 },
          "online": { "type": "boolean", "description": "是否在线", "example": true }
        }
      },
      "TvMonitorDetail": {
        "type": "object",
        "description": "视频监控点位档案",
        "properties": {
          "id": { "type": "string", "description": "点位编码", "example": "ar-01" },
          "name": { "type": "string", "description": "监控名称", "example": "高空AR-01" },
          "online": { "type": "boolean", "description": "是否在线", "example": true },
          "integrity": {
            "type": "string",
            "description": "完好程度（良好 / 一般 / 损坏）",
            "example": "良好"
          },
          "monitorType": {
            "type": "string",
            "description": "监控类型（球机 / 枪机）",
            "example": "球机"
          },
          "department": { "type": "string", "description": "责任部门", "example": "安环部" },
          "location": {
            "type": "string",
            "description": "安装位置坐标描述",
            "example": "110.881979, 21.685692"
          },
          "height": { "type": "string", "description": "挂高", "example": "24m" },
          "angle": { "type": "string", "description": "安装角度", "example": "56°" },
          "zoneCode": {
            "type": ["string", "null"],
            "description": "防区编码（关联 sys_zone.zone_code，V86 建立防区维度；空表示未划分防区）",
            "example": "YIXI"
          },
          "zoneName": {
            "type": ["string", "null"],
            "description": "防区名称（由 zone_code 解析，如 乙烯区）",
            "example": "乙烯区"
          }
        }
      },
      "TvMonitorSummary": {
        "type": "object",
        "description": "工业电视监控点位摘要（设备下拉/筛选用）",
        "properties": {
          "code": { "type": "string", "description": "点位编码", "example": "ar-01" },
          "name": { "type": "string", "description": "监控名称", "example": "高空AR-01" },
