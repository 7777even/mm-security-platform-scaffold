{
  "openapi": "3.0.3",
  "info": {
    "title": "工业电视大屏接口（fm-tv）",
    "description": "取代前端硬编码的 tvMock 业务数据。覆盖工业电视大屏的视频概览卡片、运行统计、维保工单、事件分析，以及入厂巡检车辆/人员记录。地图撒点（tvVideoMapPoints）、地图标签、巡检圆与扫描点位为依赖设计舞台坐标的前端静态几何，不在此契约内。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/tv/overview": {
      "get": {
        "summary": "工业电视首屏聚合",
        "description": "一次返回工业电视大屏首屏所需的四类数据：视频概览卡片、运行统计（含事件总数）、维保工单统计、事件分析构成，避免首屏多端点拼接。",
        "tags": ["tv"],
        "responses": {
          "200": {
            "description": "工业电视首屏聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvOverview" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "overviewItems": [
                      { "id": 1, "label": "重大危险源", "value": 665, "iconIndex": 0 },
                      { "id": 2, "label": "生产设施", "value": 56, "iconIndex": 1 }
                    ],
                    "operationStats": {
                      "total": 1233,
                      "offline": 23,
                      "fault": 23,
                      "integrityRate": 98,
                      "onlineRate": 98,
                      "eventTotal": 110
                    },
                    "maintenanceOrders": [
                      { "label": "未接单", "value": 12, "tone": "grey" },
                      { "label": "处理中", "value": 25, "tone": "blue" },
                      { "label": "已超时", "value": 8, "tone": "red" }
                    ],
                    "eventBreakdown": [
                      { "label": "区域入侵", "value": 152, "color": "#f0b429" },
                      { "label": "人员闯入", "value": 150, "color": "#5b8cff" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tv/inspections": {
      "get": {
        "summary": "入厂巡检记录聚合",
        "description": "返回入厂巡检的车辆列表与人员列表（由同一张记录表按 record_kind 拆分）。车辆项 plate 有值、name/department 为空；人员项反之。",
        "tags": ["tv"],
        "responses": {
          "200": {
            "description": "入厂巡检聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvInspectionSummary" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "vehicles": [
                      {
                        "id": 1,
                        "kind": "VEHICLE",
                        "areaCode": "refinery",
                        "plate": "粤KAA543",
                        "name": null,
                        "badge": "入厂",
                        "department": null,
                        "gate": "3#门-入",
                        "time": "2026-03-17 10:22:23"
                      }
                    ],
                    "persons": [
                      {
                        "id": 9,
                        "kind": "PERSON",
                        "areaCode": "refinery",
                        "plate": null,
                        "name": "陈志强",
                        "badge": "员工",
                        "department": "炼油运行一部",
                        "gate": "3#门-入",
                        "time": "10:21:18"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tv/map-points": {
      "get": {
        "summary": "工业电视地图撒点",
        "description": "返回工业电视大屏地图上的视频点位（高空AR/重点部位/危险源/厂界四类）及其 WGS84 经纬度、挂高与在线状态。数据来自 V24 fac_tv_map_point 真实表，取代前端硬编码 tvVideoMapPoints。",
        "tags": ["tv"],
        "responses": {
          "200": {
            "description": "地图撒点列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TvMapPoint" }
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "ar-01",
                      "label": "高空AR-01",
                      "group": "high-ar",
                      "longitude": 110.881979,
                      "latitude": 21.685692,
                      "height": 74,
                      "online": true
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/tv/monitors/{code}": {
      "get": {
        "summary": "视频监控点位档案",
        "description": "按点位编码返回视频监控档案（名称、在线状态、完好程度、类型、责任部门、坐标描述、挂高、角度）。数据来自 V24 fac_tv_monitor 真实表，取代前端硬编码 tvVideoMonitorDetails 与默认档案。",
        "tags": ["tv"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "监控点位编码（与地图撒点 point_code 一致，如 ar-01）",
            "schema": { "type": "string" },
            "example": "ar-01"
          }
        ],
        "responses": {
          "200": {
            "description": "视频监控点位档案",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvMonitorDetail" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "ar-01",
                    "name": "高空AR-01",
                    "online": true,
                    "integrity": "良好",
                    "monitorType": "球机",
                    "department": "安环部",
                    "location": "110.881979, 21.685692",
                    "height": "24m",
                    "angle": "56°"
                  }
                }
              }
            }
          },
          "404": {
            "description": "点位档案不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TvMonitorDetail" },
                "example": {
                  "code": 404,
                  "message": "监控点位不存在",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TvMapPoint": {
        "type": "object",
        "description": "工业电视地图视频点位",
        "properties": {
          "id": { "type": "string", "description": "点位编码", "example": "ar-01" },
          "label": { "type": "string", "description": "点位名称", "example": "高空AR-01" },
          "group": {
            "type": "string",
            "description": "点位分组：high-ar 高空AR / focus 重点部位 / hazard 危险源 / boundary 厂界",
            "example": "high-ar"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "经度",
            "example": 110.881979
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "纬度",
            "example": 21.685692
          },
          "height": { "type": "integer", "description": "挂高（米）", "example": 74 },
          "online": { "type": "boolean", "description": "是否在线", "example": true }
        }
      },
      "TvMonitorDetail": {
        "type": "object",
        "description": "视频监控点位档案",
        "properties": {
          "id": { "type": "string", "description": "点位编码", "example": "ar-01" },
          "name": { "type": "string", "description": "监控名称", "example": "高空AR-01" },
          "online": { "type": "boolean", "description": "是否在线", "example": true },
          "integrity": {
            "type": "string",
            "description": "完好程度（良好 / 一般 / 损坏）",
            "example": "良好"
          },
          "monitorType": {
            "type": "string",
            "description": "监控类型（球机 / 枪机）",
            "example": "球机"
          },
          "department": { "type": "string", "description": "责任部门", "example": "安环部" },
          "location": {
            "type": "string",
            "description": "安装位置坐标描述",
            "example": "110.881979, 21.685692"
          },
          "height": { "type": "string", "description": "挂高", "example": "24m" },
          "angle": { "type": "string", "description": "安装角度", "example": "56°" }
        }
      },
      "TvOverviewItem": {
        "type": "object",
        "description": "视频概览卡片项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "卡片 id", "example": 1 },
          "label": { "type": "string", "description": "卡片名称", "example": "重大危险源" },
          "value": { "type": "integer", "description": "数量", "example": 665 },
          "iconIndex": { "type": "integer", "description": "图标索引", "example": 0 }
        }
      },
      "TvOperationStats": {
        "type": "object",
        "description": "运行统计（含事件总数）",
        "properties": {
          "total": { "type": "integer", "description": "监控总数", "example": 1233 },
          "offline": { "type": "integer", "description": "离线数", "example": 23 },
          "fault": { "type": "integer", "description": "故障数", "example": 23 },
          "integrityRate": { "type": "integer", "description": "完好率（%）", "example": 98 },
          "onlineRate": { "type": "integer", "description": "在线率（%）", "example": 98 },
          "eventTotal": { "type": "integer", "description": "事件总数", "example": 110 }
        }
      },
      "TvMaintenanceOrder": {
        "type": "object",
        "description": "维保工单统计项",
        "properties": {
          "label": { "type": "string", "description": "工单状态名", "example": "未接单" },
          "value": { "type": "integer", "description": "数量", "example": 12 },
          "tone": { "type": "string", "description": "着色基调：grey/blue/red", "example": "grey" }
        }
      },
      "TvEventBreakdownItem": {
        "type": "object",
        "description": "事件分析构成项",
        "properties": {
          "label": { "type": "string", "description": "事件类型名", "example": "区域入侵" },
          "value": { "type": "integer", "description": "数量", "example": 152 },
          "color": { "type": "string", "description": "前端渲染色值", "example": "#f0b429" }
        }
      },
      "TvOverview": {
        "type": "object",
        "description": "工业电视首屏聚合",
        "properties": {
          "overviewItems": {
            "type": "array",
            "description": "视频概览卡片",
            "items": { "$ref": "#/components/schemas/TvOverviewItem" }
          },
          "operationStats": { "$ref": "#/components/schemas/TvOperationStats" },
          "maintenanceOrders": {
            "type": "array",
            "description": "维保工单统计",
            "items": { "$ref": "#/components/schemas/TvMaintenanceOrder" }
          },
          "eventBreakdown": {
            "type": "array",
            "description": "事件分析构成",
            "items": { "$ref": "#/components/schemas/TvEventBreakdownItem" }
          }
        }
      },
      "TvInspectionItem": {
        "type": "object",
        "description": "入厂巡检记录项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "记录 id", "example": 1 },
          "kind": {
            "type": "string",
            "description": "记录类型：VEHICLE 车辆 / PERSON 人员",
            "example": "VEHICLE"
          },
          "areaCode": {
            "type": "string",
            "description": "所属区域编码（refinery/chemical/port）",
            "example": "refinery"
          },
          "plate": {
            "type": ["string", "null"],
            "description": "车牌号（仅车辆）",
            "example": "粤KAA543"
          },
          "name": { "type": ["string", "null"], "description": "姓名（仅人员）", "example": null },
          "badge": {
            "type": "string",
            "description": "标识（入厂/出厂 或 员工/承包商/访客）",
            "example": "入厂"
          },
          "department": {
            "type": ["string", "null"],
            "description": "所属部门（仅人员）",
            "example": null
          },
          "gate": { "type": "string", "description": "通行闸口", "example": "3#门-入" },
          "time": { "type": "string", "description": "通行时间", "example": "2026-03-17 10:22:23" }
        }
      },
      "TvInspectionSummary": {
        "type": "object",
        "description": "入厂巡检聚合",
        "properties": {
          "vehicles": {
            "type": "array",
            "description": "车辆记录列表",
            "items": { "$ref": "#/components/schemas/TvInspectionItem" }
          },
          "persons": {
            "type": "array",
            "description": "人员记录列表",
            "items": { "$ref": "#/components/schemas/TvInspectionItem" }
          }
        }
      }
    }
  }
}
