{
  "openapi": "3.0.3",
  "info": {
    "title": "消防监控 FireMonitoring API",
    "version": "1.0.0",
    "x-base-path": "/api/v1",
    "x-contract": "B3",
    "description": "消防监控大屏（fm-fire）专用统计与巡查接口：救援力量统计、特殊作业统计、消防设施设备状态、防火巡查记录。契约源：src/services/fireMonitoring.ts。数据来自 fac_rescue_force_stat / fac_special_operation_stat / fac_fire_equipment_status / fac_fire_patrol 真实表。"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "默认 baseURL（VITE_API_BASE 可覆盖，见 src/services/http.ts）"
    }
  ],
  "security": [{ "bearerAuth": [], "replaySign": [] }],
  "tags": [{ "name": "fire-monitoring", "description": "消防监控" }],
  "paths": {
    "/fire/rescue-forces": {
      "get": {
        "tags": ["fire-monitoring"],
        "operationId": "listRescueForces",
        "summary": "消防救援力量统计",
        "description": "返回消防可调度救援力量的分项统计（队伍/人员/装备/车辆），用于消防监控页值班信息面板的力量概览卡片。数据来自 fac_rescue_force_stat 真实表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=救援力量统计列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/RescueForceStat" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    { "label": "消防队伍", "value": 10, "unit": "支", "iconType": "squad" },
                    { "label": "救援人员", "value": 398, "unit": "人", "iconType": "person" },
                    { "label": "救援装备", "value": 123, "unit": "套", "iconType": "equipment" },
                    { "label": "救援车辆", "value": 83, "unit": "台", "iconType": "vehicle" }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    },
    "/fire/special-operations": {
      "get": {
        "tags": ["fire-monitoring"],
        "operationId": "listSpecialOperations",
        "summary": "特殊作业统计",
        "description": "返回八大特殊作业（动火/盲板抽堵/吊装/动土/受限空间/高处/临时用电/断路）的在建数量统计，用于消防监控页特殊作业面板的环形计数。数据来自 fac_special_operation_stat 真实表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=特殊作业统计列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/SpecialOperationStat" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    { "id": 1, "label": "动火作业", "count": 48 },
                    { "id": 2, "label": "盲板抽堵", "count": 3 }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    },
    "/fire/equipment-status": {
      "get": {
        "tags": ["fire-monitoring"],
        "operationId": "getFireEquipmentStatus",
        "summary": "消防设施设备状态",
        "description": "返回消防设施设备的总量、离线数、故障数与完好率/在线率（百分比整数），用于消防监控页设备监控面板的环形图与统计条。数据来自 fac_fire_equipment_status 单行状态表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=消防设施设备状态）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/FireEquipmentStatus" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "total": 1233,
                    "offline": 23,
                    "fault": 23,
                    "integrityRate": 98,
                    "onlineRate": 98
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    },
    "/fire/equipment": {
      "get": {
        "tags": ["fire-monitoring"],
        "operationId": "listFireEquipment",
        "summary": "消防设备分类清单",
        "description": "返回消防设备各分类（火灾自动报警系统/消防水源/室外消火栓系统等）及其数量，用于消防监控页「消防设备」面板的分类卡片网格。数据来自 V24 fac_fire_equipment_category 真实表，取代前端硬编码 fireEquipment。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=消防设备分类列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/FireEquipmentItem" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    { "id": 1, "name": "火灾自动报警系统", "count": 665 },
                    { "id": 2, "name": "消防水源", "count": 665 }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    },
    "/fire/patrols": {
      "get": {
        "tags": ["fire-monitoring"],
        "operationId": "listFirePatrols",
        "summary": "防火巡查记录",
        "description": "返回防火巡查记录（巡查区域、责任人、巡查日期、是否完成、检查项明细），用于消防监控页设备监控面板的巡查页签与统计。检查项 result 取值：正常 / 异常。数据来自 fac_fire_patrol 与 fac_fire_patrol_item 真实表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=防火巡查记录列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/FirePatrolRecord" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "patrolDate": "2026-08-20",
                      "shift": "上午",
                      "dutyPerson": "张三",
                      "patrolCount": "第1次",
                      "locations": ["1#联合装置", "中央控制室"],
                      "completed": true,
                      "workOrderNo": null,
                      "checkItems": [
                        {
                          "itemCode": "C1",
                          "category": "防火分隔设施",
                          "content": "常闭防火门是否处于正常关闭状态",
                          "result": "异常",
                          "abnormalDesc": "3F 常闭防火门被挡块撑开",
                          "photoFile": "patrol-photo-placeholder.png"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RescueForceStat": {
        "type": "object",
        "description": "消防救援力量分项统计（前端 StatCard 直接消费）",
        "properties": {
          "label": {
            "type": "string",
            "description": "统计项名称（消防队伍/救援人员/救援装备/救援车辆）"
          },
          "value": { "type": "integer", "description": "数量" },
          "unit": { "type": "string", "description": "计量单位（支/人/套/台）" },
          "iconType": {
            "type": "string",
            "description": "图标类型（squad 队伍 / person 人员 / vehicle 车辆 / equipment 装备），决定 StatCard 图标"
          }
        }
      },
      "SpecialOperationStat": {
        "type": "object",
        "description": "特殊作业分项统计（八大作业）",
        "properties": {
          "id": { "type": "integer", "description": "作业类型 id（主键）" },
          "label": {
            "type": "string",
            "description": "作业类型名称（动火作业/盲板抽堵/吊装作业/动土作业/受限空间/高处作业/临时用电/断路作业）"
          },
          "count": { "type": "integer", "description": "当前在建数量，0 时前端渲染为灰色零值态" }
        }
      },
      "FireEquipmentItem": {
        "type": "object",
        "description": "消防设备分类项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "分类 id", "example": 1 },
          "name": { "type": "string", "description": "设备分类名", "example": "火灾自动报警系统" },
          "count": { "type": "integer", "description": "该分类设备数量", "example": 665 }
        }
      },
      "FireEquipmentStatus": {
        "type": "object",
        "description": "消防设施设备整体状态（单行聚合）",
        "properties": {
          "total": { "type": "integer", "description": "设备总数" },
          "offline": { "type": "integer", "description": "离线设备数" },
          "fault": { "type": "integer", "description": "故障设备数" },
          "integrityRate": { "type": "integer", "description": "完好率百分比整数（0-100）" },
          "onlineRate": { "type": "integer", "description": "在线率百分比整数（0-100）" }
        }
      },
      "FirePatrolCheckItem": {
        "type": "object",
        "description": "防火巡查检查项（15 项标准检查表逐条结果）",
        "properties": {
          "itemCode": { "type": "string", "description": "检查项编号（A1/A2/B1…D6）" },
          "category": {
            "type": "string",
            "description": "检查项分类（用火用电安全管理/疏散通道/防火分隔设施/消防设施器材）"
          },
          "content": { "type": "string", "description": "检查内容描述" },
          "result": { "type": "string", "description": "检查结果（正常 / 异常 / 不适用）" },
          "abnormalDesc": {
            "type": "string",
            "description": "异常描述，仅 result=异常 时有值，可为空"
          },
          "photoFile": {
            "type": "string",
            "description": "异常现场照片文件名，仅 result=异常 时有值，可为空"
          }
        }
      },
      "FirePatrolRecord": {
        "type": "object",
        "description": "防火巡查记录（一次班次巡查）",
        "properties": {
          "id": { "type": "integer", "description": "记录 id（主键）" },
          "patrolDate": { "type": "string", "description": "巡查日期，格式 YYYY-MM-DD" },
          "shift": { "type": "string", "description": "班次（上午 / 下午 / 夜间）" },
          "dutyPerson": { "type": "string", "description": "巡查责任人姓名" },
          "patrolCount": { "type": "string", "description": "当班第几次巡查，如「第1次」" },
          "locations": {
            "type": "array",
            "description": "本次巡查覆盖的部位列表",
            "items": { "type": "string", "description": "部位名称" }
          },
          "completed": { "type": "boolean", "description": "是否已完成巡查" },
          "workOrderNo": {
            "type": "string",
            "description": "关联工单号，仅在巡查发现异常并派单后有值，可为空"
          },
          "checkItems": {
            "type": "array",
            "description": "15 项标准检查项逐条结果",
            "items": { "$ref": "#/components/schemas/FirePatrolCheckItem" }
          }
        }
      }
    }
  }
}
