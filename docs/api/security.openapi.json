{
  "openapi": "3.0.3",
  "info": {
    "title": "安全防恐 API",
    "version": "1.0.0",
    "x-base-path": "/api/v1",
    "x-contract": "B3",
    "description": "巡逻摄像机 / 道闸 / 防恐柱 / 车辆·人员识别检索 / 门禁事件接口（代码真实契约）。契约源：src/services/security.ts、src/services/map-data/securitySearchMock.ts、src/services/securityEventStore.ts。"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "默认 baseURL（VITE_API_BASE 可覆盖，见 src/services/http.ts）"
    }
  ],
  "security": [{ "bearerAuth": [], "replaySign": [] }],
  "tags": [{ "name": "security", "description": "安全防恐" }],
  "paths": {
    "/security/patrol-cameras": {
      "get": {
        "tags": ["security"],
        "operationId": "listPatrolCameras",
        "summary": "巡逻摄像机列表",
        "description": "返回全部巡逻摄像机点位（名称、防控区域、状态、经纬度），用于安全防恐一张图与列表。数据来自 fac_patrol_camera 真实表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=巡逻摄像机列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/PatrolCameraItem" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "name": "北环路1#",
                      "zone": "路网防控",
                      "status": "正常",
                      "longitude": 110.88165,
                      "latitude": 21.68112
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/security/gate-controls": {
      "get": {
        "tags": ["security"],
        "operationId": "listGateControls",
        "summary": "道闸（门禁卡口）列表",
        "description": "返回全部道闸点位（名称、所属门、状态、经纬度），用于门禁卡口分布与列表。数据来自 fac_gate_control 真实表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=道闸列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/GateControlItem" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "name": "1#门-道闸1",
                      "location": "1#门",
                      "status": "正常",
                      "longitude": 110.89175,
                      "latitude": 21.67778
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/security/bollards": {
      "get": {
        "tags": ["security"],
        "operationId": "listBollards",
        "summary": "防恐柱列表",
        "description": "返回全部防恐柱点位（名称、所属门/区、状态、经纬度），用于防恐柱分布与列表。数据来自 fac_bollard 真实表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=防恐柱列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/BollardItem" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "name": "1#门防恐柱",
                      "zone": "1#门",
                      "status": "正常",
                      "longitude": 110.89175,
                      "latitude": 21.67778
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/security/search/vehicle": {
      "get": {
        "tags": ["security"],
        "operationId": "searchVehicles",
        "summary": "车辆识别检索",
        "description": "按 keyword 模糊匹配车牌/卡口/状态返回车辆识别记录（服务端匹配，keyword 为空返回全量）。数据来自 fac_vehicle_search 真实表。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "检索关键字（车牌/卡口/状态，忽略大小写）"
          },
          { "$ref": "./_shared.json#/components/parameters/lang" }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=车辆识别结果列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/VehicleSearchResult" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "plate": "粤KA4543",
                      "confidence": 80,
                      "gate": "东门-入",
                      "status": "入厂",
                      "time": "2026-01-20 10:23:23"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/security/search/person": {
      "get": {
        "tags": ["security"],
        "operationId": "searchPersons",
        "summary": "人员识别检索",
        "description": "按 keyword 模糊匹配姓名/卡口/状态返回人员识别记录（服务端匹配，keyword 为空返回全量）。数据来自 fac_person_search 真实表。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "检索关键字（姓名/卡口/状态，忽略大小写）"
          },
          { "$ref": "./_shared.json#/components/parameters/lang" }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=人员识别结果列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/PersonSearchResult" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "name": "张三",
                      "gate": "东门-入",
                      "status": "入厂",
                      "date": "2026-01-20"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/security/events": {
      "get": {
        "tags": ["security"],
        "operationId": "listSecurityEvents",
        "summary": "门禁事件列表",
        "description": "返回全部安防门禁事件（人员、通道、卡号、车辆、进出方向、等级、时间），用于门禁事件记录查询。数据来自 fac_security_event 真实表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=门禁事件列表）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/SecurityEvent" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "eventId": "EVT-20260907-0001",
                      "person": "张伟",
                      "channel": "1#门-道闸1",
                      "cardId": "C1001",
                      "vehicle": "粤K·12345",
                      "direction": "进",
                      "level": 1,
                      "ts": "2026-09-07 08:02:11"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/security/track/timeline": {
      "get": {
        "tags": ["security"],
        "operationId": "getSecurityTrackTimeline",
        "summary": "巡更/通行轨迹时间轴",
        "description": "返回指定模式（vehicle/person）下某实体（车辆/人员）的通行轨迹节点；该实体无记录时回落到该模式的默认轨迹。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "description": "轨迹模式：vehicle=车辆，person=人员",
            "schema": { "type": "string", "enum": ["vehicle", "person"] }
          },
          {
            "name": "entityId",
            "in": "query",
            "required": false,
            "description": "实体 ID（车辆/人员主键）；缺省或该实体无轨迹时使用默认轨迹",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=SecurityTrackTimelineItem[]）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/SecurityTrackTimelineItem" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "location": "东门-入",
                      "status": "入厂",
                      "statusTone": "enter",
                      "time": "2026-01-20 09:12:08",
                      "captureHint": "东门卡口"
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/security/track/summary": {
      "get": {
        "tags": ["security"],
        "operationId": "getSecurityTrackSummary",
        "summary": "轨迹概要（起止点 + 时间范围）",
        "description": "返回该模式轨迹的起点/终点标签与时间范围；时间范围由时间轴首尾节点推导，无节点时为「—」。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "description": "轨迹模式：vehicle=车辆，person=人员",
            "schema": { "type": "string", "enum": ["vehicle", "person"] }
          },
          {
            "name": "entityId",
            "in": "query",
            "required": false,
            "description": "实体 ID（车辆/人员主键）",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=SecurityTrackSummary）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/SecurityTrackSummary" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "startLabel": "东门",
                    "endLabel": "装卸点",
                    "timeRange": "2026-01-20 09:12:08 - 2026-01-20 10:05:12"
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/security/search/vehicle/{id}": {
      "get": {
        "tags": ["security"],
        "operationId": "getVehicleSearchDetail",
        "summary": "车辆识别检索详情",
        "description": "返回单条车辆通行记录的详情（车牌/驾驶员/单位/预约/货物等）。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "车辆检索记录主键",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=VehicleSearchDetail）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/VehicleSearchDetail" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1,
                    "plate": "粤KA4543",
                    "vehicleType": "危化品运输车",
                    "driverName": "刘师傅",
                    "destination": "炼油一区装卸点"
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/security/search/person/{id}": {
      "get": {
        "tags": ["security"],
        "operationId": "getPersonSearchDetail",
        "summary": "人员识别检索详情",
        "description": "返回单条人员通行记录的详情（姓名/单位/证件/预约/特种作业等）。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "人员检索记录主键",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=PersonSearchDetail）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/PersonSearchDetail" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1,
                    "name": "张三",
                    "gender": "男",
                    "company": "茂名石化检修公司",
                    "specialOperation": "高处作业"
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/security/perimeter-alarms/latest": {
      "get": {
        "tags": ["security"],
        "operationId": "getLatestPerimeterAlarm",
        "summary": "最新周界入侵告警",
        "description": "返回告警时间最新的一条周界入侵告警详情（含位置/设备/处置状态/关联监控与现场抓拍路径），供安防态势面板展示待处置告警。数据来自 fac_perimeter_alarm 真实表；表为空时 data=null。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=PerimeterAlarmDetail，无告警时为 null）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/PerimeterAlarmDetail" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1,
                    "alarmCode": "AL-20260820-007",
                    "title": "周界入侵告警",
                    "status": "未确认",
                    "time": "2026-08-20 03:22:48",
                    "location": "厂区南门西侧 200 米",
                    "deviceId": "CAM-PERI-07",
                    "snapshotPath": "/api/v1/security/perimeter-alarms/1/snapshot"
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/security/perimeter-alarms/{id}": {
      "get": {
        "tags": ["security"],
        "operationId": "getPerimeterAlarm",
        "summary": "周界入侵告警详情",
        "description": "按主键返回单条周界入侵告警详情；未找到时 data=null。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "周界入侵告警主键",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=PerimeterAlarmDetail）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/PerimeterAlarmDetail" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 2,
                    "alarmCode": "AL-20260819-003",
                    "title": "周界入侵告警",
                    "status": "已处理",
                    "time": "2026-08-19 21:10:05",
                    "location": "厂区西门北侧 120 米",
                    "handleResult": "经核实为检修人员临时跨越通道，已现场纠正并封闭临时开口。"
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/security/perimeter-alarms/{id}/snapshot": {
      "get": {
        "tags": ["security"],
        "operationId": "getPerimeterAlarmSnapshot",
        "summary": "周界入侵告警现场抓拍",
        "description": "返回该告警 snapshot_bytes 列中的现场抓拍（JPEG）。当前为演示占位图，由 dev 启动时的 PerimeterAlarmSnapshotSeeder 生成；后续接真流时替换为媒体网关写入的实时抓拍。鉴权同 /security/*（需 JWT），前端用带 token 的 http 客户端取 blob 后转 objectURL 渲染。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "周界入侵告警 id（取自 /security/perimeter-alarms/latest）",
            "schema": { "type": "integer", "format": "int64", "example": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "现场抓拍字节（image/jpeg）",
            "content": {
              "image/jpeg": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": { "description": "该告警无现场抓拍（snapshot_bytes 为空）" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PatrolCameraItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "摄像机主键" },
          "name": { "type": "string", "description": "摄像机名称" },
          "zone": { "type": "string", "description": "防控区域（路网/门禁卡口/核心区/周界/外围）" },
          "status": { "type": "string", "description": "状态（正常/离线/故障）" },
          "longitude": { "type": "number", "description": "经度" },
          "latitude": { "type": "number", "description": "纬度" }
        }
      },
      "GateControlItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "道闸主键" },
          "name": { "type": "string", "description": "道闸名称" },
          "location": {
            "type": "string",
            "description": "所属门（1#门/2#门/东门/南门/西门/北门）"
          },
          "status": { "type": "string", "description": "状态（正常/离线/故障）" },
          "longitude": { "type": "number", "description": "经度" },
          "latitude": { "type": "number", "description": "纬度" }
        }
      },
      "BollardItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "防恐柱主键" },
          "name": { "type": "string", "description": "防恐柱名称" },
          "zone": { "type": "string", "description": "所属门/区" },
          "status": { "type": "string", "description": "状态（正常/离线/故障）" },
          "longitude": { "type": "number", "description": "经度" },
          "latitude": { "type": "number", "description": "纬度" }
        }
      },
