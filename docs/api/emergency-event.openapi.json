{
  "openapi": "3.0.3",
  "info": {
    "title": "消防应急 / 先期处置事件列表接口（fm-fire-emergency / fm-preliminary）",
    "description": "取代前端硬编码的 emergencyEventGroups / preliminaryMock / evacuationPeopleMock。覆盖消防应急大屏的事件分组（消防 / 先期处置切换）、事件项明细、以及疏散人员进度。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/emergency-events": {
      "get": {
        "summary": "应急事件分组列表",
        "description": "返回应急事件按域分组的列表。scene=FIRE 仅取消防事件（FIRE 在前），scene=PRELIMINARY 仅取先期处置事件；不传 scene 返回全部分组（FIRE 在前）。",
        "tags": ["emergency-event"],
        "operationId": "listEmergencyEvents",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "scene",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["FIRE", "PRELIMINARY"],
              "description": "事件场景筛选：FIRE 消防事件 / PRELIMINARY 先期处置；不传返回全部（FIRE 在前）",
              "example": "FIRE"
            },
            "description": "事件场景筛选：FIRE 消防 / PRELIMINARY 先期处置；缺省返回全部（FIRE 在前）"
          }
        ],
        "responses": {
          "200": {
            "description": "应急事件分组列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyEventGroups" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "fire",
                      "label": "消防事件",
                      "events": [
                        {
                          "id": 1,
                          "areaCode": "refinery",
                          "title": "催化裂化装置泄漏起火",
                          "location": "炼油一部 1#催化装置",
                          "description": "催化裂化装置法兰泄漏引发起火，已启动消防响应。",
                          "time": "2026-04-12 09:32:10",
                          "reported": true,
                          "status": "processing",
                          "statusLabel": "处置中",
                          "left": "42%",
                          "top": "31%",
                          "longitude": 110.123456,
                          "latitude": 21.654321,
                          "kind": "event",
                          "eventCategory": "default",
                          "hazardSourceLevel": "重大",
                          "endedAt": null,
                          "weatherMeta": {
                            "weatherType": "大风",
                            "warningLevel": "橙色",
                            "affectedArea": "厂区东部",
                            "monitoringPeriod": "2026-04-12 08:00 ~ 12:00",
                            "source": "气象站自动监测",
                            "measures": "加固高空设施，暂停吊装作业"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新增应急事件",
        "description": "创建一个新的应急事件（消防 / 先期处置）。后端同事务写入 fac_emergency_event 与 fac_accident_incident（is_default=false），使「去处置」可定位到该事件。返回后端生成的真实事件 id。",
        "tags": ["emergency-event"],
        "operationId": "createEmergencyEvent",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmergencyEventCreateRequest" },
              "example": {
                "scene": "FIRE",
                "kind": "event",
                "eventCategory": "default",
                "groupCode": "phone",
                "groupLabel": "消防电话报警",
                "title": "催化裂化装置新增泄漏",
                "location": "炼油一部 1#催化装置",
                "description": "现场人员上报，联系电话 138xxxx，暂无伤亡。",
                "eventTime": "2026-09-20 14:00:00",
                "areaCode": "refinery",
                "hazardSourceLevel": "重大",
                "leftPercent": "48.3%",
                "topPercent": "36.1%",
                "longitude": 110.123456,
                "latitude": 21.654321
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功，返回新增事件项",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyEventItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 18,
                    "areaCode": "refinery",
                    "title": "催化裂化装置新增泄漏",
                    "location": "炼油一部 1#催化装置",
                    "description": "现场人员上报，联系电话 138xxxx，暂无伤亡。",
                    "time": "2026-09-20 14:00:00",
                    "reported": false,
                    "status": "pending",
                    "statusLabel": "未处置",
                    "left": "48.3%",
                    "top": "36.1%",
                    "longitude": 110.123456,
                    "latitude": 21.654321,
                    "kind": "event",
                    "eventCategory": "default",
                    "hazardSourceLevel": "重大",
                    "endedAt": null
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-events/{id}/report": {
      "post": {
        "summary": "事件预警（报送）",
        "description": "标记应急事件已预警（reported=true），并同步关联事故救援事件（fac_accident_incident）的 reported 标志。仅置标志，不改动其他字段；事件不存在返回 404。返回更新后的事件项。",
        "tags": ["emergency-event"],
        "operationId": "reportEmergencyEvent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "应急事件 id",
              "example": 26
            }
          }
        ],
        "responses": {
          "200": {
            "description": "报送成功，返回更新后的事件项",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyEventItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 26,
                    "title": "东厂区突发应急事件",
                    "reported": true,
                    "status": "pending",
                    "statusLabel": "未处置"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-events/{id}/start-response": {
      "post": {
        "summary": "启动应急响应",
        "description": "将应急事件状态推进为「处置中」（fac_emergency_event.status=processing、status_label=处置中），并同步关联事故救援事件（fac_accident_incident 的 status_name=processing、map_status=处置中）。事件不存在返回 404。返回更新后的事件项。",
        "tags": ["emergency-event"],
        "operationId": "startEmergencyResponse",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "应急事件 id",
              "example": 26
            }
          }
        ],
        "responses": {
          "200": {
            "description": "启动成功，返回更新后的事件项",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyEventItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 26,
                    "title": "东厂区突发应急事件",
                    "reported": true,
                    "status": "processing",
                    "statusLabel": "处置中"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-events/evacuation-people": {
      "get": {
        "summary": "疏散人员进度列表",
        "description": "返回当前疏散人员及其撤离路线进度。count 控制返回条数上限（不传返回全部）。",
        "tags": ["emergency-event"],
        "operationId": "listEvacuationPeople",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "返回条数上限（不传返回全部）",
              "example": 10
            },
            "description": "返回条数上限（不传返回全部）"
          }
        ],
        "responses": {
          "200": {
            "description": "疏散人员进度列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EvacuationPeople" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "p-001",
                      "name": "王磊",
                      "org": "炼油运行一部",
                      "job": "外操",
                      "routeProgress": 68
                    },
                    {
                      "id": "p-002",
                      "name": "李娜",
                      "org": "储运车间",
                      "job": "巡检",
                      "routeProgress": 42
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmergencyEventGroups": {
        "type": "array",
        "description": "应急事件分组列表",
        "items": { "$ref": "#/components/schemas/EmergencyEventGroup" }
      },
      "EmergencyEventGroup": {
        "type": "object",
        "description": "应急事件分组（消防 / 先期处置）",
        "properties": {
          "id": {
            "type": "string",
            "description": "分组 id（如 fire / preliminary）",
            "example": "fire"
          },
          "label": { "type": "string", "description": "分组标签名", "example": "消防事件" },
          "events": {
            "type": "array",
            "description": "分组内事件项列表",
            "items": { "$ref": "#/components/schemas/EmergencyEventItem" }
          }
        }
      },
      "EmergencyEventItem": {
        "type": "object",
        "description": "应急事件项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "事件 id", "example": 1 },
          "areaCode": {
            "type": "string",
            "description": "所属区域编码（refinery/chemical/port）",
            "enum": ["refinery", "chemical", "port"],
            "example": "refinery"
          },
          "title": {
            "type": "string",
            "description": "事件标题",
            "example": "催化裂化装置泄漏起火"
          },
          "location": {
            "type": "string",
            "description": "事件位置",
            "example": "炼油一部 1#催化装置"
          },
          "description": {
            "type": "string",
            "description": "事件描述",
            "example": "催化裂化装置法兰泄漏引发起火"
          },
          "time": {
            "type": "string",
            "description": "事件发生时间",
            "example": "2026-04-12 09:32:10"
          },
          "reported": { "type": "boolean", "description": "是否已上报", "example": true },
          "status": {
            "type": "string",
            "description": "处置状态：processing 处置中 / pending 待处理 / done 已完成",
            "enum": ["processing", "pending", "done"],
            "example": "processing"
          },
          "statusLabel": { "type": "string", "description": "状态中文标签", "example": "处置中" },
          "left": { "type": "string", "description": "地图撒点左偏移（百分比）", "example": "42%" },
          "top": { "type": "string", "description": "地图撒点上偏移（百分比）", "example": "31%" },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "经度",
            "example": 110.123456
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "纬度",
            "example": 21.654321
          },
          "kind": {
            "type": "string",
            "description": "事件类型：event 真实事件 / drill 演练（可选）",
            "enum": ["event", "drill"],
            "example": "event"
          },
          "eventCategory": {
            "type": "string",
            "description": "事件分类：default 默认 / extremeWeather 极端天气（可选）",
            "enum": ["default", "extremeWeather"],
            "example": "default"
          },
          "hazardSourceLevel": {
            "type": "string",
            "description": "危险源等级（可选）",
            "example": "重大"
          },
          "endedAt": {
            "type": ["string", "null"],
            "description": "结束时间（可选，未完成为空）",
            "example": null
          },
          "weatherMeta": {
            "$ref": "#/components/schemas/EmergencyEventWeatherMeta",
            "description": "极端天气事件元数据（可选）"
          }
        }
      },
      "EmergencyEventWeatherMeta": {
        "type": "object",
        "description": "极端天气事件元数据",
        "properties": {
          "weatherType": { "type": "string", "description": "天气类型", "example": "大风" },
          "warningLevel": { "type": "string", "description": "预警等级", "example": "橙色" },
          "affectedArea": { "type": "string", "description": "影响区域", "example": "厂区东部" },
          "monitoringPeriod": {
            "type": "string",
            "description": "监测时段",
            "example": "2026-04-12 08:00 ~ 12:00"
          },
          "source": { "type": "string", "description": "数据来源", "example": "气象站自动监测" },
          "measures": {
            "type": "string",
            "description": "应对措置",
            "example": "加固高空设施，暂停吊装作业"
          }
        }
      },
      "EmergencyEventCreateRequest": {
        "type": "object",
        "description": "新增应急事件入参（对齐后端 dto.EmergencyEventCreateRequest）",
        "required": [
          "scene",
          "kind",
          "eventCategory",
          "title",
          "location",
          "description",
          "eventTime",
          "leftPercent",
          "topPercent",
          "longitude",
          "latitude"
        ],
        "properties": {
          "scene": {
            "type": "string",
            "enum": ["FIRE", "PRELIMINARY"],
            "description": "事件场景：FIRE 消防应急 / PRELIMINARY 先期处置",
            "example": "FIRE"
          },
          "kind": {
            "type": "string",
            "enum": ["event", "drill"],
            "description": "事件类型：event 真实事件 / drill 演练",
            "example": "event"
          },
          "eventCategory": {
            "type": "string",
            "enum": ["default", "extremeWeather"],
            "description": "事件分类：default 默认 / extremeWeather 极端天气",
            "example": "default"
          },
          "groupCode": {
            "type": "string",
            "description": "落库分组编码（可选，缺省按 kind/eventCategory 推导 manual-*）；与种子分组同码（phone/tank/facility/video/extreme-weather）时并入同一侧栏分组",
            "example": "phone"
          },
          "groupLabel": {
            "type": "string",
            "description": "落库分组标签（可选，缺省取 groupCode）；作为大屏侧栏分组标题",
            "example": "消防电话报警"
          },
          "title": {
            "type": "string",
            "description": "事件标题",
            "example": "催化裂化装置新增泄漏"
          },
          "location": {
            "type": "string",
            "description": "事件位置（装置/区域）",
            "example": "炼油一部 1#催化装置"
          },
          "description": {
            "type": "string",
            "description": "事件描述（含上报人/电话/伤亡数等无法单独映射的信息，由前端并入）",
            "example": "现场人员上报，联系电话 138xxxx，暂无伤亡。"
          },
          "eventTime": {
            "type": "string",
            "description": "事件发生时间，格式 yyyy-MM-dd HH:mm:ss",
            "example": "2026-09-20 14:00:00"
          },
          "areaCode": {
            "type": "string",
            "enum": ["refinery", "chemical", "port"],
            "description": "所属区域编码（可选，缺省 refinery）",
            "example": "refinery"
          },
          "hazardSourceLevel": {
            "type": "string",
            "description": "危险源等级（可选）",
            "example": "重大"
          },
          "leftPercent": {
            "type": "string",
            "description": "地图撒点左偏移（百分比，如 48.3%）",
            "example": "48.3%"
          },
          "topPercent": {
            "type": "string",
            "description": "地图撒点上偏移（百分比，如 36.1%）",
            "example": "36.1%"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "经度",
            "example": 110.123456
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "纬度",
            "example": 21.654321
          },
          "weatherType": {
            "type": "string",
            "description": "极端天气类型（eventCategory=extremeWeather 时填）",
            "example": "大风"
          },
          "warningLevel": {
            "type": "string",
            "description": "预警等级（极端天气时填）",
            "example": "橙色"
          },
          "affectedArea": {
            "type": "string",
            "description": "影响区域（极端天气时填）",
            "example": "厂区东部"
          },
          "monitoringPeriod": {
            "type": "string",
            "description": "监测时段（极端天气时填）",
            "example": "2026-09-20 08:00 ~ 12:00"
          },
          "weatherSource": {
            "type": "string",
            "description": "数据来源（极端天气时填）",
            "example": "气象站自动监测"
          },
          "measures": {
            "type": "string",
            "description": "应对措施（极端天气时填）",
            "example": "加固高空设施，暂停吊装作业"
          }
        }
      },
      "EvacuationPeople": {
        "type": "array",
        "description": "疏散人员进度列表",
        "items": { "$ref": "#/components/schemas/EvacuationPerson" }
      },
      "EvacuationPerson": {
        "type": "object",
        "description": "疏散人员进度项",
        "properties": {
          "id": { "type": "integer", "description": "人员 id", "example": 1 },
          "name": { "type": "string", "description": "姓名", "example": "王磊" },
          "org": { "type": "string", "description": "所属单位", "example": "炼油运行一部" },
          "job": { "type": "string", "description": "岗位", "example": "外操" },
          "routeProgress": {
            "type": "number",
            "format": "double",
            "description": "撤离路线进度（0-100）",
            "example": 68
          }
        }
      }
    }
  }
}
