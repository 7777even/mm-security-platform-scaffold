{
  "openapi": "3.0.3",
  "info": {
    "title": "视频控制/视频墙大屏接口（fm-video-control / fm-video-wall）",
    "description": "取代前端硬编码的 videoControlMock / videoLinkageMock。覆盖视频控制大屏的左侧导航（顶部分类 + 分组树）、摄像头分页网格，以及视频墙的视频联动配置与规则行。网格布局（1x1/2x2/3x3）与画面轮巡为前端交互状态，不在此契约内。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/video/navigation": {
      "get": {
        "summary": "视频导航聚合",
        "description": "一次返回视频控制大屏左侧导航所需的两类数据：顶部分类（扁平 8 项，含图标索引）与分组树（应急演练/应急事件/日常巡检/重点监控，叶子节点无 children 字段）。",
        "tags": ["video"],
        "responses": {
          "200": {
            "description": "视频导航聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoNavigation" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "categories": [
                      { "id": "refining", "label": "炼油区", "iconType": 0 },
                      { "id": "tank", "label": "原油罐区", "iconType": 1 }
                    ],
                    "tree": [
                      {
                        "id": "drill",
                        "label": "应急演练",
                        "children": [
                          { "id": "drill-1", "label": "演练1" },
                          { "id": "drill-2", "label": "演练2" }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/wall-navigation": {
      "get": {
        "summary": "视频墙导航聚合",
        "description": "返回视频墙左侧导航所需数据：监测目标树（分类→目标）、厂区视频目录（分区→摄像头通道）、通道→目标映射、默认高空AR相机。取代前端 videoWallStore 内代码生成的本地数据；摄像头通道编码 v-{i}-{j}（i=目标序号，j=通道序号）由服务端按目标行 cam_count 确定性派生。",
        "tags": ["video"],
        "responses": {
          "200": {
            "description": "视频墙导航聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoWallNavigation" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "targetTree": [
                      {
                        "id": "cat-1",
                        "label": "重大危险源",
                        "children": [
                          { "id": "t-1", "label": "危化储罐区装置#001" },
                          { "id": "t-2", "label": "危化储罐区装置#002" }
                        ]
                      }
                    ],
                    "videoTree": [
                      {
                        "id": "area-1",
                        "label": "一号生产厂区",
                        "children": [
                          { "id": "v-1-1", "label": "CAM-装置#001-通道1" },
                          { "id": "v-1-2", "label": "CAM-装置#001-通道2" }
                        ]
                      }
                    ],
                    "cameraTargetMap": {
                      "v-1-1": ["t-1"],
                      "v-1-2": ["t-1"]
                    },
                    "defaultHighAltitudeCameras": [
                      { "id": "high-ar-1", "label": "1#厂区高空AR·全景" },
                      { "id": "high-ar-2", "label": "炼油区高空AR·北向" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/important-groups": {
      "get": {
        "summary": "常驻视频监控分组",
        "description": "返回高空AR与重点关注区域两组视频监控分组（含通道）。取代前端 ImportantVideoPanel 硬编码的分组与通道；图像静态资源由前端按 image_key 映射，图资非业务数据。",
        "tags": ["video"],
        "responses": {
          "200": {
            "description": "常驻视频监控分组聚合",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImportantVideoGroups" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "highArGroups": [
                      {
                        "id": "park",
                        "label": "园区全景组",
                        "feeds": [
                          {
                            "id": "ar-park-1",
                            "label": "园区北向全景",
                            "imageKey": "highAr",
                            "position": "50% 30%",
                            "online": true
                          },
                          {
                            "id": "ar-park-2",
                            "label": "炼油区全景",
                            "imageKey": "highAr",
                            "position": "32% 50%",
                            "online": true
                          },
                          {
                            "id": "ar-park-3",
                            "label": "化工区全景",
                            "imageKey": "highAr",
                            "position": "68% 48%",
                            "online": true
                          },
                          {
                            "id": "ar-park-4",
                            "label": "港区全景",
                            "imageKey": "highAr",
                            "position": "50% 72%",
                            "online": true
                          }
                        ]
                      },
                      {
                        "id": "refinery",
                        "label": "炼油区高点组",
                        "feeds": [
                          {
                            "id": "ar-refinery-1",
                            "label": "一号高点西向",
                            "imageKey": "highAr",
                            "position": "50% 30%",
                            "online": true
                          }
                        ]
                      },
                      {
                        "id": "chemical",
                        "label": "化工区高点组",
                        "feeds": [
                          {
                            "id": "ar-chemical-1",
                            "label": "乙烯装置全景",
                            "imageKey": "highAr",
                            "position": "50% 30%",
                            "online": true
                          }
                        ]
                      }
                    ],
                    "focusGroups": [
                      {
                        "id": "tank",
                        "label": "储罐区组",
                        "feeds": [
                          {
                            "id": "tank-1",
                            "label": "储罐区B-3东侧",
                            "imageKey": "tanks",
                            "position": null,
                            "online": true
                          },
                          {
                            "id": "tank-3",
                            "label": "罐区管廊入口",
                            "imageKey": "pipes",
                            "position": null,
                            "online": true
                          }
                        ]
                      },
                      {
                        "id": "device",
                        "label": "装置区组",
                        "feeds": [
                          {
                            "id": "device-1",
                            "label": "催化裂化装置",
                            "imageKey": "reactor",
                            "position": null,
                            "online": true
                          }
                        ]
                      },
                      {
                        "id": "boundary",
                        "label": "厂界出入口组",
                        "feeds": [
                          {
                            "id": "boundary-4",
                            "label": "南侧物流门",
                            "imageKey": "highAr",
                            "position": "55% 82%",
                            "online": false
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/cameras": {
      "get": {
        "summary": "摄像头分页网格",
        "description": "按页返回摄像头画面项（前端默认每页 9 宫格）；pages 由 total/size 向上取整。status 取值 live（直播）/loading（加载中）/ai（AI 识别）。",
        "tags": ["video"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，从 1 开始，默认 1",
            "schema": { "type": "integer", "default": 1, "example": 1 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 9（九宫格）",
            "schema": { "type": "integer", "default": 9, "example": 9 }
          }
        ],
        "responses": {
          "200": {
            "description": "摄像头分页数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoCameraPage" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "total": 27,
                    "page": 1,
                    "size": 9,
                    "pages": 3,
                    "list": [
                      {
                        "id": 2,
                        "name": "炼油区-2",
                        "cameraType": "球机",
                        "location": "中海壳牌石油化工有限公司",
                        "status": "loading",
                        "hd": true,
                        "thumbIndex": 1
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/linkages": {
      "get": {
        "summary": "视频联动配置列表",
        "description": "返回视频墙联动配置全部条目（摄像头设备 + 联动对象概览），按 sort_no 升序。",
        "tags": ["video"],
        "responses": {
          "200": {
            "description": "联动配置列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoLinkageList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "lk-001",
                      "name": "XX强3-2棚伯",
                      "code": "HKJK-5124863",
                      "category": "枪机",
                      "linkageCount": 4,
                      "businessObjects": "石脑油罐区、催化裂化装置、催化氢解装置、储油罐区"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新建视频联动配置",
        "description": "新建一条视频联动配置及其规则行。configCode 由服务端按 lk-NNN 规则生成；linkageCount 与 businessObjects 由 rules 推导（不接受前端传入）。",
        "tags": ["video"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VideoLinkageSaveRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新建后的联动配置",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoLinkageItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "lk-006",
                    "name": "北2路33#枪机",
                    "code": "HKJK-5124999",
                    "category": "枪机",
                    "linkageCount": 1,
                    "businessObjects": "储油罐区"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/linkage-options": {
      "get": {
        "summary": "视频联动配置下拉选项",
        "description": "返回视频联动配置弹窗所需的四组下拉选项：监控器名称、预置点、业务对象分类、业务对象。相机名与相机类型由摄像头表派生，预置点与业务对象来自视频联动选项表。",
        "tags": ["video"],
        "responses": {
          "200": {
            "description": "视频联动配置下拉选项",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/VideoLinkageOptions" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "monitorNames": ["炼油区-1", "炼油区-2", "催化区-1"],
                    "presetPoints": ["预置点1", "预置点2", "预置点3"],
                    "businessObjectCategories": ["云台", "固定点机", "枪机", "球机"],
                    "businessObjects": ["石脑油罐区", "催化裂化装置", "储油罐区"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/linkages/{configCode}": {
      "put": {
        "summary": "更新视频联动配置",
        "description": "更新指定联动配置的名称/设备编码/类型，并整表替换其规则行；未命中 configCode 时 data 为 null。",
        "tags": ["video"],
        "parameters": [
          {
            "name": "configCode",
            "in": "path",
            "required": true,
            "description": "联动配置编码（取自 linkages[].id，如 lk-001）",
            "schema": { "type": "string", "example": "lk-001" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VideoLinkageSaveRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新后的联动配置；未命中时为 null",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoLinkageItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "lk-001",
                    "name": "XX强3-2棚伯",
                    "code": "HKJK-5124863",
                    "category": "枪机",
                    "linkageCount": 2,
                    "businessObjects": "石脑油罐区、催化裂化装置"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "删除视频联动配置",
        "description": "删除指定联动配置及其全部规则行；未命中 configCode 时 ok 为 false（不抛异常）。",
        "tags": ["video"],
        "parameters": [
          {
            "name": "configCode",
            "in": "path",
            "required": true,
            "description": "联动配置编码（取自 linkages[].id，如 lk-001）",
            "schema": { "type": "string", "example": "lk-001" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeleteResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": { "ok": true }
                }
              }
            }
          }
        }
      }
    },
    "/video/linkages/{configCode}/rules": {
      "get": {
        "summary": "联动配置规则行",
        "description": "返回指定联动配置的预置位-联动对象规则行；配置未预置规则时回退默认单行（炼化厂区门口）。",
        "tags": ["video"],
        "parameters": [
          {
            "name": "configCode",
            "in": "path",
            "required": true,
            "description": "联动配置编码（取自 linkages[].id，如 lk-001）",
            "schema": { "type": "string", "example": "lk-001" }
          }
        ],
        "responses": {
          "200": {
            "description": "联动规则行列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoLinkageRuleList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "r1",
                      "presetPoint": "石脑油罐区-东南角",
                      "objectCategory": "重大危险源",
                      "objectName": "石脑油罐区"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/video/cameras/{id}/snapshot": {
      "get": {
        "summary": "摄像头静态截图（演示）",
        "description": "返回该摄像头 snapshot_bytes 列中的静态图（JPEG）。当前为演示占位图，由 dev 启动时的 VideoSnapshotSeeder 生成；后续接真流时替换为媒体网关转发的流地址/截图。鉴权同 /video/*（需 JWT），前端用带 token 的 http 客户端取 blob 渲染。",
        "tags": ["video"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "摄像头 id（取自 /video/cameras 列表）",
            "schema": { "type": "integer", "format": "int64", "example": 2 }
          }
        ],
        "responses": {
          "200": {
            "description": "静态图字节（image/jpeg）",
            "content": {
              "image/jpeg": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": { "description": "该摄像头无截图（snapshot_bytes 为空）" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoCategoryItem": {
        "type": "object",
        "description": "顶部分类项",
        "properties": {
          "id": { "type": "string", "description": "分类编码", "example": "refining" },
          "label": { "type": "string", "description": "分类名称", "example": "炼油区" },
          "iconType": {
            "type": "integer",
            "description": "图标索引（前端图标库下标）",
            "example": 0
          }
        }
      },
      "VideoGroupNode": {
        "type": "object",
        "description": "分组树节点（叶子节点不输出 children）",
        "properties": {
          "id": { "type": "string", "description": "节点编码", "example": "drill" },
          "label": { "type": "string", "description": "节点名称", "example": "应急演练" },
          "children": {
            "type": "array",
            "description": "子节点列表",
            "items": { "$ref": "#/components/schemas/VideoGroupNode" }
          }
        }
      },
      "VideoNavigation": {
        "type": "object",
        "description": "视频导航聚合",
        "properties": {
          "categories": {
            "type": "array",
            "description": "顶部分类（扁平）",
            "items": { "$ref": "#/components/schemas/VideoCategoryItem" }
          },
          "tree": {
            "type": "array",
            "description": "分组树根节点列表",
            "items": { "$ref": "#/components/schemas/VideoGroupNode" }
          }
        }
      },
      "VideoWallGroupNode": {
        "type": "object",
        "description": "视频墙导航树节点（目标分类→目标 / 厂区分区→摄像头通道；叶子节点不输出 children）",
        "properties": {
          "id": { "type": "string", "description": "节点编码", "example": "cat-1" },
          "label": { "type": "string", "description": "节点名称", "example": "重大危险源" },
          "children": {
            "type": "array",
            "description": "子节点列表",
            "items": { "$ref": "#/components/schemas/VideoWallGroupNode" }
          }
        }
      },
      "VideoWallCamera": {
        "type": "object",
        "description": "视频墙默认高空AR相机项",
        "properties": {
          "id": { "type": "string", "description": "相机编码", "example": "high-ar-1" },
          "label": { "type": "string", "description": "相机名称", "example": "1#厂区高空AR·全景" }
        }
      },
      "VideoWallNavigation": {
        "type": "object",
        "description": "视频墙导航聚合（取代前端 videoWallStore 内代码生成的本地数据）",
        "properties": {
          "targetTree": {
            "type": "array",
            "description": "监测目标树（分类→目标）",
            "items": { "$ref": "#/components/schemas/VideoWallGroupNode" }
          },
          "videoTree": {
            "type": "array",
            "description": "厂区视频目录（分区→摄像头通道）",
            "items": { "$ref": "#/components/schemas/VideoWallGroupNode" }
          },
          "cameraTargetMap": {
            "type": "object",
            "description": "摄像头通道编码 → 绑定目标编码列表（键为 v-{i}-{j}）",
            "additionalProperties": {
              "type": "array",
              "description": "绑定的目标编码列表",
              "items": { "type": "string", "description": "目标编码", "example": "t-1" }
            },
            "example": { "v-1-1": ["t-1"] }
          },
          "defaultHighAltitudeCameras": {
            "type": "array",
            "description": "默认高空AR相机（视频墙默认 2x2 模式用）",
            "items": { "$ref": "#/components/schemas/VideoWallCamera" }
          }
        }
      },
      "ImportantVideoGroups": {
        "type": "object",
        "description": "常驻视频监控分组聚合（高空AR + 重点关注区域）。取代前端 ImportantVideoPanel 硬编码分组。",
        "properties": {
          "highArGroups": {
            "type": "array",
            "description": "高空AR 分组（园区全景/炼油区高点/化工区高点）",
            "items": { "$ref": "#/components/schemas/ImportantVideoGroup" }
          },
          "focusGroups": {
            "type": "array",
            "description": "重点关注区域分组（储罐区/装置区/厂界出入口）",
            "items": { "$ref": "#/components/schemas/ImportantVideoGroup" }
          }
        }
      },
      "ImportantVideoGroup": {
        "type": "object",
        "description": "常驻视频监控分组（高空AR / 重点关注区域）",
        "properties": {
          "id": { "type": "string", "description": "分组编码", "example": "park" },
          "label": { "type": "string", "description": "分组标签", "example": "园区全景组" },
          "feeds": {
            "type": "array",
            "description": "分组下通道列表",
            "items": { "$ref": "#/components/schemas/ImportantVideoFeed" }
          }
        }
      },
      "ImportantVideoFeed": {
        "type": "object",
        "description": "常驻视频监控通道。imageKey 指向前端静态图资（图资本身非业务数据）。",
        "properties": {
          "id": { "type": "string", "description": "通道编码", "example": "ar-park-1" },
          "label": { "type": "string", "description": "通道标签", "example": "园区北向全景" },
          "imageKey": {
            "type": "string",
            "description": "静态图资 key：highAr / tanks / reactor / pipes",
            "example": "highAr"
          },
          "position": {
            "type": "string",
            "description": "画面定位（CSS object-position），可空",
            "example": "50% 30%",
            "nullable": true
          },
          "online": { "type": "boolean", "description": "是否在线", "example": true }
        }
      },
      "VideoCameraItem": {
        "type": "object",
        "description": "摄像头画面项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "摄像头 id", "example": 2 },
          "name": { "type": "string", "description": "摄像头名称", "example": "炼油区-2" },
          "cameraType": {
            "type": "string",
            "description": "摄像机类型（固定点机/球机/枪机/云台）",
            "example": "球机"
          },
          "location": {
            "type": "string",
            "description": "安装位置",
            "example": "中海壳牌石油化工有限公司"
          },
          "status": {
            "type": "string",
            "description": "画面状态：live 直播 / loading 加载中 / ai AI 识别",
            "example": "loading"
          },
          "hd": { "type": "boolean", "description": "是否高清", "example": true },
          "thumbIndex": {
            "type": "integer",
            "description": "缩略图索引（前端静态图下标）",
            "example": 1
          }
        }
      },
      "VideoCameraPage": {
        "type": "object",
        "description": "摄像头分页",
        "properties": {
          "total": { "type": "integer", "description": "总条数", "example": 27 },
          "page": { "type": "integer", "description": "当前页码", "example": 1 },
          "size": { "type": "integer", "description": "每页条数", "example": 9 },
          "pages": { "type": "integer", "description": "总页数（向上取整）", "example": 3 },
          "list": {
            "type": "array",
            "description": "当前页摄像头列表",
            "items": { "$ref": "#/components/schemas/VideoCameraItem" }
          }
        }
      },
      "VideoLinkageItem": {
        "type": "object",
        "description": "视频联动配置项",
        "properties": {
          "id": { "type": "string", "description": "配置编码（lk-001...）", "example": "lk-001" },
          "name": { "type": "string", "description": "摄像头名称", "example": "XX强3-2棚伯" },
          "code": { "type": "string", "description": "设备编码", "example": "HKJK-5124863" },
          "category": {
            "type": "string",
            "description": "设备类型（枪机/球机/高空AR）",
            "example": "枪机"
          },
          "linkageCount": { "type": "integer", "description": "联动对象数量", "example": 4 },
          "businessObjects": {
            "type": "string",
            "description": "联动业务对象清单（顿号分隔）",
            "example": "石脑油罐区、催化裂化装置"
          }
        }
      },
      "VideoLinkageRuleRow": {
        "type": "object",
        "description": "联动规则行",
        "properties": {
          "id": { "type": "string", "description": "行内序号（r1/r2...）", "example": "r1" },
          "presetPoint": {
            "type": "string",
            "description": "预置位名称",
            "example": "石脑油罐区-东南角"
          },
          "objectCategory": {
            "type": "string",
            "description": "联动对象分类（重大危险源/生产装置/储罐/库区/摄像头）",
            "example": "重大危险源"
          },
          "objectName": { "type": "string", "description": "联动对象名称", "example": "石脑油罐区" }
        }
      },
      "VideoLinkageOptions": {
        "type": "object",
        "description": "视频联动配置弹窗的四组下拉选项",
        "properties": {
          "monitorNames": {
            "type": "array",
            "description": "监控器名称（派生自摄像头表 name）",
            "items": { "type": "string" },
            "example": ["炼油区-1", "炼油区-2"]
          },
          "presetPoints": {
            "type": "array",
            "description": "预置点选项（视频联动选项表 PRESET_POINT）",
            "items": { "type": "string" },
            "example": ["预置点1", "预置点2"]
          },
          "businessObjectCategories": {
            "type": "array",
            "description": "业务对象分类（派生自摄像头表 camera_type 去重）",
            "items": { "type": "string" },
            "example": ["云台", "球机"]
          },
          "businessObjects": {
            "type": "array",
            "description": "业务对象选项（视频联动选项表 BUSINESS_OBJECT）",
            "items": { "type": "string" },
            "example": ["石脑油罐区", "催化裂化装置"]
          }
        }
      },
      "VideoLinkageList": {
        "type": "array",
        "description": "联动配置列表",
        "items": { "$ref": "#/components/schemas/VideoLinkageItem" }
      },
      "VideoLinkageRuleList": {
        "type": "array",
        "description": "联动规则行列表",
        "items": { "$ref": "#/components/schemas/VideoLinkageRuleRow" }
      },
      "VideoLinkageRuleInput": {
        "type": "object",
        "description": "联动规则行入参",
        "properties": {
          "presetPoint": {
            "type": "string",
            "description": "预置位名称",
            "example": "石脑油罐区-东南角"
          },
          "objectCategory": {
            "type": "string",
            "description": "联动对象分类（重大危险源/生产装置/储罐/库区/摄像头）",
            "example": "重大危险源"
          },
          "objectName": { "type": "string", "description": "联动对象名称", "example": "石脑油罐区" }
        },
        "required": ["presetPoint", "objectCategory", "objectName"]
      },
      "VideoLinkageSaveRequest": {
        "type": "object",
        "description": "视频联动配置保存入参（新建/更新共用）。linkageCount 与 businessObjects 由服务端按 rules 推导。",
        "properties": {
          "name": { "type": "string", "description": "摄像头名称", "example": "XX强3-2棚伯" },
          "code": { "type": "string", "description": "设备编码", "example": "HKJK-5124863" },
          "category": {
            "type": "string",
            "description": "设备类型（枪机/球机/高空AR）",
            "example": "枪机"
          },
          "rules": {
            "type": "array",
            "description": "联动规则行；空数组表示无联动规则",
            "items": { "$ref": "#/components/schemas/VideoLinkageRuleInput" }
          }
        },
        "required": ["name", "code", "category"]
      },
      "DeleteResult": {
        "type": "object",
        "description": "删除结果",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "删除是否成功（命中行数 > 0 为 true）",
            "example": true
          }
        }
      }
    }
  }
}
