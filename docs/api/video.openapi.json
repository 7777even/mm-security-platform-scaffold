{
  "openapi": "3.0.3",
  "info": {
    "title": "视频控制/视频墙大屏接口（fm-video-control / fm-video-wall）",
    "description": "取代前端硬编码的 videoControlMock / videoLinkageMock。覆盖视频控制大屏的左侧导航（顶部分类 + 分组树）、摄像头分页网格，以及视频墙的视频联动配置与规则行。网格布局（1x1/2x2/3x3）与画面轮巡为前端交互状态，不在此契约内。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/video/navigation": {
      "get": {
        "summary": "视频导航聚合",
        "description": "一次返回视频控制大屏左侧导航所需的两类数据：顶部分类（扁平 8 项，含图标索引）与分组树（应急演练/应急事件/日常巡检/重点监控，叶子节点无 children 字段）。",
        "tags": ["video"],
        "responses": {
          "200": {
            "description": "视频导航聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoNavigation" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "categories": [
                      { "id": "refining", "label": "炼油区", "iconType": 0 },
                      { "id": "tank", "label": "原油罐区", "iconType": 1 }
                    ],
                    "tree": [
                      {
                        "id": "drill",
                        "label": "应急演练",
                        "children": [
                          { "id": "drill-1", "label": "演练1" },
                          { "id": "drill-2", "label": "演练2" }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/cameras": {
      "get": {
        "summary": "摄像头分页网格",
        "description": "按页返回摄像头画面项（前端默认每页 9 宫格）；pages 由 total/size 向上取整。status 取值 live（直播）/loading（加载中）/ai（AI 识别）。",
        "tags": ["video"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，从 1 开始，默认 1",
            "schema": { "type": "integer", "default": 1, "example": 1 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 9（九宫格）",
            "schema": { "type": "integer", "default": 9, "example": 9 }
          }
        ],
        "responses": {
          "200": {
            "description": "摄像头分页数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoCameraPage" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "total": 27,
                    "page": 1,
                    "size": 9,
                    "pages": 3,
                    "list": [
                      {
                        "id": 2,
                        "name": "炼油区-2",
                        "cameraType": "球机",
                        "location": "中海壳牌石油化工有限公司",
                        "status": "loading",
                        "hd": true,
                        "thumbIndex": 1
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/video/linkages": {
      "get": {
        "summary": "视频联动配置列表",
        "description": "返回视频墙联动配置全部条目（摄像头设备 + 联动对象概览），按 sort_no 升序。",
        "tags": ["video"],
        "responses": {
          "200": {
            "description": "联动配置列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoLinkageList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "lk-001",
                      "name": "XX强3-2棚伯",
                      "code": "HKJK-5124863",
                      "category": "枪机",
                      "linkageCount": 4,
                      "businessObjects": "石脑油罐区、催化裂化装置、催化氢解装置、储油罐区"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/video/linkages/{configCode}/rules": {
      "get": {
        "summary": "联动配置规则行",
        "description": "返回指定联动配置的预置位-联动对象规则行；配置未预置规则时回退默认单行（炼化厂区门口）。",
        "tags": ["video"],
        "parameters": [
          {
            "name": "configCode",
            "in": "path",
            "required": true,
            "description": "联动配置编码（取自 linkages[].id，如 lk-001）",
            "schema": { "type": "string", "example": "lk-001" }
          }
        ],
        "responses": {
          "200": {
            "description": "联动规则行列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoLinkageRuleList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "r1",
                      "presetPoint": "石脑油罐区-东南角",
                      "objectCategory": "重大危险源",
                      "objectName": "石脑油罐区"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoCategoryItem": {
        "type": "object",
        "description": "顶部分类项",
        "properties": {
          "id": { "type": "string", "description": "分类编码", "example": "refining" },
          "label": { "type": "string", "description": "分类名称", "example": "炼油区" },
          "iconType": {
            "type": "integer",
            "description": "图标索引（前端图标库下标）",
            "example": 0
          }
        }
      },
      "VideoGroupNode": {
        "type": "object",
        "description": "分组树节点（叶子节点不输出 children）",
        "properties": {
          "id": { "type": "string", "description": "节点编码", "example": "drill" },
          "label": { "type": "string", "description": "节点名称", "example": "应急演练" },
          "children": {
            "type": "array",
            "description": "子节点列表",
            "items": { "$ref": "#/components/schemas/VideoGroupNode" }
          }
        }
      },
      "VideoNavigation": {
        "type": "object",
        "description": "视频导航聚合",
        "properties": {
          "categories": {
            "type": "array",
            "description": "顶部分类（扁平）",
            "items": { "$ref": "#/components/schemas/VideoCategoryItem" }
          },
          "tree": {
            "type": "array",
            "description": "分组树根节点列表",
            "items": { "$ref": "#/components/schemas/VideoGroupNode" }
          }
        }
      },
      "VideoCameraItem": {
        "type": "object",
        "description": "摄像头画面项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "摄像头 id", "example": 2 },
          "name": { "type": "string", "description": "摄像头名称", "example": "炼油区-2" },
          "cameraType": {
            "type": "string",
            "description": "摄像机类型（固定点机/球机/枪机/云台）",
            "example": "球机"
          },
          "location": {
            "type": "string",
            "description": "安装位置",
            "example": "中海壳牌石油化工有限公司"
          },
          "status": {
            "type": "string",
            "description": "画面状态：live 直播 / loading 加载中 / ai AI 识别",
            "example": "loading"
          },
          "hd": { "type": "boolean", "description": "是否高清", "example": true },
          "thumbIndex": {
            "type": "integer",
            "description": "缩略图索引（前端静态图下标）",
            "example": 1
          }
        }
      },
      "VideoCameraPage": {
        "type": "object",
        "description": "摄像头分页",
        "properties": {
          "total": { "type": "integer", "description": "总条数", "example": 27 },
          "page": { "type": "integer", "description": "当前页码", "example": 1 },
          "size": { "type": "integer", "description": "每页条数", "example": 9 },
          "pages": { "type": "integer", "description": "总页数（向上取整）", "example": 3 },
          "list": {
            "type": "array",
            "description": "当前页摄像头列表",
            "items": { "$ref": "#/components/schemas/VideoCameraItem" }
          }
        }
      },
      "VideoLinkageItem": {
        "type": "object",
        "description": "视频联动配置项",
        "properties": {
          "id": { "type": "string", "description": "配置编码（lk-001...）", "example": "lk-001" },
          "name": { "type": "string", "description": "摄像头名称", "example": "XX强3-2棚伯" },
          "code": { "type": "string", "description": "设备编码", "example": "HKJK-5124863" },
          "category": {
            "type": "string",
            "description": "设备类型（枪机/球机/高空AR）",
            "example": "枪机"
          },
          "linkageCount": { "type": "integer", "description": "联动对象数量", "example": 4 },
          "businessObjects": {
            "type": "string",
            "description": "联动业务对象清单（顿号分隔）",
            "example": "石脑油罐区、催化裂化装置"
          }
        }
      },
      "VideoLinkageRuleRow": {
        "type": "object",
        "description": "联动规则行",
        "properties": {
          "id": { "type": "string", "description": "行内序号（r1/r2...）", "example": "r1" },
          "presetPoint": {
            "type": "string",
            "description": "预置位名称",
            "example": "石脑油罐区-东南角"
          },
          "objectCategory": {
            "type": "string",
            "description": "联动对象分类（重大危险源/生产装置/储罐/库区/摄像头）",
            "example": "重大危险源"
          },
          "objectName": { "type": "string", "description": "联动对象名称", "example": "石脑油罐区" }
        }
      },
      "VideoLinkageList": {
        "type": "array",
        "description": "联动配置列表",
        "items": { "$ref": "#/components/schemas/VideoLinkageItem" }
      },
      "VideoLinkageRuleList": {
        "type": "array",
        "description": "联动规则行列表",
        "items": { "$ref": "#/components/schemas/VideoLinkageRuleRow" }
      }
    }
  }
}
