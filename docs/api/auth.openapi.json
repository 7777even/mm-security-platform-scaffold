{
  "openapi": "3.0.3",
  "info": {
    "title": "鉴权与菜单 Auth API",
    "version": "1.0.0",
    "x-base-path": "/api/v1",
    "x-contract": "B3",
    "description": "菜单树接口（代码真实契约，由 stub 升级）。契约源：src/services/menu.ts、src/router/menu.ts。",
    "x-auth-note": "本后端（mm-security-backend）提供显式凭证登录：POST /auth/login 返回 access 令牌（access 存前端内存态 token.ts），refresh 令牌由后端经 Set-Cookie 以 HttpOnly(name=rt, SameSite=Lax) 下发，绝不进响应 body（防 XSS 窃取）；POST /auth/refresh 续期（refresh 令牌由浏览器 Cookie 自动携带，无请求体）；POST /auth/logout 清除 refresh Cookie；GET /auth/me 取当前用户。令牌缺失/失效或凭证错误时，后端返回【真实 HTTP 401/403】（GlobalExceptionHandler 将业务码 401/403 映射为对应 HTTP 状态码），不再以 HTTP 200 + 业务 code 表达；仅在成功时返回 HTTP 200 + code=0。"
  },
  "servers": [{ "url": "/api/v1", "description": "默认 baseURL（VITE_API_BASE 可覆盖）" }],
  "security": [{ "bearerAuth": [], "replaySign": [] }],
  "tags": [{ "name": "auth", "description": "鉴权与菜单" }],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "operationId": "login",
        "summary": "凭证登录",
        "description": "用户名/口令登录，返回 access + refresh 令牌。消除后端实现 /auth/login 的契约漂移。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "username": "admin", "password": "admin@2026" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "B3 成功包络（data=TokenResponse）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/TokenResponse" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "accessToken": "eyJ...",
                    "expiresIn": 7200,
                    "tokenType": "Bearer"
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "operationId": "refreshToken",
        "summary": "刷新访问令牌",
        "description": "续期 access 令牌。refresh 令牌由浏览器 HttpOnly Cookie（name=rt）自动携带，无需请求体；后端缺失/失效该 Cookie 时返回 401。返回新的 access 令牌，同时滚动下发新的 refresh Cookie。",
        "responses": {
          "200": {
            "description": "B3 成功包络（data=TokenResponse）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/TokenResponse" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "accessToken": "eyJ...",
                    "expiresIn": 7200,
                    "tokenType": "Bearer"
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"],
        "operationId": "logout",
        "summary": "登出",
        "description": "清除服务端下发的 HttpOnly refresh Cookie（rt，Max-Age=0）；前端同步清内存态 access 令牌。免鉴权。",
        "responses": {
          "200": {
            "description": "B3 成功包络",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "type": "null" } } }
                  ]
                },
                "example": { "code": 0, "message": "ok", "data": null }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["auth"],
        "operationId": "getCurrentUser",
        "summary": "当前登录用户",
        "description": "返回当前用户基本信息（username/realName/role）。",
        "responses": {
          "200": {
            "description": "B3 成功包络（data=CurrentUser）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/CurrentUser" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": { "username": "admin", "realName": "系统管理员", "role": "ADMIN" }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    },
    "/auth/menus": {
      "get": {
        "tags": ["auth"],
        "operationId": "getMenus",
        "summary": "按角色返回菜单树",
        "description": "仅返回顶部导航栏菜单（5 个 fm-* 主模块）；id 与前端 MENU_ROUTE_SPECS 顶部项对齐（fm-emergency/fm-fire/fm-security/fm-tv/fm-production）。其余子应用 fm-rescue/fm-typhoon/fm-production-area/fm-major-hazard/fm-communication/fm-video-control/fm-video-wall 不进顶部导航，由前端 SECONDARY_ROUTES 二级隐藏路由承载。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=MenuItem[]）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/MenuItem" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    { "id": "fm-emergency", "name": "应急指挥", "path": "/emergency" },
                    { "id": "fm-fire", "name": "消防报警", "path": "/fire" },
                    { "id": "fm-security", "name": "治安防恐", "path": "/security" },
                    { "id": "fm-tv", "name": "工业电视", "path": "/tv" },
                    { "id": "fm-production", "name": "生产应急", "path": "/production" }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "description": "登录请求体。",
        "properties": {
          "username": { "type": "string", "description": "用户名", "example": "admin" },
          "password": { "type": "string", "description": "口令", "example": "admin@2026" }
        },
        "required": ["username", "password"]
      },
      "TokenResponse": {
        "type": "object",
        "description": "登录/刷新返回。access 存前端内存态（token.ts）；refresh 令牌由后端经 HttpOnly Cookie（name=rt，SameSite=Lax）下发，绝不进本响应体（防 XSS 窃取），故此处无 refreshToken 字段。",
        "properties": {
          "accessToken": { "type": "string", "description": "访问令牌（JWT，短效 2h）" },
          "expiresIn": { "type": "integer", "description": "access 有效期（秒）", "example": 7200 },
          "tokenType": { "type": "string", "description": "令牌类型", "example": "Bearer" }
        },
        "required": ["accessToken", "expiresIn", "tokenType"]
      },
      "CurrentUser": {
        "type": "object",
        "description": "当前登录用户。",
        "properties": {
          "username": {
            "type": "string",
            "description": "登录用户名（唯一标识）",
            "example": "admin"
          },
          "realName": {
            "type": "string",
            "description": "用户真实姓名（展示用）",
            "example": "系统管理员"
          },
          "role": {
            "type": "string",
            "description": "角色码（ADMIN 为管理员，其余为普通角色）",
            "example": "ADMIN"
          }
        }
      },
      "MenuItem": {
        "type": "object",
        "description": "菜单项（可递归嵌套 children）。",
        "properties": {
          "id": {
            "type": "string",
            "description": "菜单 id，与前端路由 name / 权限码对齐",
            "example": "fm-emergency"
          },
          "name": { "type": "string", "description": "展示名", "example": "应急指挥" },
          "path": { "type": "string", "description": "前端路由路径", "example": "/emergency" },
          "children": {
            "type": "array",
            "description": "子菜单（可选，递归）",
            "items": { "$ref": "#/components/schemas/MenuItem" }
          }
        },
        "required": ["id", "name", "path"]
      }
    }
  }
}
