{
  "openapi": "3.0.3",
  "info": {
    "title": "消防设施分项监测接口",
    "description": "覆盖消防设施分项监测大屏的监测概览、台账、故障、报警、维保工单五类数据，取代前端硬编码的 fireFacilityMonitoringMock 业务数据（地图撒点、扫描动画等纯前端几何仍留在 mock）。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/fire-facility/monitors": {
      "get": {
        "summary": "消防设施监测概览",
        "description": "按设施类型返回各分项监测概览：在线/离线/故障计数、状态基调与参数明细（如 CPU/内存/温度），以及最近上报时间。",
        "tags": ["fire-facility"],
        "parameters": [
          {
            "name": "facilityType",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "设施类型筛选（可空字符串表示全部）"
          }
        ],
        "responses": {
          "200": {
            "description": "消防设施监测概览数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FireFacilityMonitorResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "typeOptions": ["消防水泵", "火灾报警控制器", "自动喷淋系统"],
                    "items": [
                      {
                        "key": "pump-01",
                        "facilityType": "消防水泵",
                        "total": 12,
                        "online": 10,
                        "offline": 1,
                        "fault": 1,
                        "status": "fault",
                        "params": [
                          { "label": "CPU", "value": "45%", "tone": "green" },
                          { "label": "内存", "value": "60%", "tone": "green" },
                          { "label": "温度", "value": "78℃", "tone": "red" }
                        ],
                        "lastReportTime": "2026-03-17 10:22:23"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fire-facility/monitors/report": {
      "post": {
        "summary": "消防设施监测运行数据上报",
        "description": "设备/采集/模拟上报 → 按 key_code upsert 监控卡片（计数/状态/最近上报时间）+ 整体替换监控参数，返回刷新后的全量监测概览。需权限码 fire-facility:handle（V68）。标记 fire-facility.monitor 实时广播。命中即局部更新（不传不覆盖），未命中按 facilityType 新建；每次上报刷新 last_report_time。",
        "tags": ["fire-facility"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FireFacilityMonitorReportRequest" },
              "example": {
                "items": [
                  {
                    "key": "water",
                    "facilityType": "消防水源",
                    "total": 46,
                    "online": 44,
                    "offline": 1,
                    "fault": 1,
                    "status": "告警",
                    "lastReportTime": "2026-09-23 08:50:00",
                    "params": [
                      { "label": "水泵运行", "value": "运行", "tone": "normal" },
                      { "label": "水位", "value": "32%", "tone": "warning" }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上报成功，返回刷新后的全量监测概览",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FireFacilityMonitorResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "typeOptions": ["消防水泵", "火灾报警控制器"],
                    "items": [
                      {
                        "key": "water",
                        "facilityType": "消防水源",
                        "total": 46,
                        "online": 44,
                        "offline": 1,
                        "fault": 1,
                        "status": "告警",
                        "params": [{ "label": "水泵运行", "value": "运行", "tone": "normal" }],
                        "lastReportTime": "2026-09-23 08:50:00"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fire-facility/ledger": {
      "get": {
        "summary": "消防设施台账",
        "description": "按设施类型返回设施台账明细：编码、名称、位置、关联设备、维护人联系方式及历史维保记录。",
        "tags": ["fire-facility"],
        "parameters": [
          {
            "name": "facilityType",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "设施类型筛选（可空字符串表示全部）"
          }
        ],
        "responses": {
          "200": {
            "description": "消防设施台账数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FireFacilityLedgerResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "typeOptions": ["消防水泵", "火灾报警控制器"],
                    "items": [
                      {
                        "facilityCode": "FP-001",
                        "facilityName": "1#消防水泵",
                        "facilityType": "消防水泵",
                        "location": "炼油一部泵房",
                        "device": "XBD8/30-150L",
                        "maintainerName": "张伟",
                        "maintainerPhone": "13800000001",
                        "enabled": true,
                        "maintenanceRecords": [
                          {
                            "date": "2026-02-20",
                            "content": "更换密封圈",
                            "reportFile": "https://example.com/report/1.pdf"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fire-facility/faults": {
      "get": {
        "summary": "消防设施故障列表",
        "description": "按故障等级与故障状态筛选返回故障明细，含故障现象、原因、处置进展与完整时间线。",
        "tags": ["fire-facility"],
        "parameters": [
          {
            "name": "faultLevel",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "故障等级筛选（可空字符串表示全部）"
          },
          {
            "name": "faultStatus",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "故障状态筛选（可空字符串表示全部）"
          }
        ],
        "responses": {
          "200": {
            "description": "消防设施故障数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FireFacilityFaultResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      {
                        "id": 1001,
                        "faultCode": "F-20260317-001",
                        "facilityCode": "FP-001",
                        "facilityName": "1#消防水泵",
                        "facilityType": "消防水泵",
                        "faultType": "机械故障",
                        "faultLevel": "严重",
                        "discoverTime": "2026-03-17 09:30:00",
                        "discoverMethod": "自动巡检",
                        "phenomenon": "泵体异响、压力不足",
                        "cause": "轴承磨损",
                        "status": "处理中",
                        "workOrderNo": "WO-20260317-001",
                        "repairPerson": "李强",
                        "estimatedFinish": "2026-03-18 18:00:00",
                        "actualFinish": null,
                        "repairMeasures": "更换轴承并校准",
                        "acceptancePerson": null,
                        "acceptanceResult": null,
                        "timeline": [
                          {
                            "time": "2026-03-17 09:30:00",
                            "operator": "系统",
                            "action": "发现故障",
                            "detail": "自动巡检触发压力告警"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fire-facility/faults/{faultId}": {
      "put": {
        "summary": "消防设施故障写回",
        "description": "确认/派单/维修/验收状态流转 + 派单/维修/验收字段局部更新 + 时间线追加。需权限码 fire-facility:handle（V68 已登记并授权）。返回更新后的故障明细（含完整时间线），供前端即时回填并触发 fire-facility.fault 实时广播。字段均为可选，未传则不更新（read-modify-write）。",
        "tags": ["fire-facility"],
        "parameters": [
          {
            "name": "faultId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "故障记录 id（fac_fire_facility_fault.id）"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FireFacilityFaultUpdateRequest" },
              "example": {
                "faultStatus": "已确认",
                "timelines": [
                  {
                    "time": "2026-09-22 10:30:00",
                    "operator": "值班员",
                    "action": "确认故障",
                    "detail": "确认为故障，待派单"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "写回成功，返回更新后的故障明细",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FireFacilityFaultItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1001,
                    "faultCode": "F-20260317-001",
                    "status": "已确认",
                    "workOrderNo": null,
                    "repairPerson": null,
                    "timeline": [
                      {
                        "time": "2026-03-17 09:30:00",
                        "operator": "系统",
                        "action": "发现故障",
                        "detail": "自动巡检触发压力告警"
                      },
                      {
                        "time": "2026-09-22 10:30:00",
                        "operator": "值班员",
                        "action": "确认故障",
                        "detail": "确认为故障，待派单"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fire-facility/alarms": {
      "get": {
        "summary": "消防设施报警列表",
        "description": "按报警等级与处理状态筛选返回报警明细，含报警来源、类别、内容、时间与关联故障单。",
        "tags": ["fire-facility"],
        "parameters": [
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "报警等级筛选（可空字符串表示全部）"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "报警处理状态筛选（可空字符串表示全部）"
          }
        ],
        "responses": {
          "200": {
            "description": "消防设施报警数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FireFacilityAlarmResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      {
                        "id": 2001,
                        "source": "火灾报警控制器",
                        "facilityType": "火灾报警控制器",
                        "level": "一级",
                        "category": "烟感报警",
                        "content": "3#装置区烟感触发",
                        "time": "2026-03-17 08:15:00",
                        "status": "已处理",
                        "faultCode": "F-20260317-002"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fire-facility/work-orders": {
      "get": {
        "summary": "消防设施维保工单列表",
        "description": "按工单状态筛选返回维保工单明细，含关联故障、派工、处置进展与完整时间线。",
        "tags": ["fire-facility"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "工单状态筛选（可空字符串表示全部）"
          }
        ],
        "responses": {
          "200": {
            "description": "消防设施维保工单数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FireFacilityWorkOrderResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      {
                        "id": 3001,
                        "workOrderNo": "WO-20260317-001",
                        "faultCode": "F-20260317-001",
                        "facilityCode": "FP-001",
                        "facilityName": "1#消防水泵",
                        "facilityType": "消防水泵",
                        "faultLevel": "严重",
                        "description": "泵体异响、压力不足",
                        "status": "处理中",
                        "dispatchTime": "2026-03-17 09:40:00",
                        "repairPerson": "李强",
                        "estimatedFinish": "2026-03-18 18:00:00",
                        "actualFinish": null,
                        "timeline": [
                          {
                            "time": "2026-03-17 09:40:00",
                            "operator": "调度员",
                            "action": "派单",
                            "detail": "派工至李强"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FireFacilityMonitorParam": {
        "type": "object",
        "description": "监测参数明细项",
        "properties": {
          "label": { "type": "string", "description": "参数名称", "example": "CPU" },
          "value": { "type": "string", "description": "参数取值", "example": "45%" },
          "tone": {
            "type": "string",
            "description": "着色基调：green/blue/red/grey",
            "example": "green"
          }
        }
      },
      "FireFacilityMonitorSummary": {
        "type": "object",
        "description": "单个设施类型的监测概览",
        "properties": {
          "key": { "type": "string", "description": "分项唯一键", "example": "pump-01" },
          "facilityType": { "type": "string", "description": "设施类型", "example": "消防水泵" },
          "total": { "type": "integer", "description": "设施总数", "example": 12 },
          "online": { "type": "integer", "description": "在线数", "example": 10 },
          "offline": { "type": "integer", "description": "离线数", "example": 1 },
          "fault": { "type": "integer", "description": "故障数", "example": 1 },
          "status": {
            "type": "string",
            "description": "状态基调：normal/online/offline/fault",
            "example": "fault"
          },
          "params": {
            "type": "array",
            "description": "参数明细列表",
            "items": { "$ref": "#/components/schemas/FireFacilityMonitorParam" }
          },
          "lastReportTime": {
            "type": "string",
            "description": "最近上报时间",
            "example": "2026-03-17 10:22:23"
          }
        }
      },
      "FireFacilityMonitorResult": {
        "type": "object",
        "description": "消防设施监测概览聚合",
        "properties": {
          "typeOptions": {
            "type": "array",
            "description": "设施类型下拉选项",
            "items": { "type": "string" }
          },
          "items": {
            "type": "array",
            "description": "各设施类型监测概览列表",
            "items": { "$ref": "#/components/schemas/FireFacilityMonitorSummary" }
          }
        }
      },
      "FireFacilityMonitorReportParam": {
        "type": "object",
        "description": "监测运行数据上报 - 监控参数项",
        "properties": {
          "label": { "type": "string", "description": "参数名称", "example": "水泵运行" },
          "value": { "type": "string", "description": "参数取值", "example": "运行" },
          "tone": {
            "type": "string",
            "description": "着色基调：green/blue/red/grey/normal/warning/danger",
            "example": "normal"
          }
        }
      },
      "FireFacilityMonitorReportItem": {
        "type": "object",
        "description": "监测运行数据上报 - 单分项条目（按 key upsert）",
        "properties": {
          "key": {
            "type": "string",
            "description": "分项唯一键（key_code），必填",
            "example": "water"
          },
          "facilityType": {
            "type": "string",
            "description": "设施类型（新建分项时必填）",
            "example": "消防水源"
          },
          "total": { "type": "integer", "description": "设施总数", "example": 46 },
          "online": { "type": "integer", "description": "在线数", "example": 44 },
          "offline": { "type": "integer", "description": "离线数", "example": 1 },
          "fault": { "type": "integer", "description": "故障数", "example": 1 },
          "status": {
            "type": "string",
            "description": "监测状态：正常/告警/离线/在线",
            "example": "告警"
          },
          "lastReportTime": {
            "type": "string",
            "description": "最近上报时间（yyyy-MM-dd HH:mm:ss），不传则用上报时刻",
            "example": "2026-09-23 08:50:00"
          },
          "params": {
            "type": "array",
            "description": "监控参数明细（传入即整体替换）",
            "items": { "$ref": "#/components/schemas/FireFacilityMonitorReportParam" }
          }
        }
      },
      "FireFacilityMonitorReportRequest": {
        "type": "object",
        "description": "消防设施监测运行数据上报请求：设备/采集/模拟上报的分项列表",
        "properties": {
          "items": {
            "type": "array",
            "description": "上报的分项列表（按 key upsert）",
            "items": { "$ref": "#/components/schemas/FireFacilityMonitorReportItem" }
          }
        }
      },
      "FireFacilityMaintenanceRecord": {
        "type": "object",
        "description": "设施维保记录项",
        "properties": {
          "date": { "type": "string", "description": "维保日期", "example": "2026-02-20" },
          "content": { "type": "string", "description": "维保内容", "example": "更换密封圈" },
          "reportFile": {
            "type": ["string", "null"],
            "description": "维保报告文件地址",
            "example": "https://example.com/report/1.pdf"
          }
        }
      },
      "FireFacilityLedgerItem": {
        "type": "object",
        "description": "设施台账明细项",
        "properties": {
          "facilityCode": { "type": "string", "description": "设施编码", "example": "FP-001" },
          "facilityName": { "type": "string", "description": "设施名称", "example": "1#消防水泵" },
          "facilityType": { "type": "string", "description": "设施类型", "example": "消防水泵" },
          "location": { "type": "string", "description": "安装位置", "example": "炼油一部泵房" },
          "device": { "type": "string", "description": "关联设备型号", "example": "XBD8/30-150L" },
          "maintainerName": { "type": "string", "description": "维护人姓名", "example": "张伟" },
          "maintainerPhone": {
            "type": "string",
            "description": "维护人电话",
            "example": "13800000001"
          },
          "enabled": { "type": "boolean", "description": "是否启用", "example": true },
          "maintenanceRecords": {
            "type": "array",
            "description": "历史维保记录",
            "items": { "$ref": "#/components/schemas/FireFacilityMaintenanceRecord" }
          }
        }
      },
      "FireFacilityLedgerResult": {
        "type": "object",
        "description": "消防设施台账聚合",
        "properties": {
          "typeOptions": {
            "type": "array",
            "description": "设施类型下拉选项",
            "items": { "type": "string" }
          },
          "items": {
            "type": "array",
            "description": "设施台账明细列表",
            "items": { "$ref": "#/components/schemas/FireFacilityLedgerItem" }
          }
        }
      },
      "FireFacilityFaultTimelineItem": {
        "type": "object",
        "description": "故障/工单时间线条目",
        "properties": {
          "time": { "type": "string", "description": "发生时间", "example": "2026-03-17 09:30:00" },
          "operator": { "type": "string", "description": "操作人/系统", "example": "系统" },
          "action": { "type": "string", "description": "操作动作", "example": "发现故障" },
          "detail": {
            "type": "string",
            "description": "操作详情",
            "example": "自动巡检触发压力告警"
          }
        }
      },
      "FireFacilityFaultTimelineCreate": {
        "type": "object",
        "description": "故障写回时随状态流转追加的时间线条目",
        "properties": {
          "time": {
            "type": "string",
            "description": "发生时间（yyyy-MM-dd HH:mm:ss）",
            "example": "2026-09-22 10:30:00"
          },
          "operator": { "type": "string", "description": "操作人", "example": "值班员" },
          "action": {
            "type": "string",
            "description": "操作动作（如 确认故障 / 生成工单并派发 / 开始维修 / 提交验收 / 验收合格 / 验收不合格）",
            "example": "确认故障"
          },
          "detail": { "type": "string", "description": "操作详情", "example": "确认为故障，待派单" }
        }
      },
      "FireFacilityFaultUpdateRequest": {
