{
  "openapi": "3.0.3",
  "info": {
    "title": "应急救援资源台账接口（救援装备/人员/车辆/消防队伍）",
    "description": "取代前端硬编码的 rescueEquipmentMock / rescuePersonnelMock / rescueVehicleMock / fireBrigadeMock 业务数据。覆盖救援装备台账、救援人员台账、救援车辆台账（含随车人员/随车装备/消耗品/出车汇总）与消防队伍台账（含下属车辆/人员/装备）。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/rescue-resources/equipment": {
      "get": {
        "summary": "救援装备台账列表",
        "description": "按中队的名称模糊可选过滤，返回装备品类聚合（中队集合 + 套装总数 + 装备项明细）。",
        "tags": ["rescue-resource"],
        "parameters": [
          {
            "name": "squadron",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "中队名称（可选过滤）"
          }
        ],
        "responses": {
          "200": {
            "description": "救援装备台账列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RescueEquipmentList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "squadrons": ["炼油中队", "化工中队"],
                    "totalSets": 128,
                    "items": [
                      {
                        "id": 1,
                        "name": "正压式空气呼吸器",
                        "squadron": "炼油中队",
                        "quantity": 6,
                        "leaderName": "王强",
                        "leaderPhone": "13800000001",
                        "stockQuantity": 2,
                        "model": "RHZKF6.8",
                        "protectionType": "自给开路式",
                        "filterCanister": "碳纤维气瓶",
                        "maxContinuousUse": "60min",
                        "storageLocation": "器材库A区",
                        "purchaseBatch": "2023-01",
                        "factoryValidityYears": "15年",
                        "remainingValidity": "12年",
                        "lastInspectionDate": "2025-10-01",
                        "nextMandatoryMaintenanceDate": "2026-04-01",
                        "equipmentStatus": "在用",
                        "scrapWarning": "无",
                        "issueRegistration": "无",
                        "spareParts": "面罩1套"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rescue-resources/equipment/{id}": {
      "get": {
        "summary": "救援装备明细",
        "description": "按装备 id 返回单条装备台账明细。",
        "tags": ["rescue-resource"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" },
            "description": "装备 id"
          }
        ],
        "responses": {
          "200": {
            "description": "救援装备明细",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RescueEquipmentItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1,
                    "name": "正压式空气呼吸器",
                    "squadron": "炼油中队",
                    "quantity": 6,
                    "leaderName": "王强",
                    "leaderPhone": "13800000001",
                    "stockQuantity": 2,
                    "model": "RHZKF6.8",
                    "protectionType": "自给开路式",
                    "filterCanister": "碳纤维气瓶",
                    "maxContinuousUse": "60min",
                    "storageLocation": "器材库A区",
                    "purchaseBatch": "2023-01",
                    "factoryValidityYears": "15年",
                    "remainingValidity": "12年",
                    "lastInspectionDate": "2025-10-01",
                    "nextMandatoryMaintenanceDate": "2026-04-01",
                    "equipmentStatus": "在用",
                    "scrapWarning": "无",
                    "issueRegistration": "无",
                    "spareParts": "面罩1套"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rescue-resources/personnel": {
      "get": {
        "summary": "救援人员台账列表",
        "description": "按中队与角色可选过滤，返回人员聚合（中队集合 + 角色集合 + 人员总数 + 人员明细）。",
        "tags": ["rescue-resource"],
        "parameters": [
          {
            "name": "squadron",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "中队名称（可选过滤）"
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "角色（可选过滤）"
          }
        ],
        "responses": {
          "200": {
            "description": "救援人员台账列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RescuePersonnelList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "squadrons": ["炼油中队", "化工中队"],
                    "roles": ["队长", "队员"],
                    "totalCount": 42,
                    "items": [{ "id": 1, "name": "王强", "squadron": "炼油中队", "role": "队长" }]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rescue-resources/personnel/{id}": {
      "get": {
        "summary": "救援人员明细",
        "description": "按人员 id 返回单条救援人员台账明细。",
        "tags": ["rescue-resource"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" },
            "description": "人员 id"
          }
        ],
        "responses": {
          "200": {
            "description": "救援人员明细",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RescuePersonnelItem" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": { "id": 1, "name": "王强", "squadron": "炼油中队", "role": "队长" }
                }
              }
            }
          }
        }
      }
    },
    "/rescue-resources/vehicles": {
      "get": {
        "summary": "救援车辆台账列表",
