  },
  "components": {
    "schemas": {
      "RescueEquipmentList": {
        "type": "object",
        "description": "救援装备台账列表聚合",
        "properties": {
          "squadrons": {
            "type": "array",
            "description": "涉及的中队名称集合",
            "items": { "type": "string", "description": "中队名称", "example": "炼油中队" }
          },
          "totalSets": { "type": "integer", "description": "装备套装总数", "example": 128 },
          "items": {
            "type": "array",
            "description": "装备项明细列表",
            "items": { "$ref": "#/components/schemas/RescueEquipmentItem" }
          }
        }
      },
      "RescueEquipmentItem": {
        "type": "object",
        "description": "救援装备台账项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "装备 id", "example": 1 },
          "name": { "type": "string", "description": "装备名称", "example": "正压式空气呼吸器" },
          "squadron": { "type": "string", "description": "所属中队", "example": "炼油中队" },
          "quantity": { "type": "integer", "description": "配置数量", "example": 6 },
          "leaderName": {
            "type": ["string", "null"],
            "description": "装备负责人姓名",
            "example": "王强"
          },
          "leaderPhone": {
            "type": ["string", "null"],
            "description": "装备负责人电话",
            "example": "13800000001"
          },
          "stockQuantity": { "type": "integer", "description": "库存数量", "example": 2 },
          "model": { "type": ["string", "null"], "description": "型号", "example": "RHZKF6.8" },
          "protectionType": {
            "type": ["string", "null"],
            "description": "防护类型",
            "example": "自给开路式"
          },
          "filterCanister": {
            "type": ["string", "null"],
            "description": "滤毒罐/气瓶类型",
            "example": "碳纤维气瓶"
          },
          "maxContinuousUse": {
            "type": ["string", "null"],
            "description": "最大连续使用时间",
            "example": "60min"
          },
          "storageLocation": {
            "type": ["string", "null"],
            "description": "存放位置",
            "example": "器材库A区"
          },
          "purchaseBatch": {
            "type": ["string", "null"],
            "description": "采购批次",
            "example": "2023-01"
          },
          "factoryValidityYears": {
            "type": ["string", "null"],
            "description": "出厂有效期年限",
            "example": "15年"
          },
          "remainingValidity": {
            "type": ["string", "null"],
            "description": "剩余有效期",
            "example": "12年"
          },
          "lastInspectionDate": {
            "type": ["string", "null"],
            "description": "上次检验日期",
            "example": "2025-10-01"
          },
          "nextMandatoryMaintenanceDate": {
            "type": ["string", "null"],
            "description": "下次强制保养日期",
            "example": "2026-04-01"
          },
          "equipmentStatus": {
            "type": ["string", "null"],
            "description": "装备状态",
            "example": "在用"
          },
          "scrapWarning": {
            "type": ["string", "null"],
            "description": "报废预警",
            "example": "无"
          },
          "issueRegistration": {
            "type": ["string", "null"],
            "description": "故障/出库登记",
            "example": "无"
          },
          "spareParts": {
            "type": ["string", "null"],
            "description": "备品备件",
            "example": "面罩1套"
          }
        }
      },
      "RescuePersonnelList": {
        "type": "object",
        "description": "救援人员台账列表聚合",
        "properties": {
          "squadrons": {
            "type": "array",
            "description": "涉及的中队名称集合",
            "items": { "type": "string", "description": "中队名称", "example": "炼油中队" }
          },
          "roles": {
            "type": "array",
            "description": "涉及的角色集合",
            "items": { "type": "string", "description": "角色名", "example": "队长" }
          },
          "totalCount": { "type": "integer", "description": "人员总数", "example": 42 },
          "items": {
            "type": "array",
            "description": "人员明细列表",
            "items": { "$ref": "#/components/schemas/RescuePersonnelItem" }
          }
        }
      },
      "RescuePersonnelItem": {
        "type": "object",
        "description": "救援人员台账项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "人员 id", "example": 1 },
          "name": { "type": "string", "description": "姓名", "example": "王强" },
          "squadron": { "type": "string", "description": "所属中队", "example": "炼油中队" },
          "role": { "type": "string", "description": "角色", "example": "队长" }
        }
      },
      "RescueVehicleList": {
        "type": "object",
        "description": "救援车辆台账列表聚合",
        "properties": {
          "squadrons": {
            "type": "array",
            "description": "涉及的中队名称集合",
            "items": { "type": "string", "description": "中队名称", "example": "炼油中队" }
          },
          "types": {
            "type": "array",
            "description": "涉及的车辆类型集合",
            "items": { "type": "string", "description": "车辆类型", "example": "泡沫消防车" }
          },
          "items": {
            "type": "array",
            "description": "车辆明细列表",
            "items": { "$ref": "#/components/schemas/RescueVehicleItem" }
          }
        }
      },
      "RescueVehicleItem": {
        "type": "object",
        "description": "救援车辆台账项",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "车辆 id", "example": 1 },
          "plate": { "type": ["string", "null"], "description": "车牌号", "example": "粤K12345" },
          "type": {
            "type": ["string", "null"],
            "description": "车辆类型",
            "example": "泡沫消防车"
          },
          "squadron": {
            "type": ["string", "null"],
            "description": "所属中队",
            "example": "炼油中队"
          },
          "leaderName": {
            "type": ["string", "null"],
            "description": "车组长姓名",
            "example": "王强"
          },
          "leaderPhone": {
            "type": ["string", "null"],
            "description": "车组长电话",
            "example": "13800000001"
          },
          "status": { "type": ["string", "null"], "description": "车辆状态", "example": "执勤" },
          "businessName": {
            "type": ["string", "null"],
            "description": "所属单位/业务名称",
            "example": "应急消防"
          },
          "vehicleTypeFull": {
            "type": ["string", "null"],
            "description": "车辆类型全称",
            "example": "重型泡沫消防车"
          },
          "parkingLocation": {
            "type": ["string", "null"],
            "description": "停放位置",
            "example": "消防站1号库"
          },
          "chassisModel": {
            "type": ["string", "null"],
            "description": "底盘型号",
            "example": "ZZ5207"
          },
