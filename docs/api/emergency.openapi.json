{
  "openapi": "3.0.3",
  "info": {
    "title": "应急资源 Emergency API",
    "version": "1.0.0",
    "x-base-path": "/api/v1",
    "x-contract": "B3",
    "description": "应急力量 / 结案 / 值班值守 / 应急通讯录 / 安全知识接口（代码真实契约）。契约源：src/services/emergency.ts、closedCases.ts、duty.ts、emergencyPhone.ts、knowledge.ts。"
  },
  "servers": [{ "url": "/api/v1", "description": "默认 baseURL（VITE_API_BASE 可覆盖）" }],
  "security": [{ "bearerAuth": [], "replaySign": [] }],
  "tags": [{ "name": "emergency", "description": "应急资源" }],
  "paths": {
    "/emergency/strength": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyStrength",
        "summary": "应急力量统计",
        "description": "按维度统计应急资源数量。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=EmergencyStrength）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/EmergencyStrength" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "resources": [
                      { "kind": "应急专家", "count": 47, "icon": "UserFilled" },
                      { "kind": "应急物资", "count": 3510, "icon": "Box" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/assist-stats": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyAssistStats",
        "summary": "应急辅助信息统计",
        "description": "返回 4 项应急辅助 KPI：应急预案 / 现场处置卡 / 应急联络人 / 可用消防水源。数据源 V39 fac_emergency_assist_stat 参考表。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=EmergencyAssistStatSummary）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/EmergencyAssistStatSummary" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      { "label": "应急预案", "value": 15, "unit": "套", "tone": "blue" },
                      { "label": "现场处置卡", "value": 32, "unit": "张", "tone": "cyan" },
                      { "label": "应急联络人", "value": 18, "unit": "人", "tone": "green" },
                      { "label": "可用消防水源", "value": 306, "unit": "处", "tone": "orange" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/closed-cases": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getClosedCases",
        "summary": "近期已结案列表",
        "description": "返回近期已闭环处置的应急事件列表，供复盘检索。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=ClosedCaseList）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/ClosedCaseList" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "cases": [
                      {
                        "caseId": "C-2026-081",
                        "title": "A 装置反应釜温度异常",
                        "location": "装置区 03 单元",
                        "closedAt": "2026-09-04T07:45:00.000Z",
                        "handler": "王斌"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/duty": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getDutyRoster",
        "summary": "应急值班值守表",
        "description": "返回当前应急值班值守排班表，含部门切换与成员信息。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=DutyRoster）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/DutyRoster" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "departments": ["全部"],
                    "shift": "白班",
                    "members": [
                      {
                        "id": "d1",
                        "name": "杨恒明",
                        "phone": "13792536966",
                        "role": "值班领导",
                        "department": "全部",
                        "shift": "白班"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/phones": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyPhones",
        "summary": "应急电话通讯录",
        "description": "返回消防/医疗/公安等应急联络电话通讯录。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=EmergencyPhoneBook）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/EmergencyPhoneBook" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "entries": [
                      { "id": "ph1", "name": "消防报警", "number": "119", "category": "消防" },
                      { "id": "ph2", "name": "医疗急救", "number": "120", "category": "医疗" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/knowledge": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyKnowledge",
        "summary": "应急生产安全知识",
        "description": "返回应急生产安全知识点列表，支持按分类检索。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=KnowledgeList）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/KnowledgeList" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      { "id": "k1", "title": "岗位应急处置卡", "count": 158, "icon": "Document" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/dispatch-personnel": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getDispatchPersonnel",
        "summary": "应急派单人员名册",
        "description": "返回应急指挥可指派的人员名册，供告警详情「派单人员」下拉使用。数据来自 fac_dispatch_personnel 参考表，按 sort_no 升序，仅返回启用人员。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=DispatchPersonnel[]）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/DispatchPersonnel" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": 1,
                      "name": "杨恒朋",
                      "role": "值班领导",
                      "department": "公司总值班室",
                      "phone": "137-9253-6966"
                    },
                    {
                      "id": 3,
                      "name": "王钰",
                      "role": "消防队长",
                      "department": "炼油消防一中队",
                      "phone": "183-0055-6145"
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/commands": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyCommandGroups",
        "summary": "应急指挥指令分组列表",
        "description": "返回固定/临时指令分组（一键通知/一键调度/临时通知/临时调度），可按 tab 过滤。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "tab",
            "in": "query",
            "required": false,
            "description": "指令分类：fixed=固定指令，temp=临时指令；缺省返回全部",
            "schema": { "type": "string", "enum": ["fixed", "temp"] }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=EmergencyCommandGroup[]）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/EmergencyCommandGroup" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "notify",
                      "label": "一键通知",
                      "items": [
                        {
                          "id": "n1",
                          "type": "通知",
                          "name": "通知值班人员",
                          "location": "中海壳牌石油化工有限公司",
                          "status": "待处置",
                          "done": false
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/commands/{commandId}": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyCommandDetail",
        "summary": "应急指挥指令行动详情",
        "description": "返回单条指令的派发渠道/对象/执行日志等富文本详情。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "commandId",
            "in": "path",
            "required": true,
            "description": "指令 ID（如 n1/d1/t2）",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=CommandActionDetail）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/CommandActionDetail" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "n1",
                    "name": "通知值班人员",
                    "type": "通知",
                    "notifyChannels": ["app", "sms", "voice"],
