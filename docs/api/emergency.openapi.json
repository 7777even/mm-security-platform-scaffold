{
  "openapi": "3.0.3",
  "info": {
    "title": "应急资源 Emergency API",
    "version": "1.0.0",
    "x-base-path": "/api/v1",
    "x-contract": "B3",
    "description": "应急力量 / 结案 / 值班值守 / 应急通讯录 / 安全知识接口（代码真实契约）。契约源：src/services/emergency.ts、closedCases.ts、duty.ts、emergencyPhone.ts、knowledge.ts。"
  },
  "servers": [{ "url": "/api/v1", "description": "默认 baseURL（VITE_API_BASE 可覆盖）" }],
  "security": [{ "bearerAuth": [], "replaySign": [] }],
  "tags": [{ "name": "emergency", "description": "应急资源" }],
  "paths": {
    "/emergency/strength": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyStrength",
        "summary": "应急力量统计",
        "description": "按维度统计应急资源数量。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=EmergencyStrength）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/EmergencyStrength" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "resources": [
                      { "kind": "应急专家", "count": 47, "icon": "UserFilled" },
                      { "kind": "应急物资", "count": 3510, "icon": "Box" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/closed-cases": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getClosedCases",
        "summary": "近期已结案列表",
        "description": "返回近期已闭环处置的应急事件列表，供复盘检索。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=ClosedCaseList）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/ClosedCaseList" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "cases": [
                      {
                        "caseId": "C-2026-081",
                        "title": "A 装置反应釜温度异常",
                        "location": "装置区 03 单元",
                        "closedAt": "2026-09-04T07:45:00.000Z",
                        "handler": "王斌"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/duty": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getDutyRoster",
        "summary": "应急值班值守表",
        "description": "返回当前应急值班值守排班表，含部门切换与成员信息。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=DutyRoster）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/DutyRoster" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "departments": ["全部"],
                    "shift": "白班",
                    "members": [
                      {
                        "id": "d1",
                        "name": "杨恒明",
                        "phone": "13792536966",
                        "role": "值班领导",
                        "department": "全部",
                        "shift": "白班"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/phones": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyPhones",
        "summary": "应急电话通讯录",
        "description": "返回消防/医疗/公安等应急联络电话通讯录。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=EmergencyPhoneBook）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/EmergencyPhoneBook" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "entries": [
                      { "id": "ph1", "name": "消防报警", "number": "119", "category": "消防" },
                      { "id": "ph2", "name": "医疗急救", "number": "120", "category": "医疗" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/knowledge": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyKnowledge",
        "summary": "应急生产安全知识",
        "description": "返回应急生产安全知识点列表，支持按分类检索。",
        "parameters": [{ "$ref": "./_shared.json#/components/parameters/lang" }],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=KnowledgeList）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/KnowledgeList" } }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      { "id": "k1", "title": "岗位应急处置卡", "count": 158, "icon": "Document" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/commands": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyCommandGroups",
        "summary": "应急指挥指令分组列表",
        "description": "返回固定/临时指令分组（一键通知/一键调度/临时通知/临时调度），可按 tab 过滤。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "tab",
            "in": "query",
            "required": false,
            "description": "指令分类：fixed=固定指令，temp=临时指令；缺省返回全部",
            "schema": { "type": "string", "enum": ["fixed", "temp"] }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=EmergencyCommandGroup[]）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/EmergencyCommandGroup" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "id": "notify",
                      "label": "一键通知",
                      "items": [
                        {
                          "id": "n1",
                          "type": "通知",
                          "name": "通知值班人员",
                          "location": "中海壳牌石油化工有限公司",
                          "status": "待处置",
                          "done": false
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/commands/{commandId}": {
      "get": {
        "tags": ["emergency"],
        "operationId": "getEmergencyCommandDetail",
        "summary": "应急指挥指令行动详情",
        "description": "返回单条指令的派发渠道/对象/执行日志等富文本详情。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/lang" },
          {
            "name": "commandId",
            "in": "path",
            "required": true,
            "description": "指令 ID（如 n1/d1/t2）",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=CommandActionDetail）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/CommandActionDetail" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "n1",
                    "name": "通知值班人员",
                    "type": "通知",
                    "notifyChannels": ["app", "sms", "voice"],
                    "status": "待处置",
                    "dispatchMode": "自动派发",
                    "location": "中海壳牌石油化工有限公司",
                    "description": "【2026-04-27 14:55:24】装置区发生疑似火灾事故，请按预案开展通知与前置处置，保持信息同步。",
                    "attachment": "—",
                    "addressBookRecipients": [
                      {
                        "id": "ab1",
                        "role": "公司总值班室",
                        "name": "宋文帅",
                        "phone": "13792536966"
                      }
                    ],
                    "dutyRecipients": [
                      { "id": "dy1", "role": "值班领导", "name": "杨恒朋", "phone": "13792536966" }
                    ],
                    "dynamics": [
                      {
                        "id": "n1-1",
                        "time": "2026-04-27 14:56:10",
                        "type": "系统",
                        "operator": "应急指挥平台",
                        "result": "已记录",
                        "content": "根据公司级应急预案自动生成「通知值班人员」指令，共匹配 6 名当日值班人员。"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      }
    },
    "/emergency/process/node-configs": {
      "get": {
        "summary": "应急流程节点联动配置列表",
        "description": "返回应急流程各节点（接警研判/1min/3min/5min/装置区/全厂/政府/完成处置/总结与恢复）的镜头锚点优先级、左右面板显隐与值班自动排班配置，按 sort_no 升序。",
        "tags": ["emergency"],
        "responses": {
          "200": {
            "description": "节点联动配置列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NodePhaseConfigList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "nodeId": "alarmJudgement",
                      "nodeName": "1. 接警研判",
                      "mapCamera": {
                        "anchorPriorityList": [
                          "alarm_phone_location",
                          "event_device",
                          "alarm_phone_zone",
                          "factory_center"
                        ],
                        "customCenter": null,
                        "bufferRadiusMeters": 260
                      },
                      "rightPanelHiddenTabs": [],
                      "leftPanelHiddenPanels": [],
                      "duty": { "autoRoster": true }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "summary": "保存应急流程节点联动配置",
        "description": "按 nodeId 整体 upsert（存在则更新，不存在则新建）流程节点联动配置；入参为前端整表单次提交的全部节点配置，返回落库后的全量列表。",
        "tags": ["emergency"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NodePhaseConfigList" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存后的节点联动配置列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NodePhaseConfigList" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": [
                    {
                      "nodeId": "3min",
                      "nodeName": "3. 三分钟退守稳态",
                      "mapCamera": {
                        "anchorPriorityList": ["event_device", "factory_center"],
                        "customCenter": null,
                        "bufferRadiusMeters": 320
                      },
                      "rightPanelHiddenTabs": ["dynamics"],
                      "leftPanelHiddenPanels": ["info"],
                      "duty": { "autoRoster": true }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmergencyStrength": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmergencyResource" },
            "description": "按维度统计的应急资源"
          }
        }
      },
      "EmergencyResource": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "应急专家",
              "应急物资",
              "救援队伍",
              "装备车辆",
              "应急场所",
              "医疗机构",
              "应急车辆",
              "消防设施"
            ],
            "description": "资源类别",
            "example": "应急专家"
          },
          "count": { "type": "integer", "description": "数量", "example": 47 },
          "icon": {
            "type": "string",
            "description": "图标名（Element Plus icon 名）",
            "example": "UserFilled"
          }
        }
      },
      "ClosedCaseList": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ClosedCase" },
            "description": "已结案事件列表"
          }
        }
      },
      "ClosedCase": {
        "type": "object",
        "properties": {
          "caseId": { "type": "string", "description": "结案 ID", "example": "C-2026-081" },
          "title": { "type": "string", "description": "事件标题" },
          "location": { "type": "string", "description": "事发位置" },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "description": "结案时间（ISO8601）"
          },
          "handler": { "type": "string", "description": "处置人" }
        }
      },
      "DutyRoster": {
        "type": "object",
        "properties": {
          "departments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "可切换的部门列表（含「全部」）"
          },
          "shift": { "$ref": "#/components/schemas/DutyShift" },
          "members": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DutyMember" },
            "description": "值班成员列表"
          }
        }
      },
      "DutyMember": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "成员唯一 ID", "example": "d1" },
          "name": { "type": "string", "description": "姓名", "example": "杨恒明" },
          "phone": { "type": "string", "description": "联系电话", "example": "13792536966" },
          "role": { "$ref": "#/components/schemas/DutyRole" },
          "department": { "type": "string", "description": "所属部门", "example": "全部" },
          "shift": { "$ref": "#/components/schemas/DutyShift" }
        }
      },
      "DutyRole": { "type": "string", "enum": ["值班领导", "值班员"], "example": "值班领导" },
      "DutyShift": { "type": "string", "enum": ["白班", "夜班"], "example": "白班" },
      "EmergencyPhoneBook": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmergencyPhone" },
            "description": "通讯录条目列表"
          }
        }
      },
      "EmergencyPhone": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "通讯录条目 ID", "example": "ph1" },
          "name": { "type": "string", "description": "名称/单位", "example": "消防报警" },
          "number": { "type": "string", "description": "联系电话", "example": "119" },
          "category": {
            "type": "string",
            "description": "分类",
            "enum": ["消防", "医疗", "公安", "厂内应急", "保卫值班", "应急通讯", "智能联动"],
            "example": "消防"
          }
        }
      },
      "KnowledgeList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KnowledgeItem" },
            "description": "知识条目列表"
          }
        }
      },
      "KnowledgeItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "知识条目 ID", "example": "k1" },
          "title": { "type": "string", "description": "标题", "example": "岗位应急处置卡" },
          "count": { "type": "integer", "description": "知识条目数", "example": 158 },
          "icon": {
            "type": "string",
            "description": "图标名（Element Plus icon 名）",
            "example": "Document"
          }
        }
      },
      "EmergencyCommandGroup": {
        "type": "object",
        "description": "应急指挥指令分组（固定/临时）",
        "properties": {
          "id": {
            "type": "string",
            "description": "分组 ID（notify/dispatch/temp-notify/temp-dispatch）",
            "example": "notify"
          },
          "label": { "type": "string", "description": "分组名称", "example": "一键通知" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmergencyCommandInstruction" },
            "description": "分组内指令卡片列表"
          }
        }
      },
      "EmergencyCommandInstruction": {
        "type": "object",
        "description": "应急指挥单条指令卡片",
        "properties": {
          "id": { "type": "string", "description": "指令 ID", "example": "n1" },
          "type": {
            "type": "string",
            "description": "指令类型",
            "enum": ["通知", "任务"],
            "example": "通知"
          },
          "name": { "type": "string", "description": "指令名称", "example": "通知值班人员" },
          "location": {
            "type": "string",
            "description": "作用位置",
            "example": "中海壳牌石油化工有限公司"
          },
          "status": {
            "type": "string",
            "description": "处置状态",
            "enum": ["待处置", "已处置", "待派发"],
            "example": "待处置"
          },
          "actionLabel": {
            "type": "string",
            "description": "操作按钮文案（如「一键派发」），无则为空",
            "example": "一键派发"
          },
          "done": { "type": "boolean", "description": "是否已处置完毕", "example": false }
        }
      },
      "CommandActionDetail": {
        "type": "object",
        "description": "应急指挥指令行动详情",
        "properties": {
          "id": { "type": "string", "description": "指令 ID", "example": "n1" },
          "name": { "type": "string", "description": "指令名称", "example": "通知值班人员" },
          "type": {
            "type": "string",
            "description": "指令类型",
            "enum": ["通知", "任务"],
            "example": "通知"
          },
          "notifyChannels": {
            "type": "array",
            "items": { "type": "string", "enum": ["app", "sms", "voice"] },
            "description": "通知渠道"
          },
          "status": {
            "type": "string",
            "description": "处置状态",
            "enum": ["待处置", "已处置", "待派发"],
            "example": "待处置"
          },
          "dispatchMode": { "type": "string", "description": "派发方式", "example": "自动派发" },
          "location": {
            "type": "string",
            "description": "作用位置",
            "example": "中海壳牌石油化工有限公司"
          },
          "description": { "type": "string", "description": "指令描述/背景" },
          "attachment": {
            "type": "string",
            "description": "附件说明，无则为「—」",
            "example": "—"
          },
          "addressBookRecipients": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionRecipient" },
            "description": "通讯录派发对象"
          },
          "dutyRecipients": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionRecipient" },
            "description": "值班人员派发对象"
          },
          "dynamics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionDynamicEntry" },
            "description": "指令执行日志"
          }
        }
      },
      "CommandActionRecipient": {
        "type": "object",
        "description": "指令派发对象",
        "properties": {
          "id": { "type": "string", "description": "对象 ID", "example": "ab1" },
          "role": { "type": "string", "description": "角色/单位", "example": "公司总值班室" },
          "name": { "type": "string", "description": "姓名", "example": "宋文帅" },
          "phone": { "type": "string", "description": "联系电话", "example": "13792536966" }
        }
      },
      "CommandActionDynamicEntry": {
        "type": "object",
        "description": "指令执行日志条目",
        "properties": {
          "id": { "type": "string", "description": "日志 ID", "example": "n1-1" },
          "time": { "type": "string", "description": "时间", "example": "2026-04-27 14:56:10" },
          "type": {
            "type": "string",
            "description": "环节类型",
            "enum": ["系统", "派发", "签收", "执行", "现场反馈", "异常", "完成"],
            "example": "系统"
          },
          "operator": { "type": "string", "description": "操作人", "example": "应急指挥平台" },
          "result": {
            "type": "string",
            "description": "结果",
            "enum": ["已记录", "成功", "进行中", "异常", "已完成"],
            "example": "已记录"
          },
          "content": {
            "type": "string",
            "description": "内容",
            "example": "根据公司级应急预案自动生成「通知值班人员」指令。"
          },
          "attachment": {
            "type": "string",
            "description": "附件说明，无则为空",
            "example": "现场人员清点表.xlsx"
          },
          "media": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionMedia" },
            "description": "回传媒体（图片/视频/语音）"
          }
        }
      },
      "CommandActionMedia": {
        "type": "object",
        "description": "指令回传媒体",
        "properties": {
          "id": { "type": "string", "description": "媒体 ID", "example": "n1-image" },
          "type": {
            "type": "string",
            "description": "媒体类型",
            "enum": ["image", "video", "audio"],
            "example": "image"
          },
          "name": { "type": "string", "description": "媒体名称", "example": "装置区警戒隔离现场" },
          "src": {
            "type": "string",
            "description": "媒体地址（受保护端点需带鉴权），无则为空",
            "example": ""
          },
          "duration": {
            "type": "string",
            "description": "音视频时长（mm:ss），无则为空",
            "example": "00:18"
          }
        }
      },
      "NodePhaseMapCamera": {
        "type": "object",
        "description": "3D 地图镜头配置",
        "properties": {
          "anchorPriorityList": {
            "type": "array",
            "description": "镜头中心锚点优先级（按序降级：事件装置 → 报警电话位置 → 防区 → 抢险队 GPS → 全厂 → 自定义）",
            "items": {
              "type": "string",
              "enum": [
                "event_device",
                "alarm_phone_location",
                "alarm_phone_zone",
                "first_responder_gps",
                "factory_center",
                "custom"
              ],
              "example": "event_device"
            }
          },
          "customCenter": {
            "type": "array",
            "description": "自定义镜头中心 [lon, lat]；未配置为 null",
            "items": { "type": "number", "example": 110.9265 }
          },
          "bufferRadiusMeters": {
            "type": "integer",
            "description": "缓冲区半径（米）",
            "example": 260
          }
        }
      },
      "NodePhaseDuty": {
        "type": "object",
        "description": "节点值班配置",
        "properties": {
          "autoRoster": {
            "type": "boolean",
            "description": "是否按节点切换值班小组自动排班",
            "example": true
          }
        }
      },
      "NodePhaseConfig": {
        "type": "object",
        "description": "应急流程节点联动配置（镜头锚点 / 左右面板显隐 / 值班排班）",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "节点 id（alarmJudgement/1min/3min/5min/plantArea/companyLevel/govLevel/handling/archive）",
            "example": "alarmJudgement"
          },
          "nodeName": { "type": "string", "description": "节点名称", "example": "1. 接警研判" },
          "mapCamera": { "$ref": "#/components/schemas/NodePhaseMapCamera" },
          "rightPanelHiddenTabs": {
            "type": "array",
            "description": "右侧面板隐藏页签（duty/auxiliary/dynamics 的子集）",
            "items": { "type": "string", "example": "dynamics" }
          },
          "leftPanelHiddenPanels": {
            "type": "array",
            "description": "左侧面板隐藏面板（incident/plan/info 的子集）",
            "items": { "type": "string", "example": "info" }
          },
          "duty": { "$ref": "#/components/schemas/NodePhaseDuty" }
        }
      },
      "NodePhaseConfigList": {
        "type": "array",
        "description": "节点联动配置列表",
        "items": { "$ref": "#/components/schemas/NodePhaseConfig" }
      }
    }
  }
}
