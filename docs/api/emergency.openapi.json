  "components": {
    "schemas": {
      "EmergencyStrength": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmergencyResource" },
            "description": "按维度统计的应急资源"
          }
        }
      },
      "EmergencyResource": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "应急专家",
              "应急物资",
              "救援队伍",
              "装备车辆",
              "应急场所",
              "医疗机构",
              "应急车辆",
              "消防设施"
            ],
            "description": "资源类别",
            "example": "应急专家"
          },
          "count": { "type": "integer", "description": "数量", "example": 47 },
          "icon": {
            "type": "string",
            "description": "图标名（Element Plus icon 名）",
            "example": "UserFilled"
          }
        }
      },
      "ClosedCaseList": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ClosedCase" },
            "description": "已结案事件列表"
          }
        }
      },
      "ClosedCase": {
        "type": "object",
        "properties": {
          "caseId": { "type": "string", "description": "结案 ID", "example": "C-2026-081" },
          "title": { "type": "string", "description": "事件标题" },
          "location": { "type": "string", "description": "事发位置" },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "description": "结案时间（ISO8601）"
          },
          "handler": { "type": "string", "description": "处置人" }
        }
      },
      "DutyRoster": {
        "type": "object",
        "properties": {
          "departments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "可切换的部门列表（含「全部」）"
          },
          "shift": { "$ref": "#/components/schemas/DutyShift" },
          "members": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DutyMember" },
            "description": "值班成员列表"
          }
        }
      },
      "DutyMember": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "成员唯一 ID", "example": "d1" },
          "name": { "type": "string", "description": "姓名", "example": "杨恒明" },
          "phone": { "type": "string", "description": "联系电话", "example": "13792536966" },
          "role": { "$ref": "#/components/schemas/DutyRole" },
          "department": { "type": "string", "description": "所属部门", "example": "全部" },
          "shift": { "$ref": "#/components/schemas/DutyShift" }
        }
      },
      "DutyRole": { "type": "string", "enum": ["值班领导", "值班员"], "example": "值班领导" },
      "DutyShift": { "type": "string", "enum": ["白班", "夜班"], "example": "白班" },
      "EmergencyPhoneBook": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmergencyPhone" },
            "description": "通讯录条目列表"
          }
        }
      },
      "EmergencyPhone": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "通讯录条目 ID", "example": "ph1" },
          "name": { "type": "string", "description": "名称/单位", "example": "消防报警" },
          "number": { "type": "string", "description": "联系电话", "example": "119" },
          "category": {
            "type": "string",
            "description": "分类",
            "enum": ["消防", "医疗", "公安", "厂内应急", "保卫值班", "应急通讯", "智能联动"],
            "example": "消防"
          }
        }
      },
      "KnowledgeList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KnowledgeItem" },
            "description": "知识条目列表"
          }
        }
      },
      "KnowledgeItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "知识条目 ID", "example": "k1" },
          "title": { "type": "string", "description": "标题", "example": "岗位应急处置卡" },
          "count": { "type": "integer", "description": "知识条目数", "example": 158 },
          "icon": {
            "type": "string",
            "description": "图标名（Element Plus icon 名）",
            "example": "Document"
          }
        }
      },
      "DispatchPersonnel": {
        "type": "object",
        "description": "应急派单人员项（告警详情「派单人员」下拉）",
        "properties": {
          "id": { "type": "integer", "description": "人员 ID", "example": 1 },
          "name": {
            "type": "string",
            "description": "姓名（不脱敏，派单需可辨识）",
            "example": "杨恒朋"
          },
          "role": {
            "type": "string",
            "description": "岗位，如值班领导 / 消防队长 / 工艺处置组长",
            "example": "值班领导"
          },
          "department": {
            "type": "string",
            "description": "所属部门",
            "example": "公司总值班室"
          },
          "phone": { "type": "string", "description": "联系电话", "example": "137-9253-6966" }
        }
      },
      "EmergencyCommandGroup": {
        "type": "object",
        "description": "应急指挥指令分组（固定/临时）",
        "properties": {
          "id": {
            "type": "string",
            "description": "分组 ID（notify/dispatch/temp-notify/temp-dispatch）",
            "example": "notify"
          },
          "label": { "type": "string", "description": "分组名称", "example": "一键通知" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmergencyCommandInstruction" },
            "description": "分组内指令卡片列表"
          }
        }
      },
      "EmergencyCommandInstruction": {
        "type": "object",
        "description": "应急指挥单条指令卡片",
        "properties": {
          "id": { "type": "string", "description": "指令 ID", "example": "n1" },
          "type": {
            "type": "string",
            "description": "指令类型",
            "enum": ["通知", "任务"],
            "example": "通知"
          },
          "name": { "type": "string", "description": "指令名称", "example": "通知值班人员" },
          "location": {
            "type": "string",
            "description": "作用位置",
            "example": "中海壳牌石油化工有限公司"
          },
          "status": {
            "type": "string",
            "description": "处置状态",
            "enum": ["待处置", "已处置", "待派发"],
            "example": "待处置"
          },
          "actionLabel": {
            "type": "string",
            "description": "操作按钮文案（如「一键派发」），无则为空",
            "example": "一键派发"
          },
          "done": { "type": "boolean", "description": "是否已处置完毕", "example": false }
        }
      },
      "CommandActionDetail": {
        "type": "object",
        "description": "应急指挥指令行动详情",
        "properties": {
          "id": { "type": "string", "description": "指令 ID", "example": "n1" },
          "name": { "type": "string", "description": "指令名称", "example": "通知值班人员" },
          "type": {
            "type": "string",
            "description": "指令类型",
            "enum": ["通知", "任务"],
            "example": "通知"
          },
          "notifyChannels": {
            "type": "array",
            "items": { "type": "string", "enum": ["app", "sms", "voice"] },
            "description": "通知渠道"
          },
          "status": {
            "type": "string",
            "description": "处置状态",
            "enum": ["待处置", "已处置", "待派发"],
            "example": "待处置"
          },
          "dispatchMode": { "type": "string", "description": "派发方式", "example": "自动派发" },
          "location": {
            "type": "string",
            "description": "作用位置",
            "example": "中海壳牌石油化工有限公司"
          },
          "description": { "type": "string", "description": "指令描述/背景" },
          "attachment": {
            "type": "string",
            "description": "附件说明，无则为「—」",
            "example": "—"
          },
          "addressBookRecipients": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionRecipient" },
            "description": "通讯录派发对象"
          },
          "dutyRecipients": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionRecipient" },
            "description": "值班人员派发对象"
          },
          "dynamics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionDynamicEntry" },
            "description": "指令执行日志"
          }
        }
      },
      "CommandActionRecipient": {
        "type": "object",
        "description": "指令派发对象",
        "properties": {
          "id": { "type": "string", "description": "对象 ID", "example": "ab1" },
          "role": { "type": "string", "description": "角色/单位", "example": "公司总值班室" },
          "name": { "type": "string", "description": "姓名", "example": "宋文帅" },
          "phone": { "type": "string", "description": "联系电话", "example": "13792536966" }
        }
      },
      "CommandActionDynamicEntry": {
        "type": "object",
        "description": "指令执行日志条目",
        "properties": {
          "id": { "type": "string", "description": "日志 ID", "example": "n1-1" },
          "time": { "type": "string", "description": "时间", "example": "2026-04-27 14:56:10" },
          "type": {
            "type": "string",
            "description": "环节类型",
            "enum": ["系统", "派发", "签收", "执行", "现场反馈", "异常", "完成"],
            "example": "系统"
          },
          "operator": { "type": "string", "description": "操作人", "example": "应急指挥平台" },
          "result": {
            "type": "string",
            "description": "结果",
            "enum": ["已记录", "成功", "进行中", "异常", "已完成"],
            "example": "已记录"
          },
          "content": {
            "type": "string",
            "description": "内容",
            "example": "根据公司级应急预案自动生成「通知值班人员」指令。"
          },
          "attachment": {
            "type": "string",
            "description": "附件说明，无则为空",
            "example": "现场人员清点表.xlsx"
          },
          "media": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommandActionMedia" },
            "description": "回传媒体（图片/视频/语音）"
          }
        }
      },
      "CommandActionMedia": {
        "type": "object",
        "description": "指令回传媒体",
        "properties": {
          "id": { "type": "string", "description": "媒体 ID", "example": "n1-image" },
          "type": {
            "type": "string",
            "description": "媒体类型",
            "enum": ["image", "video", "audio"],
            "example": "image"
          },
          "name": { "type": "string", "description": "媒体名称", "example": "装置区警戒隔离现场" },
          "src": {
            "type": "string",
            "description": "媒体地址（受保护端点需带鉴权），无则为空",
            "example": ""
          },
          "duration": {
            "type": "string",
            "description": "音视频时长（mm:ss），无则为空",
            "example": "00:18"
          }
        }
      },
      "NodePhaseMapCamera": {
        "type": "object",
        "description": "3D 地图镜头配置",
        "properties": {
          "anchorPriorityList": {
            "type": "array",
            "description": "镜头中心锚点优先级（按序降级：事件装置 → 报警电话位置 → 防区 → 抢险队 GPS → 全厂 → 自定义）",
            "items": {
              "type": "string",
              "enum": [
                "event_device",
                "alarm_phone_location",
                "alarm_phone_zone",
                "first_responder_gps",
                "factory_center",
                "custom"
              ],
              "example": "event_device"
            }
          },
          "customCenter": {
            "type": "array",
            "description": "自定义镜头中心 [lon, lat]；未配置为 null",
            "items": { "type": "number", "example": 110.9265 }
          },
          "bufferRadiusMeters": {
            "type": "integer",
            "description": "缓冲区半径（米）",
            "example": 260
          }
        }
      },
      "NodePhaseDuty": {
        "type": "object",
        "description": "节点值班配置",
        "properties": {
          "autoRoster": {
            "type": "boolean",
            "description": "是否按节点切换值班小组自动排班",
            "example": true
          }
        }
      },
      "NodePhaseConfig": {
        "type": "object",
        "description": "应急流程节点联动配置（镜头锚点 / 左右面板显隐 / 值班排班）",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "节点 id（alarmJudgement/1min/3min/5min/plantArea/companyLevel/govLevel/handling/archive）",
            "example": "alarmJudgement"
          },
          "nodeName": { "type": "string", "description": "节点名称", "example": "1. 接警研判" },
          "mapCamera": { "$ref": "#/components/schemas/NodePhaseMapCamera" },
          "rightPanelHiddenTabs": {
            "type": "array",
            "description": "右侧面板隐藏页签（duty/auxiliary/dynamics 的子集）",
            "items": { "type": "string", "example": "dynamics" }
          },
          "leftPanelHiddenPanels": {
            "type": "array",
            "description": "左侧面板隐藏面板（incident/plan/info 的子集）",
            "items": { "type": "string", "example": "info" }
          },
          "duty": { "$ref": "#/components/schemas/NodePhaseDuty" }
        }
      },
      "NodePhaseConfigList": {
        "type": "array",
        "description": "节点联动配置列表",
        "items": { "$ref": "#/components/schemas/NodePhaseConfig" }
      },
      "EmergencyPhase": {
        "type": "object",
        "description": "应急阶段",
        "properties": {
          "id": {
            "type": "string",
            "description": "阶段编码（phase-team / phase-plant / phase-company / phase-gov / phase-close）",
            "example": "phase-team"
          },
          "name": { "type": "string", "description": "阶段名称", "example": "班组处置" },
          "start": { "type": "integer", "description": "起始节点号（含）", "example": 1 },
          "end": { "type": "integer", "description": "结束节点号（含）", "example": 4 },
          "tone": {
            "type": "string",
            "description": "阶段配色（blue/cyan/amber/red/green）",
            "example": "blue"
          }
        }
      },
      "ResponseModeOption": {
        "type": "object",
        "description": "应急响应模式选项",
        "properties": {
          "value": {
            "type": "string",
            "description": "模式编码（team/plant/company/government）",
            "example": "team"
          },
          "label": { "type": "string", "description": "模式名称", "example": "一、班组处置" },
          "stageId": { "type": "integer", "description": "该模式对应起始节点号", "example": 1 }
        }
      },
      "ProcessAction": {
        "type": "object",
        "description": "流程节点处置动作项",
        "properties": {
          "id": { "type": "string", "description": "动作 id", "example": "act-1-1" },
          "label": {
            "type": "string",
            "description": "动作文案",
            "example": "按三要素向运行部调度核实报告"
          },
          "done": { "type": "boolean", "description": "是否已完成", "example": true },
          "type": {
            "type": "string",
            "description": "动作强调色：primary / danger / warning；无则不着色",
            "enum": ["primary", "danger", "warning"],
            "example": "primary"
          }
        }
      },
      "CriteriaChecklistItem": {
        "type": "object",
        "description": "节点完成判据项",
        "properties": {
          "id": { "type": "string", "description": "判据 id", "example": "cri-1-1" },
          "label": { "type": "string", "description": "判据文案", "example": "确定事故点位与介质" },
          "checked": { "type": "boolean", "description": "是否已勾选", "example": true }
        }
      },
      "SubStageItem": {
        "type": "object",
        "description": "节点子阶段项",
        "properties": {
          "id": { "type": "string", "description": "子阶段 id", "example": "sub-5-1" },
          "code": { "type": "string", "description": "子阶段编码", "example": "5.1" },
          "name": { "type": "string", "description": "子阶段名称", "example": "装置区警戒隔离" },
          "shortName": { "type": "string", "description": "子阶段简称", "example": "警戒隔离" },
          "description": {
            "type": "string",
            "description": "子阶段说明",
            "example": "划定警戒区并疏散无关人员"
          }
        }
      },
      "StageEscalationDetails": {
        "type": "object",
        "description": "升级规则现场概况",
        "properties": {
          "location": { "type": "string", "description": "事发位置", "example": "加氢裂化装置区" },
          "substance": {
            "type": "string",
            "description": "涉及介质",
            "example": "加氢裂化重油 / 硫化氢"
          },
          "casualty": { "type": "string", "description": "伤员情况", "example": "0人受伤" },
          "currentStatus": {
            "type": "string",
            "description": "当前处置状态",
            "example": "现场处置推进中"
          }
        }
      },
      "StageEscalationRule": {
        "type": "object",
        "description": "节点升级规则",
        "properties": {
          "triggerCondition": {
            "type": "string",
            "description": "触发升级的条件",
            "example": "当前级别处置无法控制险情，需升级到上一级应急响应"
          },
          "fromRole": {
            "type": "string",
            "description": "升级请求方角色",
            "example": "当前级别现场指挥"
          },
          "toRole": {
            "type": "string",
            "description": "升级接收方角色",
            "example": "上一级应急指挥部"
          },
          "details": { "$ref": "#/components/schemas/StageEscalationDetails" }
        }
      },
      "ProcessStage": {
        "type": "object",
        "description": "应急流程节点",
        "properties": {
          "id": { "type": "integer", "description": "节点号（1-15）", "example": 1 },
          "name": { "type": "string", "description": "节点名称", "example": "接警研判" },
          "shortName": {
            "type": "string",
            "description": "节点简称（流程条用）",
            "example": "1. 接警研判"
          },
          "leadRole": {
            "type": "string",
            "description": "牵头角色（含图标）",
            "example": "🧑 现场第一发现人"
          },
          "leadTitle": {
            "type": "string",
            "description": "牵头岗位",
            "example": "巡检员 / 内操员"
          },
          "commandLevel": { "type": "string", "description": "指挥层级", "example": "班组处置" },
          "description": {
            "type": "string",
            "description": "节点说明",
            "example": "通过巡检、仪器报警第一时间捕捉险情，按三要素上报。"
          },
          "previousContext": {
            "type": "array",
            "description": "前置态势（上一节点以来的关键时间线）",
            "items": { "type": "string", "example": "10:00:00 - 厂区 GDS 检测到气体异常" }
          },
          "currentActions": {
            "type": "array",
            "description": "当前处置动作清单",
            "items": { "$ref": "#/components/schemas/ProcessAction" }
          },
          "criteriaChecklist": {
            "type": "array",
            "description": "完成判据清单",
            "items": { "$ref": "#/components/schemas/CriteriaChecklistItem" }
          },
          "subStages": {
            "type": "array",
            "description": "子阶段清单（装置区等节点使用）",
            "items": { "$ref": "#/components/schemas/SubStageItem" }
          },
          "escalationRule": { "$ref": "#/components/schemas/StageEscalationRule" }
        }
      },
      "EmergencyProcessPanorama": {
        "type": "object",
        "description": "应急流程全景聚合（阶段 + 响应模式 + 节点）",
        "properties": {
          "phases": {
            "type": "array",
            "description": "应急阶段（5 个，按起始节点升序）",
            "items": { "$ref": "#/components/schemas/EmergencyPhase" }
          },
          "responseModes": {
            "type": "array",
            "description": "响应模式选项（4 个）",
            "items": { "$ref": "#/components/schemas/ResponseModeOption" }
          },
          "stages": {
            "type": "array",
            "description": "流程节点（15 个，按节点号升序）",
            "items": { "$ref": "#/components/schemas/ProcessStage" }
          }
        }
      },
      "NodeGuidanceReportingStep": {
        "type": "object",
        "description": "指引上报链路步骤",
        "properties": {
          "step": { "type": "integer", "description": "步骤序号", "example": 1 },
          "fromRole": {
            "type": "string",
            "description": "上报方（角色·姓名）",
            "example": "外操 (巡检员·王安全)"
          },
          "toRole": {
            "type": "string",
            "description": "接收方（角色·姓名）",
            "example": "内操 (控制室·张建国)"
          },
          "method": {
            "type": "string",
            "description": "上报方式",
            "example": "防爆对讲机 1 号频道"
          },
          "notice": {
            "type": "string",
            "description": "上报要点",
            "example": "立即汇报现场泄漏具体位号及肉眼观察规模"
          }
        }
      },
      "NodeGuidanceRoleTask": {
        "type": "object",
        "description": "指引岗位任务",
        "properties": {
          "roleName": {
            "type": "string",
            "description": "岗位名（内操/外操/班长）",
            "example": "内操"
          },
          "roleTitle": {
            "type": "string",
            "description": "岗位职责标题",
            "example": "DCS 中控室内操控制员"
          },
          "personName": { "type": "string", "description": "值班人姓名", "example": "张建国" },
          "avatarIcon": { "type": "string", "description": "头像图标", "example": "🧑‍💻" },
          "phone": { "type": "string", "description": "联系电话", "example": "139-0668-2233" },
          "tasks": {
            "type": "array",
            "description": "该岗位本节点任务清单",
            "items": { "type": "string", "example": "密切监视 DCS 趋势图并核对关键参数" }
          }
        }
      },
      "NodeGuidance": {
        "type": "object",
        "description": "节点处置指引",
        "properties": {
          "nodeId": { "type": "string", "description": "节点 id", "example": "1" },
          "nodeName": {
            "type": "string",
            "description": "节点名称",
            "example": "节点 1：接警研判"
          },
          "reportingChain": {
            "type": "array",
            "description": "上报链路",
            "items": { "$ref": "#/components/schemas/NodeGuidanceReportingStep" }
          },
          "roleTasks": {
            "type": "array",
            "description": "岗位任务分工",
            "items": { "$ref": "#/components/schemas/NodeGuidanceRoleTask" }
          },
          "generalNotice": {
            "type": "string",
            "description": "通用注意事项",
            "example": "⚠ 接警研判阶段切记「安全第一、快速切断」。"
          }
        }
      },
      "GuidanceDutyRoster": {
        "type": "object",
        "description": "应急指引实时值班表",
        "properties": {
          "shiftGroup": { "type": "string", "description": "值班班组", "example": "乙班（白班）" },
          "supervisor": {
            "type": "string",
            "description": "班组长（含岗位）",
            "example": "李明辉（加氢制氢部值班长）"
          },
          "supervisorPhone": {
            "type": "string",
            "description": "班组长电话",
            "example": "138-0288-3456"
          },
          "boardOperator": {
            "type": "string",
            "description": "内操（含岗位）",
            "example": "张建国（DCS 内操人员）"
          },
          "boardOperatorPhone": {
            "type": "string",
            "description": "内操电话",
            "example": "139-0668-2233"
          },
          "fieldOperator": {
            "type": "string",
            "description": "外操（含岗位）",
            "example": "王安全（现场外操巡检员）"
          },
          "fieldOperatorPhone": {
            "type": "string",
            "description": "外操电话",
            "example": "137-0668-8378"
          }
        }
      },
      "EmergencyProcessGuidance": {
        "type": "object",
        "description": "应急流程节点指引聚合（值班表 + 各节点指引）",
        "properties": {
          "dutyRoster": { "$ref": "#/components/schemas/GuidanceDutyRoster" },
          "guidances": {
            "type": "array",
            "description": "节点处置指引（按节点号升序）",
            "items": { "$ref": "#/components/schemas/NodeGuidance" }
          }
        }
      },
      "EmergencyAssistStat": {
        "type": "object",
        "description": "应急辅助信息统计项",
        "properties": {
          "label": { "type": "string", "description": "统计项标签", "example": "应急预案" },
          "value": { "type": "integer", "description": "数值", "example": 15 },
          "unit": {
            "type": "string",
            "description": "单位：套 / 张 / 人 / 处",
            "example": "套"
          },
          "tone": {
            "type": "string",
            "description": "配色：blue / cyan / green / orange",
            "enum": ["blue", "cyan", "green", "orange"],
            "example": "blue"
          }
        }
      },
      "EmergencyAssistStatSummary": {
        "type": "object",
        "description": "应急辅助信息统计集合",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmergencyAssistStat" },
            "description": "4 项应急辅助 KPI"
          }
        }
      }
    }
  }
}
