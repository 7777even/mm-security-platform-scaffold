{
  "openapi": "3.0.3",
  "info": {
    "title": "消防报警 FireAlarm API",
    "version": "1.0.0",
    "x-base-path": "/api/v1",
    "x-contract": "B3",
    "description": "消防报警分页列表接口（代码真实契约）。契约源：src/services/alarm.ts 的 fetchFireAlarmPage / FireAlarmItem。"
  },
  "servers": [{ "url": "/api/v1", "description": "默认 baseURL（VITE_API_BASE 可覆盖）" }],
  "security": [{ "bearerAuth": [], "replaySign": [] }],
  "tags": [{ "name": "fire-alarm", "description": "消防报警" }],
  "paths": {
    "/fire-alarms": {
      "get": {
        "tags": ["fire-alarm"],
        "operationId": "getFireAlarmPage",
        "summary": "消防报警分页查询",
        "description": "分页返回消防报警（火灾/烟雾/GDS/设备故障），含类型、来源、对象、等级、描述、位置、监控点、处置状态等。数据来自 fac_fire_alarm 真实表。响应 data 为 PageResult<FireAlarmItem>（list/total/page/size）。",
        "parameters": [
          { "$ref": "./_shared.json#/components/parameters/page" },
          { "$ref": "./_shared.json#/components/parameters/size" },
          { "$ref": "./_shared.json#/components/parameters/lang" }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=PageResult<FireAlarmItem>）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "allOf": [
                            { "$ref": "./_shared.json#/components/schemas/PageResult" },
                            {
                              "type": "object",
                              "properties": {
                                "list": {
                                  "type": "array",
                                  "items": { "$ref": "#/components/schemas/FireAlarmItem" }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "list": [
                      {
                        "alarmId": "FA-20260907-001",
                        "typeLabel": "火灾报警",
                        "typeTone": "fire",
                        "source": "火灾报警",
                        "objectType": "装置",
                        "objectName": "蜡油加氢装置",
                        "level": "-",
                        "description": "蜡油加氢装置区疑似出现明火，请核实。",
                        "location": "化工区-蜡油加氢装置区",
                        "time": "2026-05-31 10:14:12",
                        "falseAlarm": "未核实",
                        "status": "ACTIVE",
                        "rescueEventId": "1",
                        "monitorId": "cam-a-east",
                        "monitorLabel": "蜡油加氢东侧监控",
                        "onsiteMonitorId": "cam-a-site",
                        "onsiteMonitorLabel": "蜡油加氢现场监控",
                        "title": "蜡油加氢装置火灾"
                      }
                    ],
                    "total": 16,
                    "page": 1,
                    "size": 10
                  }
                }
              }
            }
          },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" }
        }
      }
    },
    "/fire-alarms/{alarmId}": {
      "put": {
        "tags": ["fire-alarm"],
        "operationId": "updateFireAlarm",
        "summary": "消防报警写回（确认/派单/闭环 + 误报标记）",
        "description": "对单条消防报警做处置状态流转或误报标记，落 fac_fire_alarm 真实表（乐观锁 version 自动并发防护）。需权限码 fire-alarm:ack。成功返回更新后的 FireAlarmItem（B3 包络），并广播 fire-alarm.alarm 实时变更。状态枚举对齐字典 fire_alarm_status：ACTIVE 待处理 / ACKED 已确认 / DISPATCHED 已派单 / CLOSED 已闭环；误报对齐 fire_alarm_false：是 / 否 / 未核实。处置字段（handleResult 处置情况文本 / handleTime 处置时间 / dispatchPersonnel 派单人员 / notifyMethod 通知方式）为可选自由文本，仅在传入非空时覆盖，不传不更新。",
        "parameters": [
          {
            "name": "alarmId",
            "in": "path",
            "required": true,
            "description": "报警编号（主键，如 FA-20260907-001）",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "局部更新请求：仅传入需要变更的字段，未传字段不更新",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FireAlarmUpdateRequest" },
              "example": { "status": "ACKED" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "B3 成功包络（data=更新后的 FireAlarmItem）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "./_shared.json#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/FireAlarmItem" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "alarmId": "FA-20260907-001",
                    "status": "ACKED",
                    "falseAlarm": "未核实",
                    "title": "蜡油加氢装置火灾",
                    "handleResult": "已现场核实现场无明火，持续观察",
                    "handleTime": "2026-08-20 10:30:00",
                    "dispatchPersonnel": "张三,李四",
                    "notifyMethod": "APP,SMS"
                  }
                }
              }
            }
          },
          "400": { "$ref": "./_shared.json#/components/responses/BadRequest" },
          "401": { "$ref": "./_shared.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./_shared.json#/components/responses/Forbidden" },
          "404": { "$ref": "./_shared.json#/components/responses/BadRequest" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FireAlarmItem": {
        "type": "object",
        "description": "消防报警条目（字段对齐前端 FireAlarmItem）",
        "properties": {
          "alarmId": { "type": "string", "description": "报警编号（主键）" },
          "typeLabel": {
            "type": "string",
            "description": "类型标签（火灾报警/烟雾报警/GDS报警/设备故障）"
          },
          "typeTone": { "type": "string", "description": "类型色调（fire/smoke/gds/muted）" },
          "source": {
            "type": "string",
            "description": "报警来源（火灾报警/DCS·GDS/视频识别/人工上报）"
          },
          "objectType": { "type": "string", "description": "对象类型（装置/储罐/仓库/管网）" },
          "objectName": { "type": "string", "description": "对象名称" },
          "level": { "type": "string", "description": "报警等级（-/高报/高高报等）" },
          "description": { "type": "string", "description": "报警描述" },
          "location": { "type": "string", "description": "报警位置" },
          "time": { "type": "string", "description": "报警时间" },
          "falseAlarm": { "type": "string", "description": "是否误报（未核实/是/否）" },
          "status": {
            "type": "string",
            "description": "处置状态（ACTIVE 待处理 / ACKED 已确认 / DISPATCHED 已派单 / CLOSED 已闭环），对齐字典 fire_alarm_status"
          },
          "rescueEventId": { "type": "string", "description": "关联救援事件 id（可空）" },
          "monitorId": { "type": "string", "description": "监控点 id（可空）" },
          "monitorLabel": { "type": "string", "description": "监控点名称（可空）" },
          "onsiteMonitorId": { "type": "string", "description": "现场监控点 id（可空）" },
          "onsiteMonitorLabel": { "type": "string", "description": "现场监控点名称（可空）" },
          "title": { "type": "string", "description": "报警标题" },
          "handleResult": { "type": "string", "description": "处置情况文本（可空）" },
          "handleTime": {
            "type": "string",
            "description": "处置时间（格式 yyyy-MM-dd HH:mm:ss，可空）"
          },
          "dispatchPersonnel": {
            "type": "string",
            "description": "派单人员（多个以英文逗号分隔，可空）"
          },
          "notifyMethod": {
            "type": "string",
            "description": "通知方式（APP/SMS，多个以英文逗号分隔，如 APP,SMS，可空）"
          }
        }
      },
      "FireAlarmUpdateRequest": {
        "type": "object",
        "description": "消防报警写回请求（局部更新，仅传入需变更的字段）。状态枚举对齐 fire_alarm_status，误报对齐 fire_alarm_false。",
        "properties": {
          "status": {
            "type": "string",
            "description": "处置状态：ACTIVE 待处理 / ACKED 已确认 / DISPATCHED 已派单 / CLOSED 已闭环。不传则不更新状态。"
          },
          "falseAlarm": {
            "type": "string",
            "description": "是否误报：是 / 否 / 未核实。不传则不更新。"
          },
          "handleResult": {
            "type": "string",
            "description": "处置情况文本。不传则不更新。"
          },
          "handleTime": {
            "type": "string",
            "description": "处置时间（格式 yyyy-MM-dd HH:mm:ss）。不传则不更新。"
          },
          "dispatchPersonnel": {
            "type": "string",
            "description": "派单人员（多个以英文逗号分隔）。不传则不更新。"
          },
          "notifyMethod": {
            "type": "string",
            "description": "通知方式（APP/SMS，多个以英文逗号分隔，如 APP,SMS）。不传则不更新。"
          }
        }
      }
    }
  }
}
