{
  "openapi": "3.0.3",
  "info": {
    "title": "应急预案矩阵 / 预案切换接口（fm-accident-rescue 应急指挥）",
    "description": "取代前端硬编码的 planMatrixMock / emergencyPlanSwitchMock 预案矩阵与预案切换数据。覆盖应急指挥大屏的预案选项（Tab、事故类型、设施、可选预案）与预案矩阵实例（主阶段/子阶段/风险事件/作战资源/行动卡片）。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/emergency-plans/options": {
      "get": {
        "summary": "应急预案选项聚合",
        "description": "返回应急指挥大屏预案切换所需的全部选项：顶部 Tab、事故类型、设施列表，以及可选预案清单（含所属 Tab/名称/事故类型/设施/业务域/核预案标记/激活态/调用次数）。用于预案切换面板的下拉与筛选。domain 非空时仅返回该业务域预案（如 production=生产域核预案浏览）。",
        "tags": ["emergency-plan"],
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "description": "业务域过滤：production / fire / perimeter / superior；不传返回全部预案",
            "schema": { "type": "string", "example": "production" }
          }
        ],
        "responses": {
          "200": {
            "description": "应急预案选项聚合数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyPlanOptions" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "tabs": [
                      { "key": "flood", "label": "防汛" },
                      { "key": "fire", "label": "防火" }
                    ],
                    "accidentTypes": ["泄漏", "火灾", "爆炸"],
                    "facilities": ["炼油一部", "乙烯装置"],
                    "plans": [
                      {
                        "id": "plan-1001",
                        "tab": "flood",
                        "name": "炼油一部防汛预案",
                        "accidentType": "泄漏",
                        "facility": "炼油一部",
                        "domain": "production",
                        "nuclear": true,
                        "isActive": false,
                        "invokeCount": 0,
                        "lastInvokedAt": null
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-plans/matrix": {
      "get": {
        "summary": "预案矩阵实例",
        "description": "返回某个预案的完整矩阵实例：主阶段/子阶段进度、风险事件、作战资源与行动卡片。planId 可选；不传时返回默认（首个）预案的矩阵，供应急指挥大屏首屏初始化。",
        "tags": ["emergency-plan"],
        "parameters": [
          {
            "name": "planId",
            "in": "query",
            "required": false,
            "description": "预案 id；不传则返回默认（首个）预案矩阵",
            "schema": { "type": "string", "example": "plan-1001" }
          }
        ],
        "responses": {
          "200": {
            "description": "预案矩阵实例数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanInstance" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "plan-1001",
                    "title": "炼油一部防汛预案",
                    "description": "针对炼油一部区域防汛应急响应的完整作战矩阵。",
                    "majorPhases": [
                      {
                        "id": "mp-1",
                        "name": "预警响应",
                        "order": 1,
                        "upgradeProcess": "水位超 1m 升级为Ⅱ级响应"
                      }
                    ],
                    "subPhases": [
                      {
                        "id": "sp-1",
                        "parentId": "mp-1",
                        "name": "信息接报",
                        "order": 1,
                        "progress": 100
                      }
                    ],
                    "riskEvents": [{ "id": "re-1", "subPhaseId": "sp-1", "name": "泵房进水" }],
                    "resources": [
                      {
                        "id": "rs-1",
                        "name": "排水抢险组",
                        "expectedCount": "12",
                        "actualCount": "10",
                        "leaderName": "张伟",
                        "contactPhone": "13800000000",
                        "duties": "负责泵房排水与设备抢修",
                        "lon": 110.351,
                        "lat": 21.271
                      }
                    ],
                    "actionCards": [
                      {
                        "id": "ac-1",
                        "resourceId": "rs-1",
                        "title": "启动排水泵",
                        "content": "开启 3# 排水泵并确认出水",
                        "description": "泵房积水排放作业",
                        "startSubPhaseId": "sp-1",
                        "endSubPhaseId": "sp-2",
                        "riskEventId": "re-1",
                        "status": "in-progress",
                        "isGlobal": false
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-plans/{id}/invoke": {
      "post": {
        "summary": "一键调用预案",
        "description": "激活 + 广播 + 留痕：将指定预案在其业务域内置为唯一激活预案，写入调用留痕（操作人取自登录态），并通过 emergency.plan 域实时广播。不向任何物理设备下发控制指令（零下行控制红线）。未命中预案时 data 为 null。",
        "tags": ["emergency-plan"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "预案 id（fac_emergency_plan.id）",
            "schema": { "type": "integer", "format": "int64", "example": 1 }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlanInvokeRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "调用结果（含激活态、调用次数与留痕）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanInvokeResult" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "planId": 1,
                    "planName": "乙烯储罐火灾处置方案",
                    "domain": "production",
                    "isActive": true,
                    "invokeCount": 3,
                    "invokedAt": "2026-09-29T09:12:00",
                    "operator": "admin"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-plans/catalog": {
      "get": {
        "summary": "应急预案目录",
        "description": "返回应急预案目录（4 行层级：上级单位 / 公司级 / 消防救援 / 现场处置）。数据源 V39 fac_emergency_plan_catalog 参考表，取代前端 EmergencyPlanPanel 硬编码的 planRows。",
        "tags": ["emergency-plan"],
        "responses": {
          "200": {
            "description": "应急预案目录数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyPlanCatalogSummary" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      {
                        "id": "superior",
                        "label": "上级单位预案",
                        "planName": "未启动",
                        "canSwitch": false,
                        "isCurrent": false
                      },
                      {
                        "id": "company",
                        "label": "公司级预案",
                        "planName": "茂名石化应急预案",
                        "canSwitch": true,
                        "isCurrent": true
                      },
                      {
                        "id": "branch",
                        "label": "消防救援预案",
                        "planName": "乙烯装置消防救援处置方案",
                        "canSwitch": true,
                        "isCurrent": false
                      },
                      {
                        "id": "site",
                        "label": "现场处置方案",
                        "planName": "重油加氢装置高危处置方案",
                        "canSwitch": true,
                        "isCurrent": false
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-plans/catalog-detail": {
      "get": {
        "summary": "应急预案详情字段",
        "description": "返回预案详情弹窗的 5 段字段（基础 / 评审 / 备案 / 公布 / 评估信息）。数据源 V39 fac_emergency_plan_detail 参考表，取代前端 EmergencyPlanPanel 硬编码的 basicSections。",
        "tags": ["emergency-plan"],
        "responses": {
          "200": {
            "description": "应急预案详情字段数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmergencyPlanDetailSummary" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "sections": [
                      {
                        "title": "基础信息",
                        "fields": [
                          { "label": "所属组织", "value": "茂名石化应急指挥中心" },
                          { "label": "预案编号", "value": "MM-EPP-2026-001" },
                          { "label": "预案名称", "value": "茂名石化综合应急预案" },
                          { "label": "预案类别", "value": "综合应急预案" },
                          { "label": "预案级别", "value": "公司级" },
                          { "label": "风控是否告知周边单位", "value": "是" }
                        ]
                      },
                      {
                        "title": "评估信息",
                        "fields": [
                          { "label": "是否修订", "value": "未修订" },
                          { "label": "最近评估日期", "value": "2026-03-10" },
                          { "label": "评估周期", "value": "每6个月" },
                          { "label": "评估意见", "value": "整体有效，建议完善跨装置协同演练。" }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-plans/{planId}/action-cards": {
      "post": {
        "summary": "新建预案行动卡片",
        "description": "在指定预案实例下新建一张行动卡片。planId 为预案实例编码；未命中实例时返回 data 为 null。",
        "tags": ["emergency-plan"],
        "parameters": [
          {
            "name": "planId",
            "in": "path",
            "required": true,
            "description": "预案实例编码（plan_code）",
            "schema": { "type": "string", "example": "plan-t103-002" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlanActionCardCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新建后的行动卡片",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanActionCard" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "ac-3f9a1c2b4d5e",
                    "resourceId": "res-flood-3",
                    "title": "启动排水泵",
                    "content": "开启 3# 排水泵并确认出水",
                    "description": "泵房积水排放作业",
                    "startSubPhaseId": "sp4_3_2",
                    "endSubPhaseId": "sp4_4_2",
                    "riskEventId": "re4_1",
                    "status": "pending",
                    "isGlobal": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/emergency-plans/{planId}/action-cards/{cardId}": {
      "put": {
        "summary": "更新预案行动卡片",
        "description": "局部更新行动卡片字段（null 不覆盖），前端主要用于执行状态流转。未命中实例或卡片时返回 data 为 null。",
        "tags": ["emergency-plan"],
        "parameters": [
          {
            "name": "planId",
            "in": "path",
            "required": true,
            "description": "预案实例编码（plan_code）",
            "schema": { "type": "string", "example": "plan-t103-002" }
          },
          {
            "name": "cardId",
            "in": "path",
            "required": true,
            "description": "行动卡片编码（card_code）",
            "schema": { "type": "string", "example": "c-flood-401" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlanActionCardUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新后的行动卡片",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanActionCard" },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": "c-flood-401",
                    "resourceId": "res-flood-3",
                    "title": "使用漏电测试仪对配电房周边水体检测",
                    "content": "检测强排低洼淹没区有无动力漏电",
                    "startSubPhaseId": "sp4_3_2",
                    "endSubPhaseId": "sp4_4_2",
                    "status": "in-progress",
                    "isGlobal": true
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "删除预案行动卡片",
        "description": "删除指定行动卡片；未命中实例或卡片时 ok 为 false（不抛异常）。",
        "tags": ["emergency-plan"],
        "parameters": [
          {
            "name": "planId",
            "in": "path",
            "required": true,
            "description": "预案实例编码（plan_code）",
            "schema": { "type": "string", "example": "plan-t103-002" }
          },
          {
            "name": "cardId",
            "in": "path",
            "required": true,
            "description": "行动卡片编码（card_code）",
            "schema": { "type": "string", "example": "c-flood-401" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除结果",
            "content": {
              "application/json": {
                "schema": { "type": "boolean" },
                "example": { "code": 0, "message": "ok", "data": true }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmergencyPlanTab": {
        "type": "object",
        "description": "预案 Tab 项",
        "properties": {
          "key": { "type": "string", "description": "Tab 唯一键", "example": "flood" },
          "label": { "type": "string", "description": "Tab 展示名", "example": "防汛" }
        }
      },
      "SelectableEmergencyPlan": {
        "type": "object",
        "description": "可选预案项",
        "properties": {
          "id": { "type": "string", "description": "预案 id", "example": "plan-1001" },
          "tab": { "type": "string", "description": "所属 Tab 键", "example": "flood" },
          "name": { "type": "string", "description": "预案名称", "example": "炼油一部防汛预案" },
          "accidentType": { "type": "string", "description": "事故类型", "example": "泄漏" },
          "facility": { "type": "string", "description": "关联设施", "example": "炼油一部" },
          "domain": {
            "type": "string",
            "description": "业务域：production=生产域 / fire=消防域 / perimeter=周界域 / superior=上级单位域",
            "example": "production"
          },
          "nuclear": {
            "type": "boolean",
            "description": "核预案标记（重点核生化/核管控类预案）",
            "example": true
          },
          "isActive": {
            "type": "boolean",
            "description": "当前是否激活（同域内唯一）",
            "example": false
          },
          "invokeCount": { "type": "integer", "description": "累计一键调用次数", "example": 0 },
          "lastInvokedAt": {
            "type": "string",
            "format": "date-time",
            "description": "最近一次调用时间（ISO8601，可空）",
            "example": null
          }
        }
      },
      "EmergencyPlanOptions": {
        "type": "object",
        "description": "应急预案选项聚合",
        "properties": {
          "tabs": {
            "type": "array",
            "description": "顶部 Tab 列表",
            "items": { "$ref": "#/components/schemas/EmergencyPlanTab" }
          },
          "accidentTypes": {
            "type": "array",
            "description": "事故类型列表",
            "items": { "type": "string" }
          },
          "facilities": {
            "type": "array",
            "description": "设施列表",
            "items": { "type": "string" }
          },
          "plans": {
            "type": "array",
            "description": "可选预案清单",
            "items": { "$ref": "#/components/schemas/SelectableEmergencyPlan" }
          }
        }
      },
      "PlanMajorPhase": {
        "type": "object",
        "description": "预案主阶段",
        "properties": {
          "id": { "type": "string", "description": "主阶段 id", "example": "mp-1" },
          "name": { "type": "string", "description": "主阶段名称", "example": "预警响应" },
          "order": { "type": "integer", "description": "排序号", "example": 1 },
          "upgradeProcess": {
            "type": "string",
            "description": "升级流程说明（可选）",
            "example": "水位超 1m 升级为Ⅱ级响应"
          }
        }
      },
      "PlanSubPhase": {
        "type": "object",
        "description": "预案子阶段",
        "properties": {
          "id": { "type": "string", "description": "子阶段 id", "example": "sp-1" },
          "parentId": { "type": "string", "description": "所属主阶段 id", "example": "mp-1" },
          "name": { "type": "string", "description": "子阶段名称", "example": "信息接报" },
          "order": { "type": "integer", "description": "排序号", "example": 1 },
          "progress": {
            "type": "integer",
            "description": "完成进度（0-100，可选）",
            "example": 100
          }
        }
      },
      "PlanRiskEvent": {
        "type": "object",
        "description": "预案风险事件",
        "properties": {
          "id": { "type": "string", "description": "风险事件 id", "example": "re-1" },
          "subPhaseId": { "type": "string", "description": "关联子阶段 id", "example": "sp-1" },
          "name": { "type": "string", "description": "风险事件名称", "example": "泵房进水" }
        }
      },
      "PlanCombatResource": {
        "type": "object",
        "description": "作战资源（队伍/装备）",
        "properties": {
          "id": { "type": "string", "description": "资源 id", "example": "rs-1" },
          "name": { "type": "string", "description": "资源名称", "example": "排水抢险组" },
          "expectedCount": {
            "type": "string",
            "description": "应到数量（字符串，前端原样展示）",
            "example": "12"
          },
          "actualCount": {
            "type": "string",
            "description": "实到数量（字符串，前端原样展示）",
            "example": "10"
          },
          "leaderName": {
            "type": "string",
            "description": "负责人姓名（可选）",
            "example": "张伟"
          },
          "contactPhone": {
            "type": "string",
            "description": "联系电话（可选）",
            "example": "13800000000"
          },
          "duties": {
            "type": "string",
            "description": "职责说明",
            "example": "负责泵房排水与设备抢修"
          },
          "lon": { "type": "number", "description": "经度（可选）", "example": 110.351 },
          "lat": { "type": "number", "description": "纬度（可选）", "example": 21.271 }
        }
      },
      "PlanActionCard": {
        "type": "object",
        "description": "行动卡片",
        "properties": {
          "id": { "type": "string", "description": "行动卡片 id", "example": "ac-1" },
          "resourceId": { "type": "string", "description": "关联作战资源 id", "example": "rs-1" },
          "title": { "type": "string", "description": "卡片标题", "example": "启动排水泵" },
          "content": {
            "type": "string",
            "description": "卡片内容（可选）",
            "example": "开启 3# 排水泵并确认出水"
          },
          "description": {
            "type": "string",
            "description": "卡片描述（可选）",
            "example": "泵房积水排放作业"
          },
          "startSubPhaseId": {
            "type": "string",
            "description": "起始子阶段 id",
            "example": "sp-1"
          },
          "endSubPhaseId": { "type": "string", "description": "结束子阶段 id", "example": "sp-2" },
          "riskEventId": {
            "type": "string",
            "description": "关联风险事件 id（可选）",
            "example": "re-1"
          },
          "status": {
            "type": "string",
            "description": "状态：pending 待执行 / in-progress 执行中 / completed 已完成",
            "enum": ["pending", "in-progress", "completed"],
            "example": "in-progress"
          },
          "isGlobal": {
            "type": "boolean",
            "description": "是否全局卡片（不绑定具体子阶段，可选）",
            "example": false
          }
        }
      },
      "PlanInstance": {
        "type": "object",
        "description": "预案矩阵实例",
        "properties": {
          "id": { "type": "string", "description": "预案 id", "example": "plan-1001" },
          "title": { "type": "string", "description": "预案标题", "example": "炼油一部防汛预案" },
          "description": {
            "type": "string",
            "description": "预案描述",
            "example": "针对炼油一部区域防汛应急响应的完整作战矩阵。"
          },
          "majorPhases": {
            "type": "array",
            "description": "主阶段列表",
            "items": { "$ref": "#/components/schemas/PlanMajorPhase" }
          },
          "subPhases": {
            "type": "array",
            "description": "子阶段列表",
            "items": { "$ref": "#/components/schemas/PlanSubPhase" }
          },
          "riskEvents": {
            "type": "array",
            "description": "风险事件列表",
            "items": { "$ref": "#/components/schemas/PlanRiskEvent" }
          },
          "resources": {
            "type": "array",
            "description": "作战资源列表",
            "items": { "$ref": "#/components/schemas/PlanCombatResource" }
          },
          "actionCards": {
            "type": "array",
            "description": "行动卡片列表",
            "items": { "$ref": "#/components/schemas/PlanActionCard" }
          }
        }
      },
      "PlanActionCardCreate": {
        "type": "object",
        "description": "新建预案行动卡片入参",
        "required": ["resourceId", "title", "startSubPhaseId", "endSubPhaseId"],
        "properties": {
          "resourceId": {
            "type": "string",
            "description": "关联作战资源 id",
            "example": "res-flood-3"
          },
          "title": { "type": "string", "description": "卡片标题", "example": "启动排水泵" },
          "content": {
            "type": "string",
            "description": "卡片内容（可选）",
            "example": "开启 3# 排水泵并确认出水"
          },
          "description": {
            "type": "string",
            "description": "卡片描述（可选）",
            "example": "泵房积水排放作业"
          },
          "startSubPhaseId": {
            "type": "string",
            "description": "起始子阶段 id",
            "example": "sp4_3_2"
          },
          "endSubPhaseId": {
            "type": "string",
            "description": "结束子阶段 id",
            "example": "sp4_4_2"
          },
          "riskEventId": {
            "type": "string",
            "description": "关联风险事件 id（可选）",
            "example": "re4_1"
          },
          "status": {
            "type": "string",
            "description": "状态：pending 待执行 / in-progress 执行中 / completed 已完成；可空，缺省 pending",
            "enum": ["pending", "in-progress", "completed"],
            "example": "pending"
          },
          "isGlobal": {
            "type": "boolean",
            "description": "是否跨阶段全局卡；可空，缺省 false",
            "example": false
          }
        }
      },
      "PlanActionCardUpdate": {
        "type": "object",
        "description": "更新预案行动卡片入参（局部更新，null 不覆盖）",
        "properties": {
          "resourceId": {
            "type": "string",
            "description": "关联作战资源 id（可选）",
            "example": "res-flood-3"
          },
          "title": { "type": "string", "description": "卡片标题（可选）", "example": "启动排水泵" },
          "content": {
            "type": "string",
            "description": "卡片内容（可选）",
            "example": "开启 3# 排水泵并确认出水"
          },
          "description": {
            "type": "string",
            "description": "卡片描述（可选）",
            "example": "泵房积水排放作业"
          },
          "startSubPhaseId": {
            "type": "string",
            "description": "起始子阶段 id（可选）",
            "example": "sp4_3_2"
          },
          "endSubPhaseId": {
            "type": "string",
            "description": "结束子阶段 id（可选）",
            "example": "sp4_4_2"
          },
          "riskEventId": {
            "type": "string",
            "description": "关联风险事件 id（可选）",
            "example": "re4_1"
          },
          "status": {
            "type": "string",
            "description": "状态：pending / in-progress / completed（可选）",
            "enum": ["pending", "in-progress", "completed"],
            "example": "in-progress"
          },
          "isGlobal": {
            "type": "boolean",
            "description": "是否跨阶段全局卡（可选）",
            "example": false
          }
        }
      },
      "PlanInvokeRequest": {
        "type": "object",
        "description": "一键调用预案入参（激活+广播+留痕，不触达物理设备）",
        "properties": {
          "note": {
            "type": "string",
            "description": "调用备注（可选，如调用场景/指挥员批示）",
            "example": "生产装置区乙烯储罐火情，启动专项处置预案"
          }
        }
      },
      "PlanInvokeResult": {
        "type": "object",
        "description": "一键调用预案结果",
        "properties": {
          "planId": {
            "type": "integer",
            "format": "int64",
            "description": "预案 id",
            "example": 1
          },
          "planName": {
            "type": "string",
            "description": "预案名称",
            "example": "乙烯储罐火灾处置方案"
          },
          "domain": { "type": "string", "description": "业务域", "example": "production" },
          "isActive": {
            "type": "boolean",
            "description": "调用后是否激活（同域内唯一）",
            "example": true
          },
          "invokeCount": { "type": "integer", "description": "调用后累计次数", "example": 3 },
          "invokedAt": {
            "type": "string",
            "format": "date-time",
            "description": "本次调用时间（ISO8601）",
            "example": "2026-09-29T09:12:00"
          },
          "operator": {
            "type": "string",
            "description": "操作人（来自登录态）",
            "example": "admin"
          }
        }
      },
      "EmergencyPlanCatalogItem": {
        "type": "object",
        "description": "应急预案目录行",
        "properties": {
          "id": {
            "type": "string",
            "description": "预案层级编码：superior / company / branch / site",
            "example": "company"
          },
          "label": { "type": "string", "description": "层级标签", "example": "公司级预案" },
          "planName": {
            "type": "string",
            "description": "当前生效预案名称（未启动时为「未启动」）",
            "example": "茂名石化应急预案"
          },
          "canSwitch": {
            "type": "boolean",
            "description": "是否可切换",
            "example": true
          },
          "isCurrent": {
            "type": "boolean",
            "description": "是否为当前激活预案",
            "example": true
          }
        }
      },
      "EmergencyPlanCatalogSummary": {
        "type": "object",
        "description": "应急预案目录集合",
        "properties": {
          "items": {
            "type": "array",
            "description": "4 行预案层级",
            "items": { "$ref": "#/components/schemas/EmergencyPlanCatalogItem" }
          }
        }
      },
      "EmergencyPlanDetailField": {
        "type": "object",
        "description": "预案详情字段（标签 + 值）",
        "properties": {
          "label": { "type": "string", "description": "字段标签", "example": "所属组织" },
          "value": {
            "type": "string",
            "description": "字段值",
            "example": "茂名石化应急指挥中心"
          }
        }
      },
      "EmergencyPlanDetailSection": {
        "type": "object",
        "description": "预案详情字段分组段",
        "properties": {
          "title": {
            "type": "string",
            "description": "段标题：基础信息 / 评审信息 / 备案信息 / 公布信息 / 评估信息",
            "example": "基础信息"
          },
          "fields": {
            "type": "array",
            "description": "段内字段列表",
            "items": { "$ref": "#/components/schemas/EmergencyPlanDetailField" }
          }
        }
      },
      "EmergencyPlanDetailSummary": {
        "type": "object",
        "description": "预案详情字段集合",
        "properties": {
          "sections": {
            "type": "array",
            "description": "5 段详情（基础 / 评审 / 备案 / 公布 / 评估信息）",
            "items": { "$ref": "#/components/schemas/EmergencyPlanDetailSection" }
          }
        }
      }
    }
  }
}
