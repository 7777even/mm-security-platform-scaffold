{
  "openapi": "3.0.3",
  "info": {
    "title": "特殊作业大屏接口（壳内特殊作业面板 + 消防特殊作业弹窗复用）",
    "description": "取代前端硬编码的 specialOperationMock。覆盖特殊作业票台账分页（支持类型/区域/等级/状态筛选，下拉文案「全部xx」按不过滤处理）与作业票详情（现场视频/气体检测点/作业人员子表）。与 /fire/special-operations 统计端点（fire-monitoring 域）职责不同：本域为作业票明细。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/special-operations": {
      "get": {
        "summary": "作业票分页",
        "description": "按页返回特殊作业票列表；type/area/level/status 均为可选筛选，传「全部类型/全部区域/全部等级/全部状态」或不传时按不过滤处理。",
        "tags": ["special-operation"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，从 1 开始，默认 1",
            "schema": {
              "type": "integer",
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数，默认 10",
            "schema": {
              "type": "integer",
              "default": 10,
              "example": 10
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "作业类型筛选（动火作业/盲板抽堵/吊装作业/动土作业/受限空间/高处作业/临时用电/断路作业）",
            "schema": {
              "type": "string",
              "example": "动火作业"
            }
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "作业区域筛选（重油加氢装置/乙烯装置区/芳烃装置区/罐区/公用工程区/仓储区）",
            "schema": {
              "type": "string",
              "example": "罐区"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "作业等级筛选（一级/二级/三级）",
            "schema": {
              "type": "string",
              "example": "一级"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "票证状态筛选（已签发/进行中/已完成/已取消）",
            "schema": {
              "type": "string",
              "example": "进行中"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "作业票分页数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpecialOperationPage"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "total": 12,
                    "page": 1,
                    "size": 10,
                    "pages": 2,
                    "list": [
                      {
                        "id": 1,
                        "area": "重油加氢装置",
                        "type": "动火作业",
                        "level": "二级",
                        "status": "已签发",
                        "startTime": "2026-06-02 09:30:00",
                        "endTime": "2026-06-02 17:00:00",
                        "timeRange": "2026.06.02 - 2026.06.02",
                        "unit": "中国石油天然气第六建设有限公司",
                        "applyUnit": "化工一部",
                        "operationDate": "2026-06-02 09:30:00",
                        "location": "重油加氢装置",
                        "isContractor": "否",
                        "hazardType": "--",
                        "leaderName": "赵忠阳",
                        "leaderPhone": "11111111",
                        "position": "重油加氢装置一层阀口",
                        "longitude": 110.8811,
                        "latitude": 21.6749,
                        "changeReason": "--",
                        "cancelReason": "--",
                        "guardianName": "王学龙",
                        "workers": "阮国述, 孙业光",
                        "permitNo": "20260601150001321.pdf",
                        "content": "雨水池堵漏",
                        "videoCount": 26,
                        "gasMonitorCount": 3,
                        "personnelCount": 2
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["special-operation"],
        "summary": "新建作业票",
        "description": "新建一张特殊作业票；id 与 sort_no 由服务端按 LedgerIdSupport 分配。只写主票表 fac_special_operation_ticket——现场视频 / 气体检测点 / 作业人员子表本批不开放写。仅 ADMIN 可写。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecialOperationWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "B3 成功包络",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpecialOperationItem"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 31,
                    "area": "罐区A",
                    "type": "动火作业",
                    "level": "二级",
                    "status": "进行中",
                    "startTime": "08:30",
                    "endTime": "17:30",
                    "timeRange": "08:30-17:30",
                    "unit": "电仪车间",
                    "applyUnit": "电仪车间",
                    "operationDate": "2026-08-21",
                    "location": "罐区A东侧",
                    "isContractor": "否",
                    "hazardType": "火灾爆炸",
                    "leaderName": "张三",
                    "leaderPhone": "138****2211",
                    "position": "作业负责人",
                    "longitude": 110.851,
                    "latitude": 21.623,
                    "changeReason": "",
                    "cancelReason": "",
                    "guardianName": "李四",
                    "workers": "王五、赵六",
                    "permitNo": "DH-2026-0831",
                    "content": "罐区A管线焊接",
                    "videoCount": 2,
                    "gasMonitorCount": 1,
                    "personnelCount": 3
                  }
                }
              }
            }
          }
        }
      }
    },
    "/special-operations/{id}": {
      "get": {
        "summary": "作业票详情",
        "description": "返回作业票详情（列表行全量字段 + 现场视频/气体检测点/作业人员子表）；id 未命中时返回 404 业务码。",
        "tags": ["special-operation"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "作业票 id（取自列表行 id）",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "作业票详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpecialOperationDetail"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1,
                    "area": "重油加氢装置",
                    "type": "动火作业",
                    "level": "二级",
                    "status": "已签发",
                    "videos": [
                      {
                        "id": 1,
                        "name": "现场视频-1",
                        "location": "重油加氢装置监控点1"
                      }
                    ],
                    "gasPoints": [
                      {
                        "id": 1,
                        "name": "可燃气体",
                        "value": "0.2%LEL",
                        "status": "正常"
                      }
                    ],
                    "personnel": [
                      {
                        "id": 1,
                        "name": "阮国述",
                        "role": "施工人员",
                        "phone": "13800001111"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["special-operation"],
        "summary": "更新作业票",
        "description": "按 id 更新作业票字段；未命中时 data 为 null。仅 ADMIN 可写。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "作业票 id（取自 /special-operations 列表）",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 12
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecialOperationWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "B3 成功包络",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpecialOperationItem"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 31,
                    "area": "罐区A",
                    "type": "动火作业",
                    "level": "二级",
                    "status": "已结束",
                    "startTime": "08:30",
                    "endTime": "17:30",
                    "timeRange": "08:30-17:30",
                    "unit": "电仪车间",
                    "applyUnit": "电仪车间",
                    "operationDate": "2026-08-21",
                    "location": "罐区A东侧",
                    "isContractor": "否",
                    "hazardType": "火灾爆炸",
                    "leaderName": "张三",
                    "leaderPhone": "138****2211",
                    "position": "作业负责人",
                    "longitude": 110.851,
                    "latitude": 21.623,
                    "changeReason": "",
                    "cancelReason": "",
                    "guardianName": "李四",
                    "workers": "王五、赵六",
                    "permitNo": "DH-2026-0831",
                    "content": "罐区A管线焊接",
                    "videoCount": 2,
                    "gasMonitorCount": 1,
                    "personnelCount": 3
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["special-operation"],
        "summary": "删除作业票",
        "description": "按 id 删除作业票；未命中时 ok 为 false（不抛异常）。仅 ADMIN 可写。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "作业票 id（取自 /special-operations 列表）",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "B3 成功包络（data=DeleteResult）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "ok": true
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SpecialOperationItem": {
        "type": "object",
        "description": "作业票列表行（字段名与前端 SpecialOperationRecord 标量部分一致）",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "作业票 id",
            "example": 1
          },
          "area": {
            "type": "string",
            "description": "作业区域",
            "example": "重油加氢装置"
          },
          "type": {
            "type": "string",
            "description": "作业类型",
            "example": "动火作业"
          },
          "level": {
            "type": "string",
            "description": "作业等级",
            "example": "二级"
          },
          "status": {
            "type": "string",
            "description": "票证状态",
            "example": "已签发"
          },
          "startTime": {
            "type": "string",
            "description": "开始时间",
            "example": "2026-06-02 09:30:00"
          },
          "endTime": {
            "type": "string",
            "description": "结束时间",
            "example": "2026-06-02 17:00:00"
          },
          "timeRange": {
            "type": "string",
            "description": "起止展示区间",
            "example": "2026.06.02 - 2026.06.02"
          },
          "unit": {
            "type": "string",
            "description": "施工单位",
            "example": "中国石油天然气第六建设有限公司"
          },
          "applyUnit": {
            "type": "string",
            "description": "申请单位",
            "example": "化工一部"
          },
          "operationDate": {
            "type": "string",
            "description": "作业日期",
            "example": "2026-06-02 09:30:00"
          },
          "location": {
            "type": "string",
            "description": "作业地点",
            "example": "重油加氢装置"
          },
          "isContractor": {
            "type": "string",
            "description": "是否承包商（是/否）",
            "example": "否"
          },
          "hazardType": {
            "type": "string",
            "description": "危害类型（无则 --）",
            "example": "--"
          },
          "leaderName": {
            "type": "string",
            "description": "负责人姓名",
            "example": "赵忠阳"
          },
          "leaderPhone": {
            "type": "string",
            "description": "负责人电话",
            "example": "11111111"
          },
          "position": {
            "type": "string",
            "description": "作业位置",
            "example": "重油加氢装置一层阀口"
          },
          "longitude": {
            "type": "number",
            "description": "经度",
            "example": 110.8811
          },
          "latitude": {
            "type": "number",
            "description": "纬度",
            "example": 21.6749
          },
          "changeReason": {
            "type": "string",
            "description": "变更原因（无则 --）",
            "example": "--"
          },
          "cancelReason": {
            "type": "string",
            "description": "取消原因（无则 --）",
            "example": "--"
          },
          "guardianName": {
            "type": "string",
            "description": "监护人姓名",
            "example": "王学龙"
          },
          "workers": {
            "type": "string",
            "description": "作业人员名单",
            "example": "阮国述, 孙业光"
          },
          "permitNo": {
            "type": "string",
            "description": "票据附件文件名",
            "example": "20260601150001321.pdf"
          },
          "content": {
            "type": "string",
            "description": "作业内容",
            "example": "雨水池堵漏"
          },
          "videoCount": {
            "type": "integer",
            "description": "现场视频数",
            "example": 26
          },
          "gasMonitorCount": {
            "type": "integer",
            "description": "气体检测点数",
            "example": 3
          },
          "personnelCount": {
            "type": "integer",
            "description": "作业人员数",
            "example": 2
          }
        }
      },
      "SpecialOperationVideoItem": {
        "type": "object",
        "description": "现场视频项",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "视频 id",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "视频名称",
            "example": "现场视频-1"
          },
          "location": {
            "type": "string",
            "description": "监控点位置",
            "example": "重油加氢装置监控点1"
          }
        }
      },
      "SpecialOperationGasPoint": {
        "type": "object",
        "description": "气体检测点",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "检测点 id",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "气体名称",
            "example": "可燃气体"
          },
          "value": {
            "type": "string",
            "description": "检测值",
            "example": "0.2%LEL"
          },
          "status": {
            "type": "string",
            "description": "检测状态",
            "example": "正常"
          }
        }
      },
      "SpecialOperationPersonItem": {
        "type": "object",
        "description": "作业人员",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "人员 id",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "姓名",
            "example": "阮国述"
          },
          "role": {
            "type": "string",
            "description": "角色（施工人员/监护人员）",
            "example": "施工人员"
          },
          "phone": {
            "type": "string",
            "description": "联系电话",
            "example": "13800001111"
          }
        }
      },
      "SpecialOperationDetail": {
        "type": "object",
        "description": "作业票详情（列表行 + 三类子表）",
        "properties": {
          "videos": {
            "type": "array",
            "description": "现场视频列表",
            "items": {
              "$ref": "#/components/schemas/SpecialOperationVideoItem"
            }
          },
          "gasPoints": {
            "type": "array",
            "description": "气体检测点列表",
            "items": {
              "$ref": "#/components/schemas/SpecialOperationGasPoint"
            }
          },
          "personnel": {
            "type": "array",
            "description": "作业人员列表",
            "items": {
              "$ref": "#/components/schemas/SpecialOperationPersonItem"
            }
          }
        }
      },
      "SpecialOperationPage": {
        "type": "object",
        "description": "作业票分页",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "总条数",
            "example": 12
          },
          "page": {
            "type": "integer",
            "description": "当前页码",
            "example": 1
          },
          "size": {
            "type": "integer",
            "description": "每页条数",
            "example": 10
          },
          "pages": {
            "type": "integer",
            "description": "总页数（向上取整）",
            "example": 2
          },
          "list": {
            "type": "array",
            "description": "当前页作业票列表",
            "items": {
              "$ref": "#/components/schemas/SpecialOperationItem"
            }
          }
        }
      },
      "SpecialOperationWriteRequest": {
        "type": "object",
        "description": "特殊作业票写请求（新建/更新共用）。id 与 sort_no 由服务端分配；列名沿用实体保留字规避约定（op_type / op_level / ticket_status / work_location）。",
        "properties": {
          "opType": {
            "type": "string",
            "description": "作业类型（动火 / 受限空间 / 高处 …）",
            "example": "动火作业"
          },
          "ticketArea": {
            "type": "string",
            "description": "作业区域",
            "example": "罐区A"
          },
          "opLevel": {
            "type": "string",
            "description": "作业等级（一级 / 二级 / 三级）",
            "example": "二级"
          },
          "ticketStatus": {
            "type": "string",
            "description": "作业票状态（待审批 / 进行中 / 已结束 / 已取消）",
            "example": "进行中"
          },
          "startTime": {
            "type": "string",
            "description": "作业开始时间",
            "example": "08:30"
          },
          "endTime": {
            "type": "string",
            "description": "作业结束时间",
            "example": "17:30"
          },
          "timeRange": {
            "type": "string",
            "description": "作业时间段（展示用）",
            "example": "08:30-17:30"
          },
          "workUnit": {
            "type": "string",
            "description": "作业单位",
            "example": "电仪车间"
          },
          "applyUnit": {
            "type": "string",
            "description": "申请单位",
            "example": "电仪车间"
          },
          "operationDate": {
            "type": "string",
            "description": "作业日期",
            "example": "2026-08-21"
          },
          "workLocation": {
            "type": "string",
            "description": "作业地点",
            "example": "罐区A东侧"
          },
          "isContractor": {
            "type": "string",
            "description": "是否承包商作业（是 / 否）",
            "example": "否"
          },
          "hazardType": {
            "type": "string",
            "description": "危害类型",
            "example": "火灾爆炸"
          },
          "leaderName": {
            "type": "string",
            "description": "作业负责人姓名",
            "example": "张三"
          },
          "leaderPhone": {
            "type": "string",
            "description": "作业负责人电话",
            "example": "138****2211"
          },
          "position": {
            "type": "string",
            "description": "负责人岗位",
            "example": "作业负责人"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "经度",
            "example": 110.851
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "纬度",
            "example": 21.623
          },
          "changeReason": {
            "type": "string",
            "description": "变更原因",
            "example": ""
          },
          "cancelReason": {
            "type": "string",
            "description": "取消原因",
            "example": ""
          },
          "guardianName": {
            "type": "string",
            "description": "监护人姓名",
            "example": "李四"
          },
          "workers": {
            "type": "string",
            "description": "作业人员（顿号分隔）",
            "example": "王五、赵六"
          },
          "permitNo": {
            "type": "string",
            "description": "作业许可证编号",
            "example": "DH-2026-0831"
          },
          "content": {
            "type": "string",
            "description": "作业内容",
            "example": "罐区A管线焊接"
          },
          "videoCount": {
            "type": "integer",
            "description": "关联现场视频数量",
            "example": 2
          },
          "gasMonitorCount": {
            "type": "integer",
            "description": "关联气体检测点数量",
            "example": 1
          },
          "personnelCount": {
            "type": "integer",
            "description": "作业人员数量",
            "example": 3
          }
        },
        "required": ["opType"]
      },
      "DeleteResult": {
        "type": "object",
        "description": "删除结果（与后端 dto/DeleteResult 同名对齐）。",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "删除是否成功（命中行数 > 0 为 true）",
            "example": true
          }
        }
      }
    }
  }
}
