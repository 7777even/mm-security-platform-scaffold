# 生产/预览环境对接 B3 Mock 服务（Mock 先行期：B3 契约未到位前指向 mock）
# 上线前替换为真实网关地址：VITE_API_BASE=https://<domain>/api/v1，VITE_WS_BASE=wss://<domain>/ws
VITE_API_BASE=http://localhost:8787/api/v1
VITE_WS_BASE=ws://localhost:8787/ws

# 防重放签名（详设 V1.5 §3.3，红线）：生产强制启用，请求携带 X-Timestamp/X-Nonce/X-Signature，
# 网关校验 10s 时间窗。禁止改为 true（旁路仅限开发联调）。
VITE_SECURITY_GATEWAY_BYPASS=false
